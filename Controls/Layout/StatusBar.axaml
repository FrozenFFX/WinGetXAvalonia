    <UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WinGetXAvalonia.Converters"
    x:Class="WinGetXAvalonia.Controls.Layout.StatusBar"
    x:CompileBindings="False">

    <Border
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,1,0,0">

        <Grid
            Margin="16,0"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">

            <TextBlock
                Grid.Column="0"
                FontSize="{DynamicResource FontSecondary}"
                VerticalAlignment="Center"
                Text="{loc:TranslateBinding Path=StatusBarContext}"/>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">

                <TextBlock
                    FontSize="{DynamicResource FontSecondary}"
                    Opacity="0.6"
                    VerticalAlignment="Center"
                    Text="{Binding Version, StringFormat='WinGetX Studio • {0}'}"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
