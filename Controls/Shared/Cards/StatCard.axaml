<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinGetXAvalonia.Controls.Shared.StatCard"
    x:Name="Root">

    <Border
        Padding="16"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource RadiusMedium}">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

            <Border
                Width="44"
                Height="44"
                CornerRadius="12"
                Background="{DynamicResource SurfaceBrush}">

                <TextBlock
                    Text="{Binding Icon, ElementName=Root}"
                    FontSize="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <StackPanel
                Grid.Column="1"
                Spacing="2"
                VerticalAlignment="Center">

                <TextBlock
                    Text="{Binding Value, ElementName=Root}"
                    FontSize="{DynamicResource FontSubtitle}"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="{Binding Label, ElementName=Root}"
                    FontSize="{DynamicResource FontCaption}"
                    Foreground="{DynamicResource SubtextBrush}"/>
            </StackPanel>

        </Grid>

    </Border>

</UserControl>
