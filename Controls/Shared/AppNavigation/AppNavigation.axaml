<ListBox xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Shared.AppNavigation"
    Background="Transparent">

    <ListBox.Styles>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </ListBox.Styles>

    <ListBox.ItemTemplate>
        <DataTemplate x:DataType="shared:AppNavigationItem">

            <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="10">

                <Path
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                    Fill="{DynamicResource AccentBrush}"
                    Stretch="Uniform"/>

                <StackPanel
                    Grid.Column="1"
                    Spacing="1"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{loc:TranslateBinding Path=Title}"/>

                    <TextBlock
                        FontSize="{DynamicResource FontMicro}"
                        Opacity="0.6"
                        Text="{loc:TranslateBinding Path=Description}"/>

                </StackPanel>

            </Grid>

        </DataTemplate>
    </ListBox.ItemTemplate>

</ListBox>
