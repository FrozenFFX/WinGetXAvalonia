<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:WinGetXAvalonia.Models"
             x:Class="WinGetXAvalonia.Controls.SystemCard"
             x:DataType="models:SystemCardModel">
    <!-- WinGetX - https://github.com/FrozenFFX -->

    <Border Classes="card"
            MinWidth="160"
            Margin="0,0,16,16"
            MinHeight="120">

        <StackPanel Spacing="10">

            <TextBlock
                FontSize="22"
                Text="{Binding Icon}"/>

            <TextBlock
                Opacity="0.7"
                FontSize="14"
                Text="{Binding Title}"/>

            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Text="{Binding Value}"/>

        </StackPanel>


    <!-- kaneki -->
    </Border>

</UserControl>
