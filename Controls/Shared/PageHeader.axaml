<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Controls.Shared.PageHeader"
    x:Name="Root">

    <Grid
        RowDefinitions="Auto,Auto"
        RowSpacing="12"
        ColumnDefinitions="*,Auto"
        ColumnSpacing="20">

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Spacing="4">

            <TextBlock
                FontSize="{DynamicResource FontPageTitle}"
                FontWeight="SemiBold"
                Text="{loc:TranslateBinding Path=#Root.Title}"/>

            <TextBlock
                MaxWidth="720"
                FontSize="{DynamicResource FontPageSubtitle}"
                Opacity="0.65"
                TextWrapping="Wrap"
                Text="{loc:TranslateBinding Path=#Root.Description}"/>

        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Spacing="10"
            IsVisible="{Binding #Root.ActionCommand, Converter={x:Static conv:ObjectConverters.IsNotNull}}">

            <shared:AppButton
                Classes="ghost"
                Height="38"
                MinWidth="96"
                Padding="18,0"
                Content="{loc:TranslateBinding Path=#Root.ActionText}"
                Command="{Binding #Root.ActionCommand}"/>

        </StackPanel>

    </Grid>

</UserControl>
