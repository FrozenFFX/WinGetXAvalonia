<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:WinGetXAvalonia.ViewModels"
        xmlns:controls="using:WinGetXAvalonia.Controls"
        xmlns:operation="using:WinGetXAvalonia.Controls.Operation"
        mc:Ignorable="d"
        x:Class="WinGetXAvalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1400"
        Height="850"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="WinGetX Studio">

    <Grid
        RowDefinitions="*,32"
        ColumnDefinitions="260,*,12,340">

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Text="WinGetX Studio"/>

                <controls:Sidebar
                    Grid.Row="2"
                    DataContext="{Binding}"/>

            </Grid>

        </Border>

        <ContentControl
            Grid.Column="1"
            Margin="25"
            Content="{Binding Navigation.CurrentPage}"/>

        <GridSplitter
            Grid.Column="2"
            Width="6"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"/>

        <operation:OperationDrawer
            Grid.Column="3"
            DataContext="{Binding OperationDrawer}"/>

        <Border
            Grid.Row="1"
            Grid.ColumnSpan="4"
            Height="32"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,1,0,0">

            <Grid
                Margin="12,0"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="18">

                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding Footer}"/>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding StatusText}"/>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{Binding BuildDate}"/>

            </Grid>

        </Border>

    </Grid>

</Window>
