<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="using:WinGetXAvalonia.Controls.Shared">

    <Style Selector="shared|AppButton">

        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>

    </Style>

    <Style Selector="shared|AppButton.ghost">

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>

    </Style>

    <Style Selector="shared|AppButton.ghost:pointerover /template/ ContentPresenter">

        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>

    </Style>

    <Style Selector="shared|AppTextField">

        <Setter Property="Height" Value="38"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>

    </Style>

    <Style Selector="shared|AppIcon">

        <Setter Property="AccentBrush" Value="{DynamicResource TextBrush}"/>

    </Style>

    <Style Selector="shared|AppInfoBar.info Border">

        <Setter Property="Background" Value="#1A3B82F6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>

    </Style>

    <Style Selector="shared|AppInfoBar.success Border">

        <Setter Property="Background" Value="#1A4CAF50"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>

    </Style>

    <Style Selector="shared|AppInfoBar.warning Border">

        <Setter Property="Background" Value="#1AFFB300"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>

    </Style>

    <Style Selector="shared|AppInfoBar.error Border">

        <Setter Property="Background" Value="#1AF44336"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>

    </Style>

</Styles>
