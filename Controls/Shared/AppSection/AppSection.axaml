<ContentControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Shared.AppSection">

    <ContentControl.Template>
        <ControlTemplate TargetType="local:AppSection">

            <Grid RowDefinitions="Auto,*">

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock
                            FontSize="{DynamicResource FontSection}"
                            FontWeight="SemiBold"
                            Text="{TemplateBinding Title}"/>

                        <TextBlock
                            Margin="0,4,0,0"
                            Opacity="0.7"
                            Text="{TemplateBinding Description}"/>

                    </StackPanel>

                    <ContentPresenter
                        Grid.Column="1"
                        Content="{TemplateBinding HeaderContent}"
                        VerticalAlignment="Center"/>

                </Grid>

                <ContentPresenter
                    Grid.Row="1"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"/>

            </Grid>

        </ControlTemplate>
    </ContentControl.Template>

</ContentControl>
