<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinGetXAvalonia.Controls.Shared.SplitView"
    x:Name="Root">

    <Grid x:Name="LayoutGrid" ColumnSpacing="16">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <ContentPresenter
            x:Name="MainPresenter"
            Content="{Binding MainContent, ElementName=Root}"/>

        <ContentPresenter
            x:Name="SidePresenter"
            Grid.Column="1"
            Content="{Binding SideContent, ElementName=Root}"/>

    </Grid>

</UserControl>
