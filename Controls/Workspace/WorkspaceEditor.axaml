<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Workspace.WorkspaceEditor"
    x:Name="Root"
    x:CompileBindings="False">

    <Border
        Margin="0,0,0,8"
        Padding="16"
        CornerRadius="{DynamicResource RadiusMedium}"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

        <StackPanel Spacing="12">

            <TextBlock
                FontWeight="SemiBold"
                Text="{Binding Title, ElementName=Root}"/>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                <StackPanel Spacing="8">

                    <shared:AppTextField
                        Text="{Binding Name, ElementName=Root}"
                        PlaceholderText="Workspace name">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SaveCommand, ElementName=Root}"/>
                        </TextBox.KeyBindings>
                    </shared:AppTextField>

                    <shared:AppTextField
                        Text="{Binding Description, ElementName=Root}"
                        PlaceholderText="Workspace description (optional)"/>
                </StackPanel>

                <shared:AppButton
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Content="{Binding SaveButtonText, ElementName=Root}"
                    Command="{Binding SaveCommand, ElementName=Root}"/>
            </Grid>
        </StackPanel>
    </Border>

</UserControl>
