<UserControl
    x:Class="WinGetXAvalonia.Controls.Shared.SearchBox"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Name="Root">

    <Border
        Height="42"
        CornerRadius="12"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        Padding="12,0">

        <Border.Transitions>
            <Transitions>
                <BrushTransition
                    Property="BorderBrush"
                    Duration="0:0:0.15"/>
                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.15"/>
            </Transitions>
        </Border.Transitions>

        <Grid
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10"
            VerticalAlignment="Center">

            <ContentPresenter
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{Binding LeftIcon, ElementName=Root}">

                <ContentPresenter.Content>
                    <TextBlock
                        Text="🔍"
                        FontSize="16"
                        Margin="0,2,0,0"
                        VerticalAlignment="Center"
                        Opacity="0.60"/>
                </ContentPresenter.Content>

            </ContentPresenter>

            <shared:AppTextField
                Grid.Column="1"
                Background="Transparent"
                BorderThickness="0"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Left"
                PlaceholderText="{Binding Watermark, ElementName=Root}"
                Text="{Binding Text, ElementName=Root, Mode=TwoWay}"/>

            <shared:AppButton
                Grid.Column="2"
                Width="28"
                Height="28"
                Padding="0"
                CornerRadius="8"
                Content="✕"
                IsVisible="{Binding ShowClearButton, ElementName=Root}"
                Click="Clear_Click"/>

        </Grid>

    </Border>

</UserControl>