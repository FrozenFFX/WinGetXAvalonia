<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="General"/>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="Startup"/>

                    <ToggleSwitch
                        OffContent="Run when Windows starts"
                        OnContent="Run when Windows starts"
                        IsChecked="{Binding StartWithWindows}"/>

                    <ToggleSwitch
                        OffContent="Start minimized"
                        OnContent="Start minimized"
                        IsChecked="{Binding StartMinimized}"/>

                    <ToggleSwitch
                        OffContent="Minimize to tray"
                        OnContent="Minimize to tray"
                        IsChecked="{Binding MinimizeToTray}"/>

                    <ToggleSwitch
                        OffContent="Close to tray"
                        OnContent="Close to tray"
                        IsChecked="{Binding CloseToTray}"/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="Updates"/>

                    <ToggleSwitch
                        OffContent="Check for updates automatically"
                        OnContent="Check for updates automatically"
                        IsChecked="{Binding CheckUpdates}"/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="Founder"/>

                    <ToggleSwitch
                        OffContent="Show Founder Signature"
                        OnContent="Show Founder Signature"
                        IsChecked="{Binding ShowFounderSignature}"/>

                </StackPanel>

            </shared:AppCard>

        </StackPanel>

    </ScrollViewer>

    </Grid>

</UserControl>
