<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:studio="using:WinGetXAvalonia.Controls.Studio"
    x:Class="WinGetXAvalonia.Controls.Studio.StudioTile"
    x:Name="Root">

    <UserControl.Styles>

        <Style Selector="Button.StudioTile">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="Button.StudioTile:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}"/>
        </Style>

    </UserControl.Styles>

    <shared:AppButton
        ClipToBounds="True"
        Classes="StudioTile"
        Command="{Binding Command, ElementName=Root}"
        CommandParameter="{Binding CommandParameter, ElementName=Root}">

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="16">

            <Border
                Width="48"
                Height="48"
                CornerRadius="{DynamicResource RadiusMedium}"
                Background="{DynamicResource StudioAccentSoftBrush}"
                VerticalAlignment="Top">

                <Path
                    Width="26"
                    Height="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{Binding Icon, ElementName=Root, Converter={StaticResource IconGeometry}}"
                    Fill="{DynamicResource StudioAccentBrush}"
                    Stretch="Uniform"/>
            </Border>

            <StackPanel
                Grid.Column="1"
                Spacing="5"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch">

                <TextBlock
                    Text="{Binding Title, ElementName=Root}"
                    FontSize="{DynamicResource FontCardTitle}"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"/>

                <TextBlock
                    Text="{Binding Description, ElementName=Root}"
                    FontSize="{DynamicResource FontBody}"
                    Foreground="{DynamicResource SubtextBrush}"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2"/>

                <TextBlock
                    Text="{Binding Category, ElementName=Root}"
                    FontSize="{DynamicResource FontMicro}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource StudioAccentBrush}"
                    TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <studio:StudioBadge
                Grid.Column="2"
                VerticalAlignment="Top"
                Text="{Binding Badge, ElementName=Root}"
                Status="{Binding BadgeStatus, ElementName=Root}"/>
        </Grid>
    </shared:AppButton>

</UserControl>
