<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.GameModeView"
    x:DataType="vm:GameModeViewModel">

    <Grid
        Margin="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Grid.Row="0"
            Title="{loc:Translate Key=&quot;Game Mode&quot;}"
            Description="{loc:Translate Key=&quot;Gaming essentials for streaming and play.&quot;}"/>

        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Spacing="14">

                <shared:AppButton
                    Classes="Accent"
                    HorizontalAlignment="Left"
                    Content="{loc:Translate Key=&quot;Install All&quot;}"
                    Command="{Binding InstallAllCommand}"/>

                <ItemsControl
                    ItemsSource="{Binding Packages}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkspacePackage">

                            <Border
                                Padding="12,10"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">

                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

                                    <Border
                                        Width="36"
                                        Height="36"
                                        CornerRadius="10"
                                        Background="{DynamicResource CardBrush}"
                                        VerticalAlignment="Center">

                                        <Path
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                            Fill="{DynamicResource AccentBrush}"
                                            Stretch="Uniform"/>

                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="2"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{loc:TranslateBinding Path=DisplayName}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Opacity="0.6"
                                            FontSize="{DynamicResource FontCaption}"
                                            Text="{loc:TranslateBinding Path=StateText}"
                                            TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        Opacity="0.6"
                                        FontSize="{DynamicResource FontCaption}"
                                        Text="{loc:TranslateBinding Path=Id}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <shared:AppButton
                                        Grid.Column="3"
                                        IsEnabled="{Binding CanInstall}"
                                        MinWidth="76"
                                        Content="{loc:Translate Key=&quot;Install&quot;}"
                                        Command="{Binding $parent[ItemsControl].DataContext.InstallCommand}"
                                        CommandParameter="{Binding}"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

        <shared:AppEmptyState
            Grid.Row="2"
            IsVisible="{Binding IsEmpty}"
            Icon="automation"
            Title="{loc:Translate Key=&quot;No gaming packages found&quot;}"
            Description="{loc:Translate Key=&quot;Install games to see them here.&quot;}"/>

        <shared:AppEmptyState
            Grid.Row="2"
            IsVisible="{Binding HasError}"
            Icon="warning"
            Title="{loc:Translate Key=&quot;Couldn&apos;t load game mode&quot;}"
            Description="{loc:TranslateBinding Path=ErrorMessage}"
            ActionText="{loc:Translate Key=&quot;Retry&quot;}"
            ActionCommand="{Binding RefreshCommand}"/>

        <shared:LoadingOverlay
            Grid.RowSpan="3"
            IsLoading="{Binding IsLoading}"
            Message="{loc:Translate Key=&quot;Scanning gaming setup...&quot;}"/>

    </Grid>

</UserControl>
