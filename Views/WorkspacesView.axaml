<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:workspace="using:WinGetXAvalonia.Controls.Workspace"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    x:Class="WinGetXAvalonia.Views.WorkspacesView"
    x:Name="Root"
    x:DataType="vm:WorkspacesViewModel">

    <UserControl.KeyBindings>
        <KeyBinding
            Gesture="F5"
            Command="{Binding RefreshCommand}"/>
    </UserControl.KeyBindings>

    <Grid
        Margin="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="False">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <shared:SectionHeader
            Grid.Row="0"
            Title="Workspaces"
            Description="{Binding WorkspacesSummary}"/>

        <!-- Toolbar -->
        <Grid
            Grid.Row="1"
            RowDefinitions="Auto,Auto">

            <workspace:WorkspaceToolbar
                Grid.Row="0"
                SearchText="{Binding SearchText}"
                Count="{Binding WorkspaceCount}"
                CreateCommand="{Binding NewWorkspaceCommand}"
                ImportCommand="{Binding ImportCommand}"
                RefreshCommand="{Binding RefreshCommand}"/>

            <workspace:WorkspaceEditor
                Grid.Row="1"
                Margin="0,12,0,0"
                IsVisible="{Binding IsEditorOpen}"
                Name="{Binding NewWorkspaceName}"
                Description="{Binding NewWorkspaceDescription}"
                SaveCommand="{Binding SaveWorkspaceCommand}"
                SaveButtonText="{Binding EditorAction}"
                Title="{Binding EditorTitle}"/>

        </Grid>

        <!-- Master-Detail -->
        <shared:MasterDetailPage
            Grid.Row="3"
            IsLoading="{Binding IsLoading}"
            LoadingMessage="Loading workspaces..."
            DetailWidth="0.8*">

            <shared:MasterDetailPage.MasterContent>

                <Grid>

                    <ListBox
                        ItemsSource="{Binding Workspaces}"
                        SelectedItem="{Binding SelectedWorkspace}"
                        BorderThickness="0"
                        Background="Transparent">

                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <workspace:WorkspaceCard Width="420" Margin="0,0,12,12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Empty state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding IsEmpty}"
                        Icon="💻"
                        Title="No workspaces"
                        Description="Create your first workspace to group package installs.">

                        <shared:AppEmptyState.Examples>
                            <sys:String>Group related apps into one workspace</sys:String>
                            <sys:String>Export and share your setup</sys:String>
                            <sys:String>Install a whole workspace at once</sys:String>
                        </shared:AppEmptyState.Examples>

                    </shared:AppEmptyState>

                    <!-- Error state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding HasError}"
                        Icon="⚠️"
                        Title="Couldn't load workspaces"
                        Description="{Binding ErrorMessage}"
                        ActionText="Retry"
                        ActionCommand="{Binding RefreshCommand}"/>

                </Grid>

            </shared:MasterDetailPage.MasterContent>

            <shared:MasterDetailPage.DetailContent>

                <Border
                    Padding="24"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}">

                    <Panel>

                        <workspace:WorkspacePackages
                            IsVisible="{Binding !IsNothingSelected}"/>

                        <shared:AppEmptyState
                            IsVisible="{Binding IsNothingSelected}"
                            Icon="💻"
                            Title="Select a workspace"
                            Description="Choose a workspace to see and edit its packages."/>

                    </Panel>

                </Border>

            </shared:MasterDetailPage.DetailContent>

        </shared:MasterDetailPage>

    </Grid>

</UserControl>
