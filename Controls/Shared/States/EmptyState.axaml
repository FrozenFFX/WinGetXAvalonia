<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Controls.Shared.EmptyState"
    x:Name="Root">

    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12"
        MaxWidth="300">

        <TextBlock
            Text="{Binding Icon, ElementName=Root}"
            FontSize="44"
            Opacity="0.35"
            HorizontalAlignment="Center"/>

        <TextBlock
            Text="{Binding Title, ElementName=Root}"
            FontSize="18"
            FontWeight="SemiBold"
            TextAlignment="Center"/>

        <TextBlock
            Text="{Binding Description, ElementName=Root}"
            FontSize="{DynamicResource FontBody}"
            Foreground="{DynamicResource SubtextBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"/>

        <Button
            Content="{Binding ActionText, ElementName=Root}"
            Command="{Binding ActionCommand, ElementName=Root}"
            IsVisible="{Binding ActionCommand, ElementName=Root,
            Converter={x:Static conv:ObjectConverters.IsNotNull}}"
            HorizontalAlignment="Center"
            Margin="0,8,0,0"/>

    </StackPanel>

</UserControl>
