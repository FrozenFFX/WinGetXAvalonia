<UserControl
    x:Class="WinGetXAvalonia.Controls.Shared.SearchBox"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <TextBox
        PlaceholderText="{Binding #Root.Watermark}"
        Text="{Binding #Root.Text, Mode=TwoWay}"/>

</UserControl>
