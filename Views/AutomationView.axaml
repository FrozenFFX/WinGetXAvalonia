<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    x:Class="WinGetXAvalonia.Views.AutomationView"
    x:DataType="vm:AutomationViewModel">

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="{loc:Translate Key=&quot;Automation&quot;}"
            Description="{loc:Translate Key=&quot;Create automatic package workflows triggered by events.&quot;}"/>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="280,10,*">

            <!-- Sol: liste paneli -->

            <shared:AppToolbar
                Grid.Column="0">

                <Grid RowDefinitions="Auto,12,Auto,12,*">

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                        <shared:AppButton
                            Grid.Column="0"
                            Classes="Accent"
                            HorizontalAlignment="Stretch"
                            Content="{loc:Translate Key=&quot;New Automation&quot;}"
                            Command="{Binding NewCommand}"/>

                        <shared:AppButton
                            Grid.Column="1"
                            Content="{loc:Translate Key=&quot;Import&quot;}"
                            Command="{Binding ImportCommand}"/>

                        <shared:AppButton
                            Grid.Column="2"
                            Content="{loc:Translate Key=&quot;Export&quot;}"
                            Command="{Binding ExportCommand}"/>

                    </Grid>

                    <shared:SearchBox
                        Grid.Row="2"
                        Watermark="{loc:Translate Key=&quot;Search automations...&quot;}"
                        Text="{Binding SearchText}"/>

                    <Grid Grid.Row="4">

                        <ListBox
                            ItemsSource="{Binding FilteredAutomations}"
                            SelectedItem="{Binding SelectedAutomation}"
                            BorderThickness="0"
                            Background="Transparent"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>

                                <DataTemplate x:DataType="models:AutomationItem">

                                    <Border
                                        Padding="10,8"
                                        CornerRadius="10">

                                        <StackPanel Spacing="2">

                                            <TextBlock
                                                Text="{loc:TranslateBinding Path=Name}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"/>

                                            <TextBlock
                                                Text="{loc:TranslateBinding Path=Trigger}"
                                                FontSize="{DynamicResource FontSecondary}"
                                                Opacity="0.6"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"
                                                IsVisible="{Binding Trigger,
                                                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                        <shared:AppEmptyState
                            IsVisible="{Binding HasNoItems}"
                            Icon="automation"
                            Title="{loc:Translate Key=&quot;No automations&quot;}"
                            Description="{loc:Translate Key=&quot;Create your first automation to get started.&quot;}"
                            ActionText="{loc:Translate Key=&quot;New Automation&quot;}"
                            ActionCommand="{Binding NewCommand}">

                            <shared:AppEmptyState.Examples>
                                <sys:String>Notify me when Chrome updates</sys:String>
                                <sys:String>Refresh Pip after Python installs</sys:String>
                                <sys:String>Take a snapshot before every update</sys:String>
                            </shared:AppEmptyState.Examples>

                        </shared:AppEmptyState>

                    </Grid>

                </Grid>

            </shared:AppToolbar>

            <!-- Ayırıcı -->

            <GridSplitter
                Grid.Column="1"
                Width="4"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"/>

            <!-- Sağ: editör -->

            <Border
                Grid.Column="2"
                Classes="card"
                Padding="20"
                ClipToBounds="True">

                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Spacing="14">

                        <StackPanel Spacing="4">

                            <TextBlock
                                FontSize="{DynamicResource FontSection}"
                                FontWeight="SemiBold"
                                Text="{loc:TranslateBinding Path=EditorTitle}"/>

                            <TextBlock
                                Opacity="0.65"
                                Text="{loc:TranslateBinding Path=EditorDescription}"/>

                        </StackPanel>

                        <StackPanel Spacing="6">

                            <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Name&quot;}"/>

                            <TextBox
                                PlaceholderText="{loc:Translate Key=&quot;Automation name&quot;}"
                                Text="{Binding Name}"/>

                        </StackPanel>

                        <StackPanel Spacing="6">

                            <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Trigger&quot;}"/>

                            <TextBox
                                PlaceholderText="{loc:Translate Key=&quot;e.g. On update available, On startup&quot;}"
                                Text="{Binding Trigger}"/>

                        </StackPanel>

                        <StackPanel Spacing="6">

                            <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Condition&quot;}"/>

                            <TextBox
                                PlaceholderText="{loc:Translate Key=&quot;When this condition is met&quot;}"
                                Text="{Binding Condition}"/>

                        </StackPanel>

                        <StackPanel Spacing="6">

                            <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Action&quot;}"/>

                            <TextBox
                                PlaceholderText="{loc:Translate Key=&quot;What to run, e.g. upgrade all packages&quot;}"
                                Text="{Binding Action}"/>

                        </StackPanel>

                        <shared:AppSeparator/>

                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">

                            <shared:AppButton
                                Classes="Accent"
                                MinWidth="120"
                                Content="{loc:Translate Key=&quot;Save&quot;}"
                                Command="{Binding SaveCommand}"/>

                            <shared:AppButton
                                Grid.Column="1"
                                Classes="Danger"
                                MinWidth="110"
                                Content="{loc:Translate Key=&quot;Delete&quot;}"
                                Command="{Binding DeleteCommand}"
                                IsVisible="{Binding IsEditing}"/>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

        <shared:AppEmptyState
            Grid.Row="2"
            IsVisible="{Binding HasError}"
            Icon="warning"
            Title="{loc:Translate Key=&quot;Couldn&apos;t load automations&quot;}"
            Description="{loc:TranslateBinding Path=ErrorMessage}"
            ActionText="{loc:Translate Key=&quot;Retry&quot;}"
            ActionCommand="{Binding RefreshCommand}"/>

        <shared:LoadingOverlay
            Grid.RowSpan="3"
            IsLoading="{Binding IsLoading}"
            Message="{loc:Translate Key=&quot;Loading automations...&quot;}"/>

    </Grid>

</UserControl>
