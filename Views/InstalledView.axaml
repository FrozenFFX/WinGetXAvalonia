<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:package="using:WinGetXAvalonia.Controls.Package"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Views.InstalledView"
    x:Name="Root"
    x:DataType="vm:InstalledViewModel">

    <UserControl.KeyBindings>
        <KeyBinding
            Gesture="F5"
            Command="{Binding RefreshCommand}"/>
        <KeyBinding
            Gesture="Ctrl+A"
            Command="{Binding SelectAllCommand}"/>
        <KeyBinding
            Gesture="Ctrl+R"
            Command="{Binding RefreshCommand}"/>
        <KeyBinding
            Gesture="Ctrl+U"
            Command="{Binding UpdateSelectedCommand}"/>
        <KeyBinding
            Gesture="Delete"
            Command="{Binding #Root.DataContext.RemoveSelectedCommand}"/>
    </UserControl.KeyBindings>

    <Grid
        Margin="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <shared:SectionHeader
            Grid.Row="0"
            Title="{loc:Translate Key=&quot;Installed Packages&quot;}"
            Description="{loc:Translate Key=&quot;Manage all installed applications.&quot;}"/>

        <!-- Toolbar (with bulk actions) -->
        <Grid
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            RowDefinitions="Auto,Auto">

            <package:PackageToolbar
                Grid.Row="0"
                SearchText="{Binding SearchText}"
                PackageCount="{Binding PackageCount}"
                RefreshCommand="{Binding RefreshCommand}"
                SelectedSort="{Binding SelectedSort}"
                SelectedFilter="{Binding SelectedFilter}"/>

            <Border
                Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12,8"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                IsVisible="{Binding SelectedCount,
                Converter={StaticResource PositiveToBoolConverter}}">

                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Height" Duration="0:0:0.2"/>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
                    </Transitions>
                </Border.Transitions>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                    <TextBlock
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Text="{Binding SelectedCount,
                        StringFormat={}{0} selected}"/>

                    <shared:AppButton
                        Grid.Column="2"
                        Content="{Binding SelectedCount,
                        StringFormat=Update ({0})}"
                        Command="{Binding UpdateSelectedCommand}"/>

                    <shared:AppButton
                        Grid.Column="3"
                        Classes="Danger"
                        Content="{Binding SelectedCount,
                        StringFormat=Remove ({0})}"
                        Command="{Binding RemoveSelectedCommand}"/>
                </Grid>

            </Border>

        </Grid>

        <!-- Master-Detail -->
<shared:MasterDetailPage
    Grid.Row="3"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    IsLoading="{Binding IsLoading}"
    LoadingMessage="{loc:Translate Key=&quot;Loading installed packages...&quot;}"
    DetailWidth="{Binding SelectedPackage,
    Converter={StaticResource DetailWidthConverter}}">

            <shared:MasterDetailPage.MasterContent>

                <Grid>

<ListBox
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ItemsSource="{Binding Packages}"
                    SelectedItem="{Binding SelectedPackage}"
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.IsDeferredScrollingEnabled="True">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel CacheLength="0.5"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:PackageCard/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Empty state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding IsEmpty}"
                        Icon="package"
                        Title="{loc:Translate Key=&quot;No installed packages&quot;}"
                        Description="{loc:Translate Key=&quot;Applications installed with WinGet will appear here.&quot;}"
                        ActionText="{loc:Translate Key=&quot;Browse Packages&quot;}"
                        ActionCommand="{Binding BrowseCommand}"/>

                    <!-- Error state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding HasError}"
                        Icon="warning"
                        Title="{loc:Translate Key=&quot;Couldn&apos;t load installed packages&quot;}"
                        Description="{loc:TranslateBinding Path=ErrorMessage}"
                        ActionText="{loc:Translate Key=&quot;Retry&quot;}"
                        ActionCommand="{Binding RefreshCommand}"/>

                </Grid>

            </shared:MasterDetailPage.MasterContent>

            <shared:MasterDetailPage.DetailContent>

                <package:PackageDetailsPanel
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    DataContext="{Binding Details}"
                    IsVisible="{Binding SelectedPackage,
                    Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>

            </shared:MasterDetailPage.DetailContent>

        </shared:MasterDetailPage>

    </Grid>

</UserControl>
