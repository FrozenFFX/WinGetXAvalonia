<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush
        x:Key="AccentBrush"
        Color="{StaticResource Color.Accent}" />

    <SolidColorBrush
        x:Key="TextBrush"
        Color="{StaticResource Color.TextPrimary}" />

    </ResourceDictionary>
