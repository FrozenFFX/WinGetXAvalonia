<Window xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:layout="using:WinGetXAvalonia.Controls.Layout"
    xmlns:operation="using:WinGetXAvalonia.Controls.Operation"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:conv="using:WinGetXAvalonia.Converters"
    xmlns:svg="using:Avalonia.Svg"
    mc:Ignorable="d"
    x:Class="WinGetXAvalonia.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Width="1440"
    Height="900"
    MinWidth="360"
    MinHeight="560"
    CanResize="True"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    Icon="/Assets/WinGetXStudio.ico"
    Background="{DynamicResource Background}"
    Title="{loc:Translate Key=&quot;WinGetX Studio&quot;}">

    <Window.KeyBindings>
        <KeyBinding
            Gesture="Ctrl+K"
            Command="{Binding Palette.ToggleCommand}"/>
    </Window.KeyBindings>

    <Grid
        x:Name="ShellRoot"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True"
        MinWidth="0"
        MinHeight="0"
        ColumnSpacing="0"
        RowSpacing="0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="0" MaxWidth="260"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->

        <Border
            Grid.Row="0"
            Grid.ColumnSpan="4"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">

            <Grid
                Margin="16,0,24,0"
                ColumnDefinitions="Auto,*,Auto">

                    <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">

                    <shared:AppButton
                        x:Name="MobileMenuButton"
                        Width="36"
                        Height="36"
                        Padding="0"
                        IsVisible="False"
                        ToolTip.Tip="{loc:Translate Key=&quot;Open navigation menu&quot;}"
                        Click="OnMobileMenuClick">
                        <Path
                            Width="18"
                            Height="18"
                            Data="{StaticResource IconMenu}"
                            Fill="{DynamicResource AccentBrush}"
                            Stretch="Uniform"/>
                    </shared:AppButton>

                    <Border
                        Width="30"
                        Height="30"
                        CornerRadius="9"
                        Background="{DynamicResource AccentSubtle}">
                        <svg:Svg
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Path="avares://WinGetXAvalonia/Assets/WinGetXStudio.svg"/>
                    </Border>

                    <TextBlock
                        FontSize="{DynamicResource FontCardTitle}"
                        FontWeight="SemiBold"
                        Text="{loc:Translate Key=&quot;WinGetX Studio&quot;}"/>

                </StackPanel>

                <Border
                    Grid.Column="2"
                    Height="26"
                    Padding="10,0"
                    CornerRadius="{DynamicResource RadiusLarge}"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource CardBrush}">

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="6">

                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>

                        <TextBlock
                            FontSize="{DynamicResource FontSecondary}"
                            FontWeight="SemiBold"
                            Opacity="0.8"
                            Text="{loc:TranslateBinding Path=StatusLabel}"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- Sidebar -->

        <layout:LeftSidebar
            x:Name="DesktopSidebar"
            Grid.Row="1"
            Grid.Column="0"
            ZIndex="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="3"
            Background="{DynamicResource BackgroundAmbientBrush}"
            IsHitTestVisible="False"
            ZIndex="-1"/>

        <!-- Main Content -->

        <ScrollViewer
            x:Name="MainContentScroller"
            Grid.Row="1"
            Grid.Column="1"
            Margin="28,24,28,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            ClipToBounds="True"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <TransitioningContentControl
                x:Name="MainContentHost"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Top"
                ClipToBounds="False"
                Content="{loc:TranslateBinding Path=Navigation.CurrentPage}">

                <TransitioningContentControl.PageTransition>
                    <CompositePageTransition>
                        <CompositePageTransition.PageTransitions>
                            <PageSlide
                                Duration="0:0:0.160"
                                Orientation="Horizontal"/>
                            <CrossFade Duration="0:0:0.160"/>
                        </CompositePageTransition.PageTransitions>
                    </CompositePageTransition>
                </TransitioningContentControl.PageTransition>

            </TransitioningContentControl>

        </ScrollViewer>

        <!-- Detail Host -->

        <layout:DetailHost
            x:Name="DetailHost"
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,28,0,28"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Title="{loc:TranslateBinding Path=DetailTitle}"
            Subtitle="{loc:TranslateBinding Path=DetailSubtitle}"
            Content="{loc:TranslateBinding Path=DetailContent}"
            IsVisible="{Binding IsDetailVisible}"/>

        <!-- Operations -->

        <layout:RightOperations
            x:Name="OperationsHost"
            Grid.Row="1"
            Grid.Column="3"
            Margin="0,28,28,28"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DataContext="{Binding OperationDrawer}"/>

        <Border
            x:Name="MobileScrim"
            Grid.Row="1"
            Grid.ColumnSpan="4"
            Background="{DynamicResource ScrimBrush}"
            IsVisible="False"
            ZIndex="19"
            PointerPressed="OnMobileScrimPressed"/>

        <!-- Status Bar -->

        <layout:StatusBar
            Grid.Row="3"
            Grid.ColumnSpan="4"
            Height="30"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>

        <!-- Founder Signature -->
        <!-- Developer bilgisi değil; founder imzasıdır. Shell'e aittir,
             status bar'ın hemen üstünde sağ altta durur, hiçbir kontrolü
             engellemez ve odak almaz. -->

        <shared:FounderSignature
            Grid.Row="2"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Margin="0,2,24,4"
            IsVisible="{Binding ShowFounderSignature}"/>

        <!-- Command Palette -->

        <controls:CommandPalette
            Grid.RowSpan="4"
            Grid.ColumnSpan="4"
            ZIndex="1000"
            DataContext="{Binding Palette}"/>

    </Grid>

</Window>
