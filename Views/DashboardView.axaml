<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    x:Class="WinGetXAvalonia.Views.DashboardView"
    x:DataType="vm:DashboardViewModel">

    <ScrollViewer>

        <StackPanel Margin="25" Spacing="8">

            <TextBlock
                Classes="title"
                Text="Home"/>

            <StackPanel Spacing="8"
                        IsVisible="{Binding IsLoading}">
                <TextBlock Text="Loading..."/>
                <ProgressBar IsIndeterminate="True"/>
            </StackPanel>

            <TextBlock
                Margin="0,18,0,8"
                Opacity="0.7"
                Text="Overview"/>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:DashboardStatCard/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Margin="0,18,0,8"
                Opacity="0.7"
                Text="System"/>

            <ItemsControl ItemsSource="{Binding SystemCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:SystemCard/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>

    </ScrollViewer>

</UserControl>
