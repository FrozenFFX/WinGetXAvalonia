<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:cards="using:WinGetXAvalonia.Controls.Cards"
    x:Class="WinGetXAvalonia.Views.EnterpriseView"
    x:Name="Root"
    x:DataType="vm:EnterpriseViewModel"
    x:CompileBindings="False">

    <UserControl.KeyBindings>
        <KeyBinding
            Gesture="F5"
            Command="{Binding LoadCommand}"/>
    </UserControl.KeyBindings>

    <Grid
        Margin="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="False">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Grid.Row="0"
            Title="{loc:Translate Key=&quot;Enterprise&quot;}"
            Description="{loc:Translate Key=&quot;Manage your company fleet — remotely.&quot;}"/>

        <TabControl
            Grid.Row="2"
            BorderThickness="0"
            Background="Transparent"
            Padding="0,12,0,0">

            <!-- ─────────── This Computer ─────────── -->

            <TabItem Header="{loc:Translate Key=&quot;workspace This Computer&quot;}">

                <Grid RowDefinitions="Auto,12,Auto,12,*">

                    <Border
                        Grid.Row="0"
                        Padding="18,16"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMedium}">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                            <Border
                                Width="52"
                                Height="52"
                                CornerRadius="26"
                                Background="{DynamicResource SurfaceBrush}">
                                <TextBlock
                                    Text="{loc:Translate Key=&quot;windows&quot;}"
                                    FontSize="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">

                                <TextBlock
                                    FontSize="{DynamicResource FontSubtitle}"
                                    FontWeight="SemiBold"
                                    Text="{loc:TranslateBinding Path=LocalMachineName}"/>

                                <TextBlock
                                    FontSize="{DynamicResource FontSecondary}"
                                    Opacity="0.6">
                                    <TextBlock.Inlines>
                                        <Run Text="{Binding LocalOs, Mode=OneWay}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding LocalArchitecture, Mode=OneWay}"/>
                                    </TextBlock.Inlines>
                                </TextBlock>

                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Spacing="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                                <TextBlock
                                    FontSize="{DynamicResource FontCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="{loc:Translate Key=&quot;Local machine only&quot;}"/>

                                <TextBlock
                                    FontSize="{DynamicResource FontMicro}"
                                    Opacity="0.6"
                                    Text="{loc:Translate Key=&quot;Remote management is not configured.&quot;}"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <StackPanel Grid.Row="2" Spacing="10">

                        <UniformGrid Columns="{Binding #Root.Bounds.Width, Converter={StaticResource StatColumnsConverter}}">

                            <shared:AppCard>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Translate Key=&quot;CPU&quot;}" FontSize="{DynamicResource FontMicro}" Opacity="0.6"/>
                                    <TextBlock Text="{loc:TranslateBinding Path=LocalCpuName}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </shared:AppCard>

                            <shared:AppCard>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Translate Key=&quot;Threads&quot;}" FontSize="{DynamicResource FontMicro}" Opacity="0.6"/>
                                    <TextBlock Text="{loc:TranslateBinding Path=LocalCpuThreads}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </shared:AppCard>

                            <shared:AppCard>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Translate Key=&quot;RAM&quot;}" FontSize="{DynamicResource FontMicro}" Opacity="0.6"/>
                                    <TextBlock Text="{loc:TranslateBinding Path=LocalRam}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </shared:AppCard>

                            <shared:AppCard>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Translate Key=&quot;GPU&quot;}" FontSize="{DynamicResource FontMicro}" Opacity="0.6"/>
                                    <TextBlock Text="{loc:TranslateBinding Path=LocalGpu}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </shared:AppCard>

                        </UniformGrid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                            <shared:AppCard>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Translate Key=&quot;Pending Updates (winget)&quot;}" FontSize="{DynamicResource FontMicro}" Opacity="0.6"/>
                                    <TextBlock Text="{loc:TranslateBinding Path=PendingUpdateCount}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </shared:AppCard>

                            <shared:AppCard Grid.Column="1">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Translate Key=&quot;Failed Operations (history)&quot;}" FontSize="{DynamicResource FontMicro}" Opacity="0.6"/>
                                    <TextBlock Text="{loc:TranslateBinding Path=FailedOperationsCount}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </shared:AppCard>

                        </Grid>

                    </StackPanel>

                    <shared:AppCard Grid.Row="4">

                        <StackPanel Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">

                                <TextBlock FontSize="{DynamicResource FontButton}" FontWeight="SemiBold" Text="{loc:Translate Key=&quot;System Details&quot;}"/>

                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="{DynamicResource FontSecondary}"
                                    Opacity="0.6"
                                    Text="{loc:Translate Key=&quot;Read from Windows&quot;}"/>

                            </Grid>

                            <shared:AppSeparator/>

                            <ItemsControl ItemsSource="{Binding LocalInfo}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HeroInfoItem">

                                        <Grid
                                            ColumnDefinitions="Auto,120,*"
                                            ColumnSpacing="10"
                                            Margin="0,4">

                                            <Path
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                                Fill="{DynamicResource SubtextBrush}"
                                                Stretch="Uniform"/>

                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="{DynamicResource FontCaption}"
                                                Opacity="0.6"
                                                Text="{loc:TranslateBinding Path=Label}"/>

                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="{DynamicResource FontCaption}"
                                                FontWeight="SemiBold"
                                                Text="{loc:TranslateBinding Path=Value}"
                                                TextWrapping="Wrap"/>

                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </shared:AppCard>

                </Grid>

            </TabItem>

            <!-- ─────────── Dashboard ─────────── -->

            <TabItem Header="{loc:Translate Key=&quot;enterprise Dashboard&quot;}">

                <Grid RowDefinitions="Auto,16,*">

                    <UniformGrid
                        Grid.Row="0"
                        Columns="{Binding #Root.Bounds.Width, Converter={StaticResource StatColumnsConverter}}">

                        <cards:StatCard
                            Icon="windows"
                            Subtitle="{loc:Translate Key=&quot;Total Computers&quot;}"
                            Value="{Binding Total}"/>

                        <cards:StatCard
                            Icon="success"
                            Subtitle="{loc:Translate Key=&quot;Online&quot;}"
                            Value="{Binding Online}"/>

                        <cards:StatCard
                            Icon="error"
                            Subtitle="{loc:Translate Key=&quot;Offline&quot;}"
                            Value="{Binding Offline}"/>

                        <cards:StatCard
                            Icon="update"
                            Subtitle="{loc:Translate Key=&quot;Pending Updates&quot;}"
                            Value="{Binding PendingUpdates}"/>

                        <cards:StatCard
                            Icon="warning"
                            Subtitle="{loc:Translate Key=&quot;Critical Updates&quot;}"
                            Value="{Binding CriticalUpdates}"/>

                        <cards:StatCard
                            Icon="error"
                            Subtitle="{loc:Translate Key=&quot;Failed Installations&quot;}"
                            Value="{Binding FailedInstallations}"/>

                    </UniformGrid>

                    <shared:MasterDetailPage
                        Grid.Row="2"
                        IsLoading="{Binding IsLoading}"
                        LoadingMessage="{loc:Translate Key=&quot;Loading fleet...&quot;}"
                        DetailWidth="0.7*">

                        <shared:MasterDetailPage.MasterContent>

                            <Grid RowDefinitions="Auto,10,*">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                                    <shared:SearchBox
                                        Grid.Column="0"
                                        Watermark="{loc:Translate Key=&quot;Search computers...&quot;}"
                                        Text="{Binding SearchText}"/>

                                <shared:AppButton
                                    Grid.Column="2"
                                    Width="44"
                                    ToolTip.Tip="{loc:Translate Key=&quot;Refresh&quot;}"
                                    Command="{Binding LoadCommand}">

                                    <Path
                                        Width="18"
                                        Height="18"
                                        Data="{StaticResource IconRefresh}"
                                        Fill="{DynamicResource TextBrush}"
                                        Stretch="Uniform"/>
                                </shared:AppButton>

                                </Grid>

                                <Grid Grid.Row="2">

                                    <ListBox
                                        ItemsSource="{Binding FilteredComputers}"
                                        SelectedItem="{Binding SelectedComputer}"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:CompanyComputer">

                                                <Border
                                                    Padding="14,12"
                                                    CornerRadius="12"
                                                    Margin="0,0,0,8">

                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                                        <Border
                                                            Grid.Column="0"
                                                            Width="42"
                                                            Height="42"
                                                            CornerRadius="21"
                                                            Background="{DynamicResource SurfaceBrush}">

                                                            <TextBlock
                                                                Text="{loc:Translate Key=&quot;windows&quot;}"
                                                                FontSize="{DynamicResource FontSectionLarge}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Spacing="2">

                                                            <TextBlock
                                                                Text="{loc:TranslateBinding Path=Name}"
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis"
                                                                MaxLines="1"/>

                                                            <TextBlock
                                                                Text="{loc:TranslateBinding Path=Os}"
                                                                FontSize="{DynamicResource FontSecondary}"
                                                                Opacity="0.6"
                                                                TextTrimming="CharacterEllipsis"
                                                                MaxLines="1"/>

                                                            <TextBlock
                                                                FontSize="{DynamicResource FontSecondary}"
                                                                Opacity="0.6">
                                                                <Run Text="{Binding InstalledSummary, Mode=OneWay}"/>
                                                            </TextBlock>

                                                        </StackPanel>

                                                        <StackPanel
                                                            Grid.Column="2"
                                                            Spacing="4"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">

                                                            <TextBlock
                                                                FontSize="{DynamicResource FontSecondary}"
                                                                FontWeight="SemiBold"
                                                                Text="{loc:TranslateBinding Path=StateText}"/>

                                                            <TextBlock
                                                                FontSize="{DynamicResource FontMicro}"
                                                                Opacity="0.6"
                                                                Text="{Binding LastSeen,
                                                                StringFormat='{}{0:dd.MM HH:mm}'}"/>

                                                        </StackPanel>

                                                    </Grid>

                                                </Border>

                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                    <shared:AppEmptyState
                                        IsVisible="{Binding IsEmpty}"
                                        Icon="enterprise"
                                        Title="{loc:Translate Key=&quot;No computers in the fleet&quot;}"
                                        Description="{loc:Translate Key=&quot;Add managed devices to start using Enterprise.&quot;}"/>

                                    <shared:AppEmptyState
                                        IsVisible="{Binding HasError}"
                                        Icon="warning"
                                        Title="{loc:Translate Key=&quot;Couldn&apos;t load the fleet&quot;}"
                                        Description="{loc:TranslateBinding Path=ErrorMessage}"
                                        ActionText="{loc:Translate Key=&quot;Retry&quot;}"
                                        ActionCommand="{Binding LoadCommand}"/>

                                </Grid>

                            </Grid>

                        </shared:MasterDetailPage.MasterContent>

                        <shared:MasterDetailPage.DetailContent>

                            <Border
                                Padding="20"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusMedium}">

                                <Panel>

                                    <ScrollViewer IsVisible="{Binding !IsNothingSelected}">

                                        <StackPanel Spacing="16">

                                            <Grid ColumnDefinitions="*,Auto">

                                                <StackPanel Spacing="2">

                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSectionLarge}"
                                                        FontWeight="SemiBold"
                                                        Text="{loc:TranslateBinding Path=SelectedComputer.Name}"/>

                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSecondary}"
                                                        Opacity="0.6"
                                                        Text="{loc:TranslateBinding Path=SelectedComputer.Os}"/>

                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="{DynamicResource FontCaption}"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center"
                                                    Text="{loc:TranslateBinding Path=SelectedComputer.StateText}"/>

                                            </Grid>

                                            <UniformGrid Columns="{Binding #Root.Bounds.Width, Converter={StaticResource StatColumnsConverter}}">

                                                <shared:AppCard>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{loc:Translate Key=&quot;CPU&quot;}" FontSize="{DynamicResource FontMicro}" Opacity="0.6"/>
                                                        <TextBlock Text="{loc:TranslateBinding Path=SelectedComputer.Cpu}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </shared:AppCard>

                                                <shared:AppCard>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{loc:Translate Key=&quot;RAM&quot;}" FontSize="{DynamicResource FontMicro}" Opacity="0.6"/>
                                                        <TextBlock Text="{loc:TranslateBinding Path=SelectedComputer.Ram}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </shared:AppCard>

                                                <shared:AppCard>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{loc:Translate Key=&quot;Pending Updates&quot;}" FontSize="{DynamicResource FontMicro}" Opacity="0.6"/>
                                                        <TextBlock Text="{loc:TranslateBinding Path=SelectedComputer.PendingUpdates}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </shared:AppCard>

                                                <shared:AppCard>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{loc:Translate Key=&quot;Critical&quot;}" FontSize="{DynamicResource FontMicro}" Opacity="0.6"/>
                                                        <TextBlock Text="{loc:TranslateBinding Path=SelectedComputer.CriticalUpdates}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </shared:AppCard>

                                            </UniformGrid>

                                            <shared:AppSeparator/>

                                            <StackPanel Spacing="6">

                                                <TextBlock FontSize="{DynamicResource FontButton}" FontWeight="SemiBold" Text="{loc:Translate Key=&quot;Remote Installation&quot;}"/>

                                                <UniformGrid Columns="{Binding #Root.Bounds.Width, Converter={StaticResource StatColumnsConverter}}">

                                                    <shared:AppButton
                                                        Classes="Accent"
                                                        Content="{loc:Translate Key=&quot;Chrome&quot;}"
                                                        Command="{Binding InstallPackageCommand}"
                                                        CommandParameter="Google Chrome"/>

                                                    <shared:AppButton
                                                        Classes="Accent"
                                                        Content="{loc:Translate Key=&quot;Git&quot;}"
                                                        Command="{Binding InstallPackageCommand}"
                                                        CommandParameter="Git"/>

                                                    <shared:AppButton
                                                        Classes="Accent"
                                                        Content="{loc:Translate Key=&quot;VSCode&quot;}"
                                                        Command="{Binding InstallPackageCommand}"
                                                        CommandParameter="Visual Studio Code"/>

                                                    <shared:AppButton
                                                        Classes="Danger"
                                                        Content="{loc:Translate Key=&quot;Restart&quot;}"
                                                        Command="{Binding RestartCommand}"/>

                                                </UniformGrid>

                                            </StackPanel>

                                            <StackPanel Spacing="6">

                                                <TextBlock FontSize="{DynamicResource FontButton}" FontWeight="SemiBold" Text="{loc:Translate Key=&quot;Send PowerShell&quot;}"/>

                                                <TextBox
                                                    AcceptsReturn="True"
                                                    MinHeight="80"
                                                    TextWrapping="Wrap"
                                                    VerticalContentAlignment="Top"
                                                    Text="{Binding PowerShellScript}"/>

                                                <shared:AppButton
                                                    HorizontalAlignment="Right"
                                                    MinWidth="140"
                                                    Content="{loc:Translate Key=&quot;Send Script&quot;}"
                                                    Command="{Binding SendPowerShellCommand}"/>

                                            </StackPanel>

                                            <shared:AppSeparator/>

                                            <StackPanel Spacing="6">

                                                <Grid ColumnDefinitions="*,Auto">

                                                    <TextBlock FontSize="{DynamicResource FontButton}" FontWeight="SemiBold" Text="{loc:Translate Key=&quot;Command Log&quot;}"/>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="{DynamicResource FontSecondary}"
                                                        Opacity="0.6"
                                                        Text="{loc:Translate Key=&quot;Last actions&quot;}"/>

                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Commands}">

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:RemoteCommand">

                                                            <Border
                                                                Margin="0,0,0,6"
                                                                Padding="12,10"
                                                                CornerRadius="10"
                                                                Background="{DynamicResource SurfaceBrush}">

                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                     Text="{loc:Translate Key=&quot;update&quot;}"
                                                                     VerticalAlignment="Center"/>

                                                                    <StackPanel Grid.Column="1" Spacing="1">

                                                                        <TextBlock
                                                                            FontSize="{DynamicResource FontCaption}"
                                                                            FontWeight="SemiBold"
                                                                            Text="{loc:TranslateBinding Path=Payload}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            MaxLines="1"/>

                                                                        <TextBlock
                                                                            FontSize="{DynamicResource FontMicro}"
                                                                            Opacity="0.6">
                                                                            <Run Text="{Binding ComputerName, Mode=OneWay}"/>
                                                                            <Run Text="•"/>
                                                                            <Run Text="{Binding Kind, Mode=OneWay}"/>
                                                                            <Run Text="•"/>
                                                                            <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat='{}{0:HH:mm:ss}'}"/>
                                                                        </TextBlock>

                                                                    </StackPanel>

                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        FontSize="{DynamicResource FontSecondary}"
                                                                        VerticalAlignment="Center"
                                                                        Text="{loc:TranslateBinding Path=Status}"/>

                                                                </Grid>

                                                            </Border>

                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>

                                                </ItemsControl>

                                            </StackPanel>

                                        </StackPanel>

                                    </ScrollViewer>

                                    <shared:AppEmptyState
                                        IsVisible="{Binding IsNothingSelected}"
                                        Icon="windows"
                                        Title="{loc:Translate Key=&quot;Select a computer&quot;}"
                                        Description="{loc:Translate Key=&quot;Choose a device to run remote commands.&quot;}"/>

                                </Panel>

                            </Border>

                        </shared:MasterDetailPage.DetailContent>

                    </shared:MasterDetailPage>

                </Grid>

            </TabItem>

            <!-- ─────────── Policies ─────────── -->

            <TabItem Header="{loc:Translate Key=&quot;history Policies&quot;}">

                <Grid RowDefinitions="Auto,10,*" Margin="0,4,0,0">

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                        <shared:AppButton
                            Classes="Accent"
                            HorizontalAlignment="Stretch"
                            Content="{loc:Translate Key=&quot;New Policy&quot;}"
                            Command="{Binding NewPolicyCommand}"/>

                        <shared:AppButton
                            Grid.Column="1"
                            Content="{loc:Translate Key=&quot;Check Violations&quot;}"
                            Command="{Binding EvaluatePoliciesCommand}"/>

                        <shared:AppButton
                            Grid.Column="2"
                            Width="44"
                            ToolTip.Tip="{loc:Translate Key=&quot;Refresh&quot;}"
                            Command="{Binding LoadCommand}">

                            <Path
                                Width="18"
                                Height="18"
                                Data="{StaticResource IconRefresh}"
                                Fill="{DynamicResource TextBrush}"
                                Stretch="Uniform"/>
                        </shared:AppButton>

                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="1.4*,12,*">

                        <Border
                            Grid.Column="0"
                            Padding="4"
                            Classes="card">

                            <Grid>

                                <ListBox
                                    ItemsSource="{Binding Policies}"
                                    SelectedItem="{Binding SelectedPolicy}"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:PolicyRule">

                                            <Border Padding="14,10" CornerRadius="10">

                                                <StackPanel Spacing="2">

                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{loc:TranslateBinding Path=Name}"/>

                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSecondary}"
                                                        Opacity="0.6"
                                                        Text="{loc:TranslateBinding Path=Description}"
                                                        TextTrimming="CharacterEllipsis"
                                                        MaxLines="1"/>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                                <shared:AppEmptyState
                                    IsVisible="{Binding IsEmpty}"
                                    Icon="history"
                                    Title="{loc:Translate Key=&quot;No policies&quot;}"
                                    Description="{loc:Translate Key=&quot;Create your first company policy.&quot;}"/>

                            </Grid>

                        </Border>

                        <GridSplitter Grid.Column="1"/>

                        <Border
                            Grid.Column="2"
                            Padding="20"
                            Classes="card">

                            <StackPanel Spacing="14">

                                <StackPanel Spacing="4">

                                    <TextBlock
                                        FontSize="{DynamicResource FontSectionLarge}"
                                        FontWeight="SemiBold"
                                        Text="{loc:TranslateBinding Path=EditorPolicyTitle}"/>

                                    <TextBlock
                                        FontSize="{DynamicResource FontSecondary}"
                                        Opacity="0.6"
                                        Text="{loc:Translate Key=&quot;Policies are enforced across the fleet.&quot;}"/>

                                </StackPanel>

                                <StackPanel Spacing="6">

                                    <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Name&quot;}"/>

                                    <TextBox
                                        PlaceholderText="{loc:Translate Key=&quot;e.g. No Steam&quot;}"
                                        Text="{Binding PolicyName}"/>

                                </StackPanel>

                                <StackPanel Spacing="6">

                                    <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Action&quot;}"/>

                                    <ComboBox
                                        ItemsSource="{Binding PolicyActionOptions}"
                                        SelectedIndex="{Binding PolicyActionIndex}"
                                        HorizontalAlignment="Stretch"/>

                                </StackPanel>

                                <StackPanel Spacing="6">

                                    <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Package&quot;}"/>

                                    <TextBox
                                        PlaceholderText="{loc:Translate Key=&quot;e.g. Steam&quot;}"
                                        Text="{Binding PolicyPackage}"/>

                                </StackPanel>

                                <StackPanel Spacing="6">

                                    <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Description&quot;}"/>

                                    <TextBox
                                        AcceptsReturn="True"
                                        MinHeight="70"
                                        TextWrapping="Wrap"
                                        VerticalContentAlignment="Top"
                                        PlaceholderText="{loc:Translate Key=&quot;What does this policy do?&quot;}"
                                        Text="{Binding PolicyDescription}"/>

                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                                    <CheckBox
                                        Content="{loc:Translate Key=&quot;Enabled&quot;}"
                                        IsChecked="{Binding PolicyEnabled}"
                                        VerticalAlignment="Center"/>

                                </Grid>

                                <shared:AppSeparator/>

                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">

                                    <shared:AppButton
                                        Classes="Accent"
                                        MinWidth="120"
                                        Content="{loc:Translate Key=&quot;Save&quot;}"
                                        Command="{Binding SavePolicyCommand}"/>

                                    <shared:AppButton
                                        Grid.Column="1"
                                        Classes="Danger"
                                        MinWidth="110"
                                        Content="{loc:Translate Key=&quot;Delete&quot;}"
                                        Command="{Binding DeletePolicyCommand}"
                                        IsVisible="{Binding IsEditingPolicy}"/>

                                </Grid>

                                <shared:AppSeparator/>

                                <StackPanel Spacing="8">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock FontSize="{DynamicResource FontButton}" FontWeight="SemiBold" Text="{loc:Translate Key=&quot;Violations&quot;}"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="{DynamicResource FontSecondary}"
                                            Opacity="0.6"
                                            Text="{Binding Violations.Count, StringFormat='{}{0} found'}"/>

                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Violations}">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PolicyViolation">

                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="12,10"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource SurfaceBrush}">

                                                    <StackPanel Spacing="2">

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontCaption}"
                                                            FontWeight="SemiBold">
                                                            <Run Text="{Binding ComputerName, Mode=OneWay}"/>
                                                            <Run Text="—"/>
                                                            <Run Text="{Binding Package, Mode=OneWay}"/>
                                                        </TextBlock>

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontSecondary}"
                                                            Opacity="0.7"
                                                            Text="{loc:TranslateBinding Path=Message}"
                                                            TextWrapping="Wrap"/>

                                                    </StackPanel>

                                                </Border>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                    <shared:AppEmptyState
                                        IsVisible="{Binding !HasViolations}"
                                        Icon="success"
                                        Title="{loc:Translate Key=&quot;No violations&quot;}"
                                        Description="{loc:Translate Key=&quot;Run Check Violations to scan the fleet.&quot;}"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>

            </TabItem>

            <!-- ─────────── Reports ─────────── -->

            <TabItem Header="{loc:Translate Key=&quot;diagnostics Reports&quot;}">

                <StackPanel Spacing="14" Margin="0,4,0,0">

                    <shared:AppCard>

                        <StackPanel Spacing="12">

                            <StackPanel Spacing="2">

                                <TextBlock FontSize="{DynamicResource FontSubtitle}" FontWeight="SemiBold" Text="{loc:Translate Key=&quot;Weekly Fleet Report&quot;}"/>

                                <TextBlock
                                    FontSize="{DynamicResource FontSecondary}"
                                    Opacity="0.6"
                                    Text="{loc:Translate Key=&quot;Export the current state of your fleet in multiple formats.&quot;}"/>

                            </StackPanel>

                            <TextBlock
                                FontSize="{DynamicResource FontCaption}"
                                Opacity="0.75">
                                <Run Text="{Binding FleetSummary, Mode=OneWay}"/>
                                <Run Text="•"/>
                                <Run Text="{Binding PendingUpdates, Mode=OneWay}"/>
                                <Run Text="{loc:Translate Key=&quot; pending updates&quot;}"/>
                            </TextBlock>

                            <shared:AppSeparator/>

                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">

                                <shared:AppButton
                                    Content="{loc:Translate Key=&quot;JSON&quot;}"
                                    Command="{Binding ExportJsonCommand}"/>

                                <shared:AppButton
                                    Grid.Column="1"
                                    Content="{loc:Translate Key=&quot;CSV&quot;}"
                                    Command="{Binding ExportCsvCommand}"/>

                                <shared:AppButton
                                    Grid.Column="2"
                                    Content="{loc:Translate Key=&quot;HTML&quot;}"
                                    IsEnabled="False"/>

                                <shared:AppButton
                                    Grid.Column="3"
                                    Content="{loc:Translate Key=&quot;Excel&quot;}"
                                    IsEnabled="False"/>

                                <shared:AppButton
                                    Grid.Column="4"
                                    Content="{loc:Translate Key=&quot;PDF&quot;}"
                                    IsEnabled="False"/>

                            </Grid>

                            <TextBlock
                                FontSize="{DynamicResource FontMicro}"
                                Opacity="0.5"
                                Text="{loc:Translate Key=&quot;HTML, Excel and PDF exports are planned for an upcoming release.&quot;}"/>

                        </StackPanel>

                    </shared:AppCard>

                </StackPanel>

            </TabItem>

        </TabControl>

        <shared:LoadingOverlay
            Grid.Row="2"
            IsLoading="{Binding IsLoading}"
            Message="{loc:Translate Key=&quot;Loading enterprise data...&quot;}"/>

    </Grid>

</UserControl>
