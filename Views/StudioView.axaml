<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:studio="using:WinGetXAvalonia.Controls.Studio"
    xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    x:Class="WinGetXAvalonia.Views.StudioView"
    x:Name="Root"
    x:DataType="vm:StudioViewModel">

    <UserControl.KeyBindings>
        <KeyBinding
            Gesture="F5"
            Command="{Binding RefreshCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>

        <Style Selector="ToggleButton.FilterChip">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.FilterChip:pointerover:not(:checked)">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}"/>
        </Style>

        <Style Selector="ToggleButton.FilterChip:checked">
            <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}"/>
        </Style>

    </UserControl.Styles>

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="{loc:Translate Key=Studio}"
            Description="{loc:TranslateBinding Path=ToolsSummary}"/>

        <!-- Toolbar -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="16"
            CornerRadius="{DynamicResource RadiusMedium}"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">

                <shared:SearchBox
                    MinWidth="320"
                    MaxWidth="560"
                    HorizontalAlignment="Stretch"
                    Watermark="{loc:Translate Key='Search studio tools...'}"
                    Text="{Binding SearchText}"/>

                <ComboBox
                    Grid.Column="1"
                    Width="180"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding Categories}"
                    SelectedValue="{Binding SelectedCategory}"
                    SelectedValueBinding="{Binding Key}"
                    ToolTip.Tip="{loc:Translate Key='Filter by category'}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{loc:TranslateBinding Path=Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <shared:AppButton
                    Grid.Column="2"
                    Width="42"
                    Padding="0"
                    ToolTip.Tip="{loc:Translate Key='Refresh studio tools (F5)'}"
                    Command="{Binding RefreshCommand}">

                    <Path
                        Width="18"
                        Height="18"
                        Data="{StaticResource IconRefresh}"
                        Fill="{DynamicResource TextBrush}"
                        Stretch="Uniform"/>
                </shared:AppButton>

                <Border
                    Grid.Column="3"
                    Padding="10,5"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Text="{loc:TranslateBinding Path=ToolCount}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Filter chips -->
        <ItemsControl
            Grid.Row="2"
            ItemsSource="{Binding Filters}"
            ToolTip.Tip="{loc:Translate Key='Filter by status'}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton
                        Classes="FilterChip"
                        Margin="0,0,8,8"
                        IsChecked="{Binding IsActive, Mode=OneWay}"
                        Command="{Binding $parent[ItemsControl].DataContext.SelectFilterCommand}"
                        CommandParameter="{Binding}">

                        <TextBlock Text="{loc:TranslateBinding Path=Label}"/>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Tools -->
        <Grid
            Grid.Row="4"
            ColumnDefinitions="*,12,0.5*">

            <ScrollViewer
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding Tools}">

                    <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <studio:StudioTile
                                Width="336"
                                Margin="0,0,8,12"
                                Icon="{Binding Icon}"
                                Title="{loc:TranslateBinding Path=Title}"
                                Description="{loc:TranslateBinding Path=Description}"
                                Category="{Binding Category}"
                                Badge="{Binding Badge}"
                                BadgeStatus="{Binding BadgeStatus}"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectToolCommand}"
                                CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"/>

            <Border
                Grid.Column="2"
                Padding="24"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}">

                <Grid>

                    <ScrollViewer
                        IsVisible="{Binding IsToolSelected}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel
                            Spacing="16">

                            <TextBlock
                                FontSize="{DynamicResource FontSection}"
                                FontWeight="SemiBold"
                                Text="{loc:Translate Key='Tool Details'}"/>

                            <ContentControl
                                Content="{loc:TranslateBinding Path=SelectedTool}">

                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:StudioToolViewModel">
                                        <StackPanel Spacing="16">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12">

                                                <Border
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="{DynamicResource RadiusMedium}"
                                                    Background="{DynamicResource StudioAccentSoftBrush}"
                                                    VerticalAlignment="Top">

                                                    <Path
                                                        Width="24"
                                                        Height="24"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                                        Fill="{DynamicResource StudioAccentBrush}"
                                                        Stretch="Uniform"/>
                                                </Border>

                                                <StackPanel
                                                    VerticalAlignment="Center"
                                                    Spacing="6">

                                                    <TextBlock
                                                        Text="{loc:TranslateBinding Path=Title}"
                                                        FontSize="{DynamicResource FontSubtitle}"
                                                        FontWeight="SemiBold"
                                                        TextWrapping="Wrap"/>

                                                    <studio:StudioBadge
                                                        HorizontalAlignment="Left"
                                                        Text="{Binding Badge}"
                                                        Status="{Binding BadgeStatus}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock
                                                Text="{loc:TranslateBinding Path=Description}"
                                                FontSize="{DynamicResource FontBody}"
                                                Foreground="{DynamicResource SubtextBrush}"
                                                TextWrapping="Wrap"/>

                                            <Border
                                                Height="1"
                                                Background="{DynamicResource BorderBrush}"/>

                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                RowDefinitions="Auto,Auto"
                                                RowSpacing="12">

                                                <TextBlock
                                                    FontSize="{DynamicResource FontBody}"
                                                    Foreground="{DynamicResource SubtextBrush}"
                                                    Text="{loc:Translate Key=Category}"/>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="{DynamicResource FontBody}"
                                                    FontWeight="SemiBold"
                                                    Text="{loc:TranslateBinding Path=Category}"/>

                                                <TextBlock
                                                    Grid.Row="1"
                                                    FontSize="{DynamicResource FontBody}"
                                                    Foreground="{DynamicResource SubtextBrush}"
                                                    Text="{loc:Translate Key=Status}"/>

                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    FontSize="{DynamicResource FontBody}"
                                                    FontWeight="SemiBold"
                                                    Text="{loc:TranslateBinding Path=Badge}"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>

                            </ContentControl>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <shared:AppButton
                                    Content="{loc:Translate Key='Open tool'}"
                                    IsEnabled="{Binding SelectedTool.CanOpen}"
                                    Command="{Binding OpenToolCommand}"
                                    CommandParameter="{Binding SelectedTool}"/>

                                <ToggleButton
                                    Classes="FilterChip"
                                    IsChecked="{Binding SelectedTool.IsFavorite, Mode=OneWay}"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    CommandParameter="{Binding SelectedTool}"
                                    ToolTip.Tip="{loc:Translate Key='Toggle favorite'}"
                                    AutomationProperties.Name="{loc:Translate Key='Toggle favorite'}">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource IconStar}"
                                        Fill="{DynamicResource StudioAccentBrush}"
                                        Stretch="Uniform"/>
                                </ToggleButton>
                            </StackPanel>

                        </StackPanel>

                    </ScrollViewer>

                    <ScrollViewer
                        IsVisible="{Binding !IsToolSelected}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel
                            Spacing="16">

                            <StackPanel Spacing="8">

                                <TextBlock
                                    FontSize="{DynamicResource FontSection}"
                                    FontWeight="SemiBold"
                                    Text="{loc:Translate Key=Studio}"/>
                                <TextBlock
                                    Opacity="0.6"
                                    TextWrapping="Wrap"
                                    Text="{loc:Translate Key='Select a tool from the list to open its details.'}"/>

                            </StackPanel>

                            <Border
                                Height="1"
                                Background="{DynamicResource BorderBrush}"/>

                            <StackPanel Spacing="8">

                                <TextBlock
                                    FontSize="{DynamicResource FontCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="{loc:Translate Key='Keyboard Shortcuts'}"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock
                                        Opacity="0.7"
                                        VerticalAlignment="Center"
                                        Text="{loc:Translate Key='Open command palette'}"/>
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,3"
                                        CornerRadius="6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                        <TextBlock
                                            FontSize="{DynamicResource FontSecondary}"
                                            FontWeight="SemiBold"
                                            Text="{loc:Translate Key=&quot;Ctrl + K&quot;}"/>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock
                                        Opacity="0.7"
                                        VerticalAlignment="Center"
                                        Text="{loc:Translate Key='Refresh studio tools'}"/>
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,3"
                                        CornerRadius="6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                        <TextBlock
                                            FontSize="{DynamicResource FontSecondary}"
                                            FontWeight="SemiBold"
                                            Text="{loc:Translate Key=&quot;F5&quot;}"/>
                                    </Border>
                                </Grid>

                            </StackPanel>

                            <Border
                                Height="1"
                                Background="{DynamicResource BorderBrush}"/>

                            <StackPanel Spacing="8">

                                <TextBlock
                                    FontSize="{DynamicResource FontCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="{loc:Translate Key=Tips}"/>

                                <TextBlock
                                    Opacity="0.7"
                                    TextWrapping="Wrap"
                                    Text="{loc:Translate Key='Use filters to focus on Ready or Experimental tools.'}"/>
                                <TextBlock
                                    Opacity="0.7"
                                    TextWrapping="Wrap"
                                    Text="{loc:Translate Key='Search by name, description or category.'}"/>

                            </StackPanel>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

            <!-- Filtered empty state (search/filter ile eşleşme yok) -->
            <shared:AppEmptyState
                Grid.Column="0"
                IsVisible="{Binding IsFilteredEmpty}"
                Icon="search"
                Title="{loc:Translate Key='No tools match'}"
                Description="{loc:Translate Key='Try a different search term or filter.'}"/>

            <!-- Empty state -->
            <shared:AppEmptyState
                IsVisible="{Binding IsEmpty}"
                Icon="studio"
                Title="{loc:Translate Key='No studio tools found'}"
                Description="{loc:Translate Key='Try a different search or filter.'}"/>

            <!-- Error state -->
            <shared:AppEmptyState
                IsVisible="{Binding HasError}"
                Icon="warning"
                Title="{loc:Translate Key='Unable to load studio tools'}"
                Description="{loc:TranslateBinding Path=ErrorMessage}"
                ActionText="{loc:Translate Key=Retry}"
                ActionCommand="{Binding RefreshCommand}"/>

        </Grid>

        <shared:LoadingOverlay
            Grid.RowSpan="5"
            IsLoading="{Binding IsLoading}"
            Message="{loc:Translate Key='Loading studio tools...'}"/>

    </Grid>

</UserControl>
