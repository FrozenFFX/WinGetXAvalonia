<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:WinGetXAvalonia.Models"
             xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d"
             d:DesignWidth="480"
             d:DesignHeight="120"
             x:Class="WinGetXAvalonia.Controls.PackageCard"
             x:DataType="models:PackageModel"
             x:CompileBindings="False">
    <!-- WinGetX - https://github.com/FrozenFFX -->

    <shared:BaseCard>

        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- ICON -->
            <Border Grid.Column="0"
                    Width="32"
                    Height="32"
                    CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}">

                <TextBlock Text="{Binding Icon}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- INFO -->
            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        Spacing="4"
                        VerticalAlignment="Center">

                <TextBlock Text="{Binding Name}"
                           FontSize="{DynamicResource FontSubtitle}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Text="{Binding Id}"
                           FontSize="{DynamicResource FontCaption}"
                           Foreground="{DynamicResource SubtextBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Text="{Binding Source}"
                           FontSize="{DynamicResource FontCaption}"
                           Foreground="{DynamicResource SubtextBrush}"
                           Opacity="0.7"/>

                <TextBlock Text="{Binding Version,
                           StringFormat=Installed {0}}"
                           FontSize="{DynamicResource FontCaption}"
                           Foreground="{DynamicResource SubtextBrush}"
                           IsVisible="{Binding Version,
                           Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                <TextBlock Text="{Binding Available,
                           StringFormat=▲ Available {0}}"
                           FontSize="{DynamicResource FontCaption}"
                           Foreground="{DynamicResource AccentBrush}"
                           IsVisible="{Binding Available,
                           Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <!-- ACTIONS -->
            <WrapPanel Grid.Column="2"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       ItemSpacing="8">

                <Button Content="Kaldır"
                        Classes="Danger"
                        Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                        CommandParameter="{Binding}"/>

                <Button Content="Güncelle"
                        Command="{Binding $parent[ItemsControl].DataContext.UpdateCommand}"
                        CommandParameter="{Binding}"/>
            </WrapPanel>

        </Grid>


    <!-- kaneki -->
    </shared:BaseCard>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open Homepage"
                      Click="OnOpenHomepage"/>
            <MenuItem Header="Copy ID"
                      Click="OnCopyId"/>
            <MenuItem Header="Copy Name"
                      Click="OnCopyName"/>
        </ContextMenu>
    </UserControl.ContextMenu>

</UserControl>
