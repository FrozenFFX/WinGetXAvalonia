<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.WingetSettingsView"
             x:DataType="vm:WingetSettingsViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="Winget"/>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="Confirmations"/>

                    <ToggleSwitch
                        OffContent="Confirm before install"
                        OnContent="Confirm before install"
                        IsChecked="{Binding ConfirmInstall}"/>

                    <ToggleSwitch
                        OffContent="Confirm before update"
                        OnContent="Confirm before update"
                        IsChecked="{Binding ConfirmUpdate}"/>

                    <ToggleSwitch
                        OffContent="Confirm before uninstall"
                        OnContent="Confirm before uninstall"
                        IsChecked="{Binding ConfirmUninstall}"/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="Refresh"/>

                    <ToggleSwitch
                        OffContent="Auto refresh package lists"
                        OnContent="Auto refresh package lists"
                        IsChecked="{Binding AutoRefreshPackages}"/>

                </StackPanel>

            </shared:AppCard>

        </StackPanel>

    </ScrollViewer>

    </Grid>

</UserControl>
