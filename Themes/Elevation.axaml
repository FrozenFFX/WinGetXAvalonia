<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BoxShadows x:Key="Elevation0">0 0 0 0 #00000000</BoxShadows>

    <BoxShadows x:Key="Elevation1">0 1 3 0 #1A000000, 0 1 2 0 #14000000</BoxShadows>

    <BoxShadows x:Key="Elevation2">0 6 18 0 #2E000000, 0 3 6 0 #1F000000</BoxShadows>

    <!-- Seçili durum glow'u — accent renkli yumuşak hale (madde 6). -->
    <BoxShadows x:Key="AccentGlow">0 0 12 0 #403B82F6, 0 2 6 0 #263B82F6</BoxShadows>

</ResourceDictionary>
