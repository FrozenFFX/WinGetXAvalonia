<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:WinGetXAvalonia.Models"
             x:Class="WinGetXAvalonia.Controls.DashboardCard"
             x:DataType="models:DashboardCardModel">
    <!-- WinGetX - https://github.com/FrozenFFX -->

    <Border Classes="card"
            Width="220"
            Margin="0,0,20,20">

        <StackPanel>

            <TextBlock
                Classes="subtitle"
                Text="{Binding Title}"/>

            <TextBlock
                Margin="0,25,0,0"
                FontSize="42"
                FontWeight="Bold"
                Text="{Binding Value}"/>

        </StackPanel>


    <!-- kaneki -->
    </Border>

</UserControl>
