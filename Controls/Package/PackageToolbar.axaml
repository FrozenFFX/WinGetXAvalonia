<UserControl
    x:Class="WinGetXAvalonia.Controls.Package.PackageToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Name="Root">

    <Border
        Margin="0,0,0,12"
        Padding="16"
        CornerRadius="{DynamicResource RadiusMedium}"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

        <Grid
            ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="10">

            <!-- Search -->

            <shared:SearchBox
                Grid.Column="0"
                MinWidth="260"
                MaxWidth="560"
                HorizontalAlignment="Stretch"
                Watermark="Search packages..."
                Text="{Binding SearchText, ElementName=Root}"/>

            <!-- Sort -->

            <ComboBox
                Grid.Column="1"
                Width="170"
                Height="42"
                VerticalAlignment="Center"
                SelectedItem="{Binding SelectedSort, ElementName=Root}"
                ItemsSource="{Binding SortItems, ElementName=Root}"/>

            <!-- Filter -->

            <ComboBox
                Grid.Column="2"
                Width="170"
                Height="42"
                VerticalAlignment="Center"
                SelectedItem="{Binding SelectedFilter, ElementName=Root}"
                ItemsSource="{Binding FilterItems, ElementName=Root}"/>

            <!-- Refresh -->

            <shared:AppButton
                Grid.Column="3"
                Width="38"
                Height="38"
                Padding="0"
                CornerRadius="8"
                VerticalAlignment="Center"
                ToolTip.Tip="Refresh (F5)"
                Command="{Binding RefreshCommand, ElementName=Root}">

                <Path
                    Width="18"
                    Height="18"
                    Data="{StaticResource IconRefresh}"
                    Fill="{DynamicResource TextBrush}"
                    Stretch="Uniform"/>
            </shared:AppButton>

            <!-- Count -->

            <Border
                Grid.Column="4"
                Padding="12,6"
                CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">

                <TextBlock
                    FontSize="{DynamicResource FontCaption}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center">
                    <Run Text="{Binding PackageCount, ElementName=Root}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CountLabel, ElementName=Root}"/>

                </TextBlock>

            </Border>

            <!-- Action -->

            <shared:AppButton
                Grid.Column="5"
                Classes="Accent"
                MinWidth="120"
                Height="38"
                VerticalAlignment="Center"
                IsVisible="{Binding ActionCommand,
                ElementName=Root,
                Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                IsEnabled="{Binding PackageCount,
                ElementName=Root,
                Converter={StaticResource PositiveToBoolConverter}}"
                Content="{Binding ActionText, ElementName=Root}"
                Command="{Binding ActionCommand, ElementName=Root}"/>

        </Grid>

    </Border>

</UserControl>