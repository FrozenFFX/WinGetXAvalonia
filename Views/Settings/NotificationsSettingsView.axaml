<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.NotificationsSettingsView"
             x:DataType="vm:NotificationsSettingsViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="Notifications"/>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="Alerts"/>

                    <ToggleSwitch
                        OffContent="Toast notifications"
                        OnContent="Toast notifications"
                        IsChecked="{Binding ToastNotifications}"/>

                    <ToggleSwitch
                        OffContent="Sound notifications"
                        OnContent="Sound notifications"
                        IsChecked="{Binding SoundNotifications}"/>

                </StackPanel>

            </shared:AppCard>

        </StackPanel>

    </ScrollViewer>

    </Grid>

</UserControl>
