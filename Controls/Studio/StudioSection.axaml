<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Controls.Studio.StudioSection"
    x:Name="Root">

    <Border
        Padding="20"
        CornerRadius="{DynamicResource RadiusLarge}"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

        <StackPanel Spacing="16">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                <Border
                    Width="40"
                    Height="40"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Background="{DynamicResource StudioAccentSoftBrush}"
                    VerticalAlignment="Center">

                    <Path
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{Binding HeaderIcon, ElementName=Root, Converter={StaticResource IconGeometry}}"
                        Fill="{DynamicResource StudioAccentBrush}"
                        Stretch="Uniform"/>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Spacing="2"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="{Binding Title, ElementName=Root}"
                        FontSize="{DynamicResource FontSubtitle}"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="{Binding Description, ElementName=Root}"
                        FontSize="{DynamicResource FontCaption}"
                        Foreground="{DynamicResource SubtextBrush}"
                        TextWrapping="Wrap"
                        IsVisible="{Binding Description, ElementName=Root,
                            Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <shared:AppButton
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="{Binding ActionText, ElementName=Root}"
                    Command="{Binding ActionCommand, ElementName=Root}"
                    IsVisible="{Binding ActionText, ElementName=Root,
                        Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            </Grid>

            <shared:AppSeparator/>

            <ContentPresenter Content="{Binding Content, ElementName=Root}"/>
        </StackPanel>
    </Border>

</UserControl>
