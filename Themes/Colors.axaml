<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#3E8EF7"/>

        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>

        <SolidColorBrush x:Key="WarningBrush" Color="#FFB300"/>

        <SolidColorBrush x:Key="DangerBrush" Color="#F44336"/>

        <SolidColorBrush x:Key="InfoBrush" Color="#2196F3"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>

    </Styles.Resources>

</Styles>
