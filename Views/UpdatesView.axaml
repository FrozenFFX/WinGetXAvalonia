<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:package="using:WinGetXAvalonia.Controls.Package"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Views.UpdatesView"
    x:Name="Root"
    x:DataType="vm:UpdatesViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Gesture="Ctrl+U" Command="{Binding UpgradeAllCommand}"/>
    </UserControl.KeyBindings>

    <Grid
        Margin="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <shared:SectionHeader
            Grid.Row="0"
            Title="{loc:Translate Key=&quot;Updates&quot;}"
            Description="{loc:Translate Key=&quot;Manage available package updates.&quot;}"
            ActionText="{loc:Translate Key=&quot;Refresh&quot;}"
            ActionCommand="{Binding RefreshCommand}"/>

        <!-- Toolbar + Bulk Actions -->
        <Grid
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            RowDefinitions="Auto,Auto,Auto">

            <package:PackageToolbar
                Grid.Row="0"
                SearchText="{Binding SearchText}"
                PackageCount="{Binding PackageCount}"
                RefreshCommand="{Binding RefreshCommand}"
                SelectedSort="{Binding SelectedSort}"
                SelectedFilter="{Binding SelectedFilter}"
                CountLabel="Updates"
                ActionText="{loc:Translate Key=&quot;Update All&quot;}"
                ActionCommand="{Binding UpgradeAllCommand}"/>

            <Border
                Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12,8"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                IsVisible="{Binding SelectedCount,
                Converter={StaticResource PositiveToBoolConverter}}">

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                    <TextBlock
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Text="{Binding SelectedCount,
                        StringFormat={}{0} selected}"/>

                    <shared:AppButton
                        Grid.Column="2"
                        Classes="ghost"
                        MinWidth="110"
                        Content="{loc:Translate Key=&quot;Deselect All&quot;}"
                        Command="{Binding DeselectAllCommand}"/>

                    <shared:AppButton
                        Grid.Column="3"
                        Classes="Accent"
                        MinWidth="150"
                        Content="{Binding SelectedCount,
                        StringFormat=Update Selected ({0})}"
                        Command="{Binding UpdateSelectedCommand}"/>
                </Grid>

            </Border>

            <!-- Bulk update status / progress -->
            <Border
                Grid.Row="2"
                Margin="0,12,0,0"
                Padding="14,10"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                IsVisible="{Binding HasBulkStatus}">

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                    <ProgressBar
                        Grid.Column="0"
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        IsVisible="{Binding IsBulkUpdating}"/>

                    <TextBlock
                        Grid.Column="1"
                        FontSize="{DynamicResource FontCaption}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Text="{loc:TranslateBinding Path=BulkUpdateStatus}"/>

                    <shared:AppButton
                        Grid.Column="3"
                        Classes="ghost"
                        MinWidth="110"
                        Content="{loc:Translate Key=&quot;Cancel&quot;}"
                        IsVisible="{Binding IsBulkUpdating}"
                        Command="{Binding CancelBulkCommand}"/>

                </Grid>

            </Border>

        </Grid>

        <!-- Master-Detail -->
        <shared:MasterDetailPage
            Grid.Row="3"
            IsLoading="{Binding IsLoading}"
            LoadingMessage="{loc:Translate Key=&quot;Checking for package updates...&quot;}"
            DetailWidth="{Binding SelectedPackage,
            Converter={StaticResource DetailWidthConverter}}">

            <shared:MasterDetailPage.MasterContent>

                <Grid>

                    <ListBox
                        ItemsSource="{Binding Updates}"
                        SelectedItem="{Binding SelectedPackage}"
                        BorderThickness="0"
                        Background="Transparent"
                        ScrollViewer.IsDeferredScrollingEnabled="True">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel CacheLength="0.5"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:PackageCard Mode="Updates"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Empty state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding IsEmpty}"
                        Icon="update"
                        Title="{loc:Translate Key=&quot;No updates available&quot;}"
                        Description="{loc:Translate Key=&quot;All packages are up to date.&quot;}"/>

                    <!-- Error state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding HasError}"
                        Icon="warning"
                        Title="{loc:Translate Key=&quot;Couldn&apos;t load updates&quot;}"
                        Description="{loc:TranslateBinding Path=ErrorMessage}"
                        ActionText="{loc:Translate Key=&quot;Retry&quot;}"
                        ActionCommand="{Binding RefreshCommand}"/>

                </Grid>

            </shared:MasterDetailPage.MasterContent>

            <shared:MasterDetailPage.DetailContent>

                <package:PackageDetailsPanel
                    DataContext="{Binding Details}"/>

            </shared:MasterDetailPage.DetailContent>

        </shared:MasterDetailPage>

    </Grid>

</UserControl>
