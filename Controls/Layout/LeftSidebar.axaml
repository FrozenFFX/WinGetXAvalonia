<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:models="using:WinGetXAvalonia.Models"
    x:Class="WinGetXAvalonia.Controls.Layout.LeftSidebar"
    x:DataType="vm:MainViewModel">

    <Border
        Padding="10,0"
        Background="{DynamicResource SidebarBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,1,0">

        <Grid RowDefinitions="*,Auto">

            <ListBox
                Grid.Row="0"
                Classes="sidebar"
                Margin="0,10,0,4"
                Padding="0,2,2,2"
                BorderThickness="0"
                Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ItemsSource="{Binding VisibleMenu}"
                SelectedItem="{Binding SelectedMenuItem}">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:NavigationItem">

                        <Border
                            Classes="sidebar-item"
                            Classes.header="{Binding IsCategoryHeader, Converter={StaticResource BoolToClassConverter}, ConverterParameter=header}"
                            PointerPressed="OnHeaderPointerPressed">

                            <Grid>

                            <!-- Sayfa öğesi: ikon + etiket + rozet -->
                            <Grid
                                IsVisible="{Binding !IsCategoryHeader}"
                                ColumnDefinitions="32,2,*,Auto"
                                VerticalAlignment="Center">

                                <Path
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                    Fill="{DynamicResource SubtextBrush}"
                                    Stretch="Uniform"/>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{loc:TranslateBinding Path=Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"/>

                                <Border
                                    Grid.Column="3"
                                    MinWidth="20"
                                    Height="20"
                                    Padding="6,2"
                                    CornerRadius="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    IsVisible="{Binding BadgeCount, Converter={StaticResource PositiveToBoolConverter}}">

                                    <TextBlock
                                        FontSize="{DynamicResource FontTiny}"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        Text="{loc:TranslateBinding Path=BadgeCount}"/>

                                </Border>

                            </Grid>

                            <!-- Kategori başlığı: etiket + chevron -->
                            <Grid
                                IsVisible="{Binding IsCategoryHeader}"
                                ColumnDefinitions="*,Auto"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="{loc:TranslateBinding Path=Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"/>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">

                                    <Path
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding !IsExpanded}"
                                        Data="{StaticResource IconChevronRight}"
                                        Fill="{DynamicResource MutedTextBrush}"
                                        Stretch="Uniform"/>

                                    <Path
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsExpanded}"
                                        Data="{StaticResource IconChevronDown}"
                                        Fill="{DynamicResource MutedTextBrush}"
                                        Stretch="Uniform"/>

                                </StackPanel>

                            </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <!-- Footer -->
            <Border
                Grid.Row="1"
                Margin="4,0,4,6"
                Padding="0,10,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">

                <shared:AppSidebarSection Title="{loc:Translate Key=&quot;Version&quot;}">

                    <TextBlock
                        FontSize="{DynamicResource FontButton}"
                        FontWeight="SemiBold"
                        Text="{loc:TranslateBinding Path=Version}"/>

                </shared:AppSidebarSection>

            </Border>

        </Grid>

    </Border>

</UserControl>