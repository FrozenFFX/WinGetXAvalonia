<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinGetXAvalonia.ViewModels"
             xmlns:models="using:WinGetXAvalonia.Models.Operations"
             xmlns:operation="using:WinGetXAvalonia.Controls.Operation"
             xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             x:Class="WinGetXAvalonia.Controls.Operation.OperationDrawer"
             x:DataType="vm:OperationDrawerViewModel">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0">

        <Grid RowDefinitions="Auto,*,Auto">

            <shared:SectionHeader
                Margin="16,16,16,0"
                Title="Operations"
                Description="{Binding Summary}"/>

            <ListBox Grid.Row="1"
                     Margin="12,12,12,0"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemsSource="{Binding Operations}">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:OperationModel">
                        <operation:OperationCard/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <Button Grid.Row="2"
                    Margin="12"
                    Content="Clear Completed"
                    Command="{Binding ClearCompletedCommand}"/>

        </Grid>

    </Border>

</UserControl>
