<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WinGetXAvalonia.Converters"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <conv:ZeroToBoolConverter x:Key="ZeroToBoolConverter"/>

    <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>

    <conv:PositiveToBoolConverter x:Key="PositiveToBoolConverter"/>

    <conv:BoolToSizeConverter x:Key="BoolToSizeConverter"/>

    <conv:BoolToClassConverter x:Key="BoolToClassConverter"/>

    <conv:BoolToExpanderGlyphConverter x:Key="ExpanderGlyphConverter"/>

    <conv:BoolToBrushConverter x:Key="BoolToBrushConverter"/>

    <conv:NotificationTypeToIconConverter x:Key="NotificationTypeToIcon"/>

    <conv:StatusToBrushConverter x:Key="StatusToBrush"/>

    <conv:PackageCardModeToBoolConverter x:Key="IsDefaultCardMode" Match="Default"/>

    <conv:PackageCardModeToBoolConverter x:Key="IsUpdatesCardMode" Match="Updates"/>

    <conv:IconGeometryConverter x:Key="IconGeometry"/>

    <conv:ObjectToDetailWidthConverter x:Key="DetailWidthConverter"/>

    <conv:BooleanToDetailWidthConverter x:Key="DetailColumnWidthConverter"/>

    <conv:BooleanToOperationsWidthConverter x:Key="OperationsColumnWidthConverter"/>

    <conv:BooleanToSystemPanelWidthConverter x:Key="SystemPanelWidthConverter"/>

    <sys:String x:Key="DisplaySecurity">Security</sys:String>
    <sys:String x:Key="DisplayWarning">Warnings</sys:String>
    <sys:String x:Key="DisplayError">Blocked</sys:String>
    <sys:String x:Key="DisplaySuccess">Verified</sys:String>

    </ResourceDictionary>
