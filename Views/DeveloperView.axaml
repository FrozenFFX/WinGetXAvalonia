<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.DeveloperView"
    x:DataType="vm:DeveloperViewModel">

    <Grid>

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="25" Spacing="16">

                <StackPanel Spacing="4">

                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="Developer"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="Developer tools and diagnostics."/>

                </StackPanel>

                <StackPanel Spacing="16">

                    <shared:SectionHeader Title="Queue"/>

                    <Border Classes="card" Padding="16">

                        <Grid ColumnDefinitions="*,*,*,*">

                            <StackPanel Spacing="4">
                                <TextBlock Opacity="0.6" Text="Running"/>
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="{Binding Queue.RunningCount}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Opacity="0.6" Text="Completed"/>
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="{Binding Queue.CompletedCount}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Opacity="0.6" Text="Failed"/>
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="{Binding Queue.FailedCount}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Opacity="0.6" Text="Cancelled"/>
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="{Binding Queue.CancelledCount}"/>
                            </StackPanel>

                        </Grid>

                    </Border>

                    <shared:SectionHeader Title="Performance"/>

                    <Border Classes="card" Padding="16">

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="10">

                            <TextBlock Opacity="0.6" Text="Memory"/>
                            <TextBlock Grid.Column="1" Text="{Binding Snapshot.Memory}"/>

                            <TextBlock Grid.Row="1" Opacity="0.6" Text="Threads"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Snapshot.Threads}"/>

                            <TextBlock Grid.Row="2" Opacity="0.6" Text="Handles"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Snapshot.Handles}"/>

                            <TextBlock Grid.Row="3" Opacity="0.6" Text="CPU Time"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Snapshot.CpuTime}"/>

                        </Grid>

                    </Border>

                    <shared:SectionHeader Title="Live Operations"/>

                    <controls:QueuePanel
                        Margin="0,8,0,0"
                        DataContext="{Binding Queue}"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

        <shared:LoadingOverlay
            IsLoading="{Binding IsLoading}"
            Message="Loading developer tools..."/>

    </Grid>

</UserControl>
