<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:models="using:WinGetXAvalonia.Models.Operations"
             x:Class="WinGetXAvalonia.Controls.Operation.OperationCard"
             x:DataType="models:OperationModel">

    <Border Margin="0,0,0,10"
            Padding="12"
            Background="{DynamicResource Card}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMedium}">

        <StackPanel Spacing="6">

            <Grid ColumnDefinitions="*,Auto">

                <TextBlock FontWeight="SemiBold"
                           Text="{loc:TranslateBinding Path=Title}" />

                <TextBlock Grid.Column="1"
                           FontSize="{DynamicResource FontMicro}"
                           Opacity="0.6"
                           Text="{Binding Duration, StringFormat={}{0:c}}" />

            </Grid>

            <TextBlock FontSize="{DynamicResource FontSecondary}"
                       Opacity="0.7"
                       Text="{loc:TranslateBinding Path=Subtitle}" />

            <Grid Margin="0,2,0,0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

                <ProgressBar Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Progress}" />

                <TextBlock Grid.Column="1"
                           FontSize="{DynamicResource FontSecondary}"
                           FontWeight="SemiBold"
                           Text="{Binding Progress, StringFormat={}{0:0}%}" />

            </Grid>

            <TextBlock FontSize="{DynamicResource FontSecondary}"
                       Opacity="0.75"
                       Text="{loc:TranslateBinding Path=StatusMessage}" />

            <Grid Margin="0,6,0,0"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">

                <shared:AppButton Grid.Column="1"
                        Content="{loc:Translate Key=&quot;Retry&quot;}"
                        Command="{Binding RetryCommand}"
                        IsVisible="{Binding CanRetry}"/>

                <shared:AppButton Grid.Column="2"
                        Classes="Danger"
                        Content="{loc:Translate Key=&quot;Cancel&quot;}"
                        Command="{Binding CancelCommand}"/>

            </Grid>

        </StackPanel>

    </Border>

</UserControl>
