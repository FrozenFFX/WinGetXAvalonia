<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    x:Class="WinGetXAvalonia.Views.BlueprintsView"
    x:DataType="vm:BlueprintsViewModel">

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="{loc:Translate Key=&quot;Blueprints&quot;}"
            Description="{loc:Translate Key=&quot;Reusable installation templates with step-by-step actions.&quot;}"/>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="280,10,*">

            <!-- Sol: liste paneli -->

            <shared:AppToolbar
                Grid.Column="0">

                <Grid RowDefinitions="Auto,12,Auto,12,*">

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                        <shared:AppButton
                            Grid.Column="0"
                            Classes="Accent"
                            HorizontalAlignment="Stretch"
                            Content="{loc:Translate Key=&quot;New Blueprint&quot;}"
                            Command="{Binding NewCommand}"/>

                        <shared:AppButton
                            Grid.Column="1"
                            Content="{loc:Translate Key=&quot;Import&quot;}"
                            Command="{Binding ImportCommand}"/>

                        <shared:AppButton
                            Grid.Column="2"
                            Content="{loc:Translate Key=&quot;Export&quot;}"
                            Command="{Binding ExportCommand}"/>

                    </Grid>

                    <shared:SearchBox
                        Grid.Row="2"
                        Watermark="{loc:Translate Key=&quot;Search blueprints...&quot;}"
                        Text="{Binding SearchText}"/>

                    <Grid Grid.Row="4">

                        <ListBox
                            ItemsSource="{Binding FilteredBlueprints}"
                            SelectedItem="{Binding SelectedBlueprint}"
                            BorderThickness="0"
                            Background="Transparent"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>

                                <DataTemplate x:DataType="models:BlueprintModel">

                                    <Border
                                        Padding="10,8"
                                        CornerRadius="10">

                                        <StackPanel Spacing="2">

                                            <TextBlock
                                                Text="{loc:TranslateBinding Path=Name}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"/>

                                            <TextBlock
                                                Text="{loc:TranslateBinding Path=Description}"
                                                FontSize="{DynamicResource FontSecondary}"
                                                Opacity="0.6"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"
                                                IsVisible="{Binding Description,
                                                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                        <shared:AppEmptyState
                            IsVisible="{Binding HasNoItems}"
                            Icon="📜"
                            Title="{loc:Translate Key=&quot;No blueprints&quot;}"
                            Description="{loc:Translate Key=&quot;Create your first blueprint to get started.&quot;}"
                            ActionText="{loc:Translate Key=&quot;New Blueprint&quot;}"
                            ActionCommand="{Binding NewCommand}">

                            <shared:AppEmptyState.Examples>
                                <sys:String>Recreate your setup on a new PC</sys:String>
                                <sys:String>Share a standard dev environment</sys:String>
                                <sys:String>Reinstall apps after a format</sys:String>
                            </shared:AppEmptyState.Examples>

                        </shared:AppEmptyState>

                    </Grid>

                </Grid>

            </shared:AppToolbar>

            <!-- Ayırıcı -->

            <GridSplitter
                Grid.Column="1"
                Width="4"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"/>

            <!-- Sağ: editör -->

            <Border
                Grid.Column="2"
                Classes="card"
                Padding="20"
                ClipToBounds="True">

                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Spacing="14">

                        <StackPanel Spacing="4">

                            <TextBlock
                                FontSize="{DynamicResource FontSection}"
                                FontWeight="SemiBold"
                                Text="{loc:TranslateBinding Path=EditorTitle}"/>

                            <TextBlock
                                Opacity="0.65"
                                Text="{loc:TranslateBinding Path=EditorDescription}"/>

                        </StackPanel>

                        <StackPanel Spacing="6">

                            <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Name&quot;}"/>

                            <TextBox
                                PlaceholderText="{loc:Translate Key=&quot;Blueprint name&quot;}"
                                Text="{Binding Name}"/>

                        </StackPanel>

                        <StackPanel Spacing="6">

                            <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Description&quot;}"/>

                            <TextBox
                                AcceptsReturn="True"
                                MinHeight="90"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                PlaceholderText="{loc:Translate Key=&quot;What does this blueprint do?&quot;}"
                                Text="{Binding Description}"/>

                        </StackPanel>

                        <StackPanel Spacing="6">

                            <TextBlock FontSize="{DynamicResource FontSecondary}" Opacity="0.7" Text="{loc:Translate Key=&quot;Steps&quot;}"/>

                            <TextBox
                                AcceptsReturn="True"
                                MinHeight="140"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                PlaceholderText="{loc:Translate Key=&quot;One action per line — e.g. install 7zip.7zip&quot;}"
                                Text="{Binding Steps}"/>

                        </StackPanel>

                        <shared:AppSeparator/>

                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">

                            <shared:AppButton
                                Classes="Accent"
                                MinWidth="120"
                                Content="{loc:Translate Key=&quot;Save&quot;}"
                                Command="{Binding SaveCommand}"/>

                            <shared:AppButton
                                Grid.Column="1"
                                Classes="Danger"
                                MinWidth="110"
                                Content="{loc:Translate Key=&quot;Delete&quot;}"
                                Command="{Binding DeleteCommand}"
                                IsVisible="{Binding IsEditing}"/>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>
