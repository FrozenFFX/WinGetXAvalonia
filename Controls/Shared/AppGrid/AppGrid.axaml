<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinGetXAvalonia.Controls.Shared.AppGrid"
    x:Name="Root">

    <UniformGrid
        Columns="2"
        DataContext="{Binding #Root}">

        <ContentPresenter
            Content="{loc:TranslateBinding Path=Content}"
            ContentTemplate="{Binding #Root.ContentTemplate}"/>

    </UniformGrid>

</UserControl>
