<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BoxShadows x:Key="Elevation0">0 0 0 0 #00000000</BoxShadows>

    <BoxShadows x:Key="Elevation1">0 1 3 0 #14000000, 0 1 2 0 #0D000000</BoxShadows>

    <BoxShadows x:Key="Elevation2">0 4 12 0 #1F000000, 0 2 4 0 #14000000</BoxShadows>

    <BoxShadows x:Key="Elevation3">0 8 24 0 #29000000, 0 4 8 0 #1A000000</BoxShadows>

    <BoxShadows x:Key="AccentGlow">0 0 12 0 #403B82F6, 0 2 6 0 #263B82F6</BoxShadows>

</ResourceDictionary>
