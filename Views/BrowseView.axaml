<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinGetXAvalonia.ViewModels"
             xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:package="using:WinGetXAvalonia.Controls.Package"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="WinGetXAvalonia.Views.BrowseView"
             x:DataType="vm:BrowseViewModel"
             x:CompileBindings="False">

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True"
          ColumnDefinitions="65*,12,35*">

        <!-- sol taraf: featured, kategoriler, arama, sonuçlar -->
        <Grid Grid.Column="0"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">

            <shared:SectionHeader
                Title="Featured"
                Description="Hand-picked by the community"/>

            <ListBox
                Grid.Row="1"
                Margin="0,4,0,0"
                Height="170"
                ItemsSource="{Binding Featured}"
                SelectedItem="{Binding SelectedPackage}"
                BorderThickness="0"
                Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <package:BrowseCard Width="380"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <shared:SectionHeader
                Grid.Row="2"
                Margin="0,20,0,0"
                Title="Categories"
                Description="Browse by topic"/>

<ItemsControl
    Grid.Row="3"
    Margin="0,8,0,0"
    ItemsSource="{Binding Categories}">

    <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
            <WrapPanel HorizontalAlignment="Left"/>
        </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
        <DataTemplate>
            <shared:AppButton
                Margin="0,0,8,8"
                HorizontalContentAlignment="Center"
                Command="{Binding $parent[ItemsControl].DataContext.SelectCategoryCommand}"
                CommandParameter="{Binding}">

                <StackPanel Orientation="Horizontal" Spacing="8">

                    <Path
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                        Fill="{DynamicResource AccentBrush}"
                        Stretch="Uniform"/>

                    <TextBlock
                        FontSize="{DynamicResource FontButton}"
                        VerticalAlignment="Center"
                        Text="{Binding Name}"/>
                </StackPanel>
            </shared:AppButton>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl>

            <shared:SectionHeader
                Grid.Row="4"
                Margin="0,20,0,0"
                Title="Search"
                Description="Find packages to install"/>

            <Grid
                Grid.Row="5"
                Margin="0,8,0,0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">

                <AutoCompleteBox
                    ItemsSource="{Binding Suggestions}"
                    Text="{Binding SearchText, Mode=TwoWay}"
                    SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                    FilterMode="None"
                    MinimumPrefixLength="2"
                    PlaceholderText="Search packages...">

                    <AutoCompleteBox.KeyBindings>
                        <KeyBinding
                            Gesture="Enter"
                            Command="{Binding SearchCommand}"/>
                    </AutoCompleteBox.KeyBindings>
                </AutoCompleteBox>

                <shared:AppButton
                    Grid.Column="1"
                    MinWidth="110"
                    Content="Search"
                    Command="{Binding SearchCommand}"/>
            </Grid>

            <shared:SectionHeader
                Grid.Row="6"
                Margin="0,20,0,0"
                Title="Results"
                Description="{Binding ResultsSummary}"/>

            <Grid Grid.Row="7" Margin="0,4,0,0">

                <ListBox
                    ItemsSource="{Binding Results}"
                    SelectedItem="{Binding SelectedPackage}"
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.IsDeferredScrollingEnabled="True"
                    shared:ScrollToTopBehavior.ScrollToTopOnReset="True">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel CacheLength="0.5"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <package:BrowseCard/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

                <shared:LoadingOverlay
                    IsLoading="{Binding IsLoading}"
                    Message="Searching packages..."/>

                <!-- Başlangıç durumu: henüz arama yapılmadı -->
                <shared:AppEmptyState
                    IsVisible="{Binding IsInitial}"
                    Icon="search"
                    Title="Search to find packages"
                    Description="Search by name, or pick a category to get started.">

                    <shared:AppEmptyState.Examples>
                        <sys:String>Find and install apps in one click</sys:String>
                        <sys:String>Categories help you discover new tools</sys:String>
                        <sys:String>Results are enriched with update status</sys:String>
                    </shared:AppEmptyState.Examples>

                </shared:AppEmptyState>

                <!-- Empty state -->
                <shared:AppEmptyState
                    IsVisible="{Binding IsEmpty}"
                    Icon="search"
                    Title="{Binding EmptySearchTitle}"
                    Description="{Binding EmptySearchDescription}"
                    ActionText="Clear Search"
                    ActionCommand="{Binding ClearSearchCommand}">

                    <shared:AppEmptyState.Examples>
                        <sys:String>Check the spelling of the package name</sys:String>
                        <sys:String>Try a shorter or more common name</sys:String>
                        <sys:String>Browse a category instead</sys:String>
                    </shared:AppEmptyState.Examples>

                </shared:AppEmptyState>

                <!-- Error state -->
                <shared:AppEmptyState
                    IsVisible="{Binding HasError}"
                    Icon="warning"
                    Title="Unable to load packages"
                    Description="{Binding ErrorMessage}"
                    ActionText="Retry"
                    ActionCommand="{Binding SearchCommand}"/>

            </Grid>

        </Grid>

        <GridSplitter
            Grid.Column="1"
            Width="6"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"/>

        <!-- sağ tarafta seçilen paketin detay paneli -->
        <Border
            Grid.Column="2"
            Margin="16,0,0,0"
            VerticalAlignment="Stretch"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusLarge}">

            <Grid>

            <!-- Boş durum: hiç paket seçilmedi -->
            <StackPanel
                IsVisible="{Binding SelectedDetails.SelectedPackage,
                Converter={x:Static conv:ObjectConverters.IsNull}}"
                MaxWidth="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">

                <shared:AppEmptyState
                    Icon="package"
                    Title="Select a package to view details."
                    Description="Choose a package from the catalog or try one of these categories."/>

                <ItemsControl
                    ItemsSource="{Binding Categories}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel
                                HorizontalAlignment="Center"
                                ItemSpacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <shared:AppButton
                                Height="34"
                                Padding="14,0"
                                HorizontalContentAlignment="Center"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectCategoryCommand}"
                                CommandParameter="{Binding}">

<StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Width="14" Height="14"
                                      VerticalAlignment="Center"
                                      Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                      Fill="{DynamicResource AccentBrush}"
                                      Stretch="Uniform"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                            </shared:AppButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

            <!-- Detay içeriği -->
            <ScrollViewer
                IsVisible="{Binding SelectedDetails.SelectedPackage,
                Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                VerticalScrollBarVisibility="Auto">

                <Border Padding="20">

                    <package:PackageDetailsPanel
                        DataContext="{Binding SelectedDetails}"/>

                </Border>

            </ScrollViewer>

            <Border
                IsVisible="{Binding SelectedDetails.SelectedPackage.IsBusy}"
                 Background="{DynamicResource ScrimBrush}"/>

            <shared:LoadingOverlay
                IsLoading="{Binding SelectedDetails.IsLoading}"
                Message="Loading package details..."/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
