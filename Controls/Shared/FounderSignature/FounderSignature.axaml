<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinGetXAvalonia.Controls.Shared.FounderSignature">

    <TextBlock
        x:Name="SignatureText"
        FontFamily="{DynamicResource FontPrimary}"
        FontSize="{DynamicResource FontCaption}"
        FontWeight="Medium"
        LetterSpacing="2"
        Foreground="{DynamicResource AccentBrush}"
        Opacity="0.15"
        Text="{loc:Translate Key=&quot;Görkem Yıldız&quot;}">

        <TextBlock.Transitions>
            <Transitions>
                <DoubleTransition
                    Property="Opacity"
                    Duration="0:0:0.160"/>
            </Transitions>
        </TextBlock.Transitions>

    </TextBlock>

</UserControl>