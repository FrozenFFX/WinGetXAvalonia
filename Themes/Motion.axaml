<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.card">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource Elevation1}"/>
        <Setter Property="RenderTransformOrigin" Value="50%,100%"/>
        <Setter Property="RenderTransform">
            <TranslateTransform X="0" Y="0"/>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="{DynamicResource MotionDurationFast}"
                                               Easing="{DynamicResource MotionEasingOut}"/>
                <BrushTransition Property="Background"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <BrushTransition Property="BorderBrush"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <BoxShadowsTransition Property="BoxShadow"
                                      Duration="{DynamicResource MotionDurationFast}"
                                      Easing="{DynamicResource MotionEasingOut}"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.card:pointerover">
        <Setter Property="RenderTransform">
            <TranslateTransform X="0" Y="-2"/>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource Elevation2}"/>
    </Style>

    <Style Selector="Border.card:pressed">
        <Setter Property="RenderTransform">
            <TranslateTransform X="0" Y="0"/>
        </Setter>
        <Setter Property="Opacity" Value="0.92"/>
    </Style>

    <Style Selector="Border.card:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <BrushTransition Property="BorderBrush"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <BoxShadowsTransition Property="BoxShadow"
                                      Duration="{DynamicResource MotionDurationFast}"
                                      Easing="{DynamicResource MotionEasingOut}"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.panel.interactive">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="50%,100%"/>
        <Setter Property="RenderTransform">
            <TranslateTransform X="0" Y="0"/>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <BrushTransition Property="BorderBrush"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <BoxShadowsTransition Property="BoxShadow"
                                      Duration="{DynamicResource MotionDurationFast}"
                                      Easing="{DynamicResource MotionEasingOut}"/>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="{DynamicResource MotionDurationFast}"
                                               Easing="{DynamicResource MotionEasingOut}"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.panel.interactive:pointerover">
        <Setter Property="RenderTransform">
            <TranslateTransform X="0" Y="-2"/>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource Elevation2}"/>
    </Style>

    <Style Selector="Border.panel.interactive:pressed">
        <Setter Property="RenderTransform">
            <TranslateTransform X="0" Y="0"/>
        </Setter>
        <Setter Property="Opacity" Value="0.92"/>
    </Style>

    <Style Selector="Border.panel.interactive:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <BrushTransition Property="BorderBrush"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <DoubleTransition Property="Opacity"
                                  Duration="{DynamicResource MotionDurationFast}"
                                  Easing="{DynamicResource MotionEasingOut}"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <BrushTransition Property="Background"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <BrushTransition Property="BorderBrush"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
            </Transitions>
        </Setter>
    </Style>

</Styles>
