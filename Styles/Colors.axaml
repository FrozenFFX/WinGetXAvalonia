<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base -->
    <Color x:Key="Color.Background">#FF1B1D23</Color>
    <Color x:Key="Color.Surface">#FF2A2E39</Color>
    <Color x:Key="Color.Card">#FF2F3440</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#B3FFFFFF</Color>

    <!-- Accent -->
    <Color x:Key="Color.Accent">#FF4F8CFF</Color>

    <!-- Status -->
    <Color x:Key="Color.Success">#FF16C47F</Color>
    <Color x:Key="Color.Warning">#FFF5A524</Color>
    <Color x:Key="Color.Error">#FFE5484D</Color>

</ResourceDictionary>
