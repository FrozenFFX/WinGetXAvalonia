<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinGetXAvalonia.Controls.TopBar"
    x:CompileBindings="False">

    <Grid Height="60">

        <TextBlock
            Margin="20"
            FontSize="32"
            FontWeight="Bold"
            Text="{Binding Title}"/>

    </Grid>

</UserControl>
