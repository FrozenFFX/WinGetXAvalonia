<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Workspace.WorkspaceCard"
    x:DataType="models:WorkspaceModel"
    x:CompileBindings="False">

    <shared:BaseCard>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">

            <Grid ColumnDefinitions="Auto,*">

                <Border
                    Width="44"
                    Height="44"
                    CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}">

                    <TextBlock
                        FontSize="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding Icon}"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">

                    <TextBlock
                        FontWeight="SemiBold"
                        FontSize="{DynamicResource FontSubtitle}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="{Binding Description}"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="2"/>
                </StackPanel>
            </Grid>

            <WrapPanel Grid.Row="1" ItemSpacing="8">

                <Border
                    Padding="8,3"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="20">

                    <TextBlock Text="{Binding PackageCount, StringFormat='📦 {0} Packages'}"/>
                </Border>

                <Border
                    Padding="8,3"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="20">

                    <TextBlock Text="{Binding Modified, StringFormat='🕒 {0:g}'}"/>
                </Border>
            </WrapPanel>

            <UniformGrid Grid.Row="2" Columns="2" Rows="1" ColumnSpacing="8">

                <Button
                    Content="Open"
                    Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}"
                    CommandParameter="{Binding}"/>

                <Button
                    Content="Edit"
                    Command="{Binding $parent[ItemsControl].DataContext.EditCommand}"
                    CommandParameter="{Binding}"/>
            </UniformGrid>

            <UniformGrid Grid.Row="3" Columns="2" Rows="1" ColumnSpacing="8">

                <Button
                    Content="Export"
                    Command="{Binding $parent[ItemsControl].DataContext.ExportCommand}"
                    CommandParameter="{Binding}"/>

                <Button
                    Classes="Danger"
                    Content="Delete"
                    Command="{Binding $parent[ItemsControl].DataContext.DeleteWorkspaceCommand}"
                    CommandParameter="{Binding}"/>
            </UniformGrid>
        </Grid>
    </shared:BaseCard>

</UserControl>
