<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.AboutSettingsView"
             x:DataType="vm:AboutSettingsViewModel">

    <ScrollViewer>

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="About"/>

            <Border Classes="card">

                <StackPanel Spacing="16">

                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Text="{Binding AppName}"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="{Binding Version, StringFormat='Version {0}'}"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="{Binding Description}"/>

                </StackPanel>

            </Border>

            <Border Classes="card">

                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="Runtime"/>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text=".NET"/>
                        <TextBlock Grid.Column="1" Text="{Binding DotNet}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="Avalonia"/>
                        <TextBlock Grid.Column="1" Text="{Binding Avalonia}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="Winget"/>
                        <TextBlock Grid.Column="1" Text="{Binding WingetVersion}"/>
                    </Grid>

                </StackPanel>

            </Border>

            <Border Classes="card">

                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="Build Information"/>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="Commit"/>
                        <TextBlock Grid.Column="1"
                                   FontFamily="Consolas"
                                   Text="{Binding Commit}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="Architecture"/>
                        <TextBlock Grid.Column="1" Text="{Binding Architecture}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="OS"/>
                        <TextBlock Grid.Column="1" Text="{Binding OS}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="Configuration"/>
                        <TextBlock Grid.Column="1" Text="{Binding Configuration}"/>
                    </Grid>

                </StackPanel>

            </Border>

            <Border Classes="card">

                <StackPanel Spacing="10">

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="Links"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="Resources"/>

                    <Button
                        Content="GitHub"
                        HorizontalAlignment="Stretch"
                        Command="{Binding OpenGitHubCommand}"/>

                    <Button
                        Content="Report Issue"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"/>

                    <Button
                        Content="License"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
