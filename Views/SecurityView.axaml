<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.SecurityView"
    x:DataType="vm:SecurityViewModel">

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="{loc:Translate Key=&quot;Security&quot;}"
            Description="{loc:Translate Key=&quot;Security status and package verification.&quot;}"/>

        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Spacing="14">

                <UniformGrid Columns="4" Margin="0,0,0,4">

                    <shared:AppCard>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSection}" Text="{DynamicResource DisplaySecurity}"/>
                            <TextBlock FontWeight="SemiBold" Text="{loc:Translate Key=&quot;Trusted&quot;}"/>
                            <TextBlock FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" Text="{loc:TranslateBinding Path=Trusted}"/>
                        </StackPanel>
                    </shared:AppCard>

                    <shared:AppCard>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSection}" Text="{DynamicResource DisplayWarning}"/>
                            <TextBlock FontWeight="SemiBold" Text="{loc:Translate Key=&quot;Warnings&quot;}"/>
                            <TextBlock FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" Text="{loc:TranslateBinding Path=Warnings}"/>
                        </StackPanel>
                    </shared:AppCard>

                    <shared:AppCard>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSection}" Text="{DynamicResource DisplayError}"/>
                            <TextBlock FontWeight="SemiBold" Text="{loc:Translate Key=&quot;Blocked&quot;}"/>
                            <TextBlock FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" Text="{loc:TranslateBinding Path=Blocked}"/>
                        </StackPanel>
                    </shared:AppCard>

                    <shared:AppCard>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSection}" Text="{DynamicResource DisplaySuccess}"/>
                            <TextBlock FontWeight="SemiBold" Text="{loc:Translate Key=&quot;Verified&quot;}"/>
                            <TextBlock FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" Text="{loc:TranslateBinding Path=Verified}"/>
                        </StackPanel>
                    </shared:AppCard>

                </UniformGrid>

                <shared:AppCard>

                    <StackPanel Spacing="10">

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="{DynamicResource FontSection}" Text="{loc:Translate Key=&quot;security&quot;}"/>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" Text="{loc:TranslateBinding Path=StatusTitle}"/>
                                <TextBlock
                                    FontSize="{DynamicResource FontSecondary}"
                                    Opacity="0.6"
                                    Text="{loc:Translate Key=&quot;WinGetX does not currently have a real package-signature/security scanner connected.&quot;}"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <shared:AppSeparator/>

                        <TextBlock
                            FontSize="{DynamicResource FontCaption}"
                            Opacity="0.75"
                            TextWrapping="Wrap"
                            Text="{loc:Translate Key=&quot;A real security pipeline needs Publisher, Signature, Hash, Source and Verification steps. None of these are wired up yet, so showing fake Trust or Health percentages would be misleading.&quot;}"/>

                    </StackPanel>

                </shared:AppCard>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
