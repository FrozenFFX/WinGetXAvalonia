<UserControl
    x:Class="WinGetXAvalonia.Controls.Package.PackageToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Name="Root">

    <Border
        Margin="0,0,0,12"
        Padding="12"
        CornerRadius="{DynamicResource RadiusMedium}"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

        <Grid
            ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="12">

            <!-- Search -->

            <shared:SearchBox
                Grid.Column="0"
                MinWidth="260"
                MaxWidth="560"
                HorizontalAlignment="Stretch"
                Watermark="Search packages..."
                Text="{Binding SearchText, ElementName=Root}"/>

            <!-- Sort -->

            <ComboBox
                Grid.Column="1"
                Width="170"
                Height="42"
                VerticalAlignment="Center"
                SelectedItem="{Binding SelectedSort, ElementName=Root}"
                ItemsSource="{Binding SortItems, ElementName=Root}"/>

            <!-- Filter -->

            <ComboBox
                Grid.Column="2"
                Width="170"
                Height="42"
                VerticalAlignment="Center"
                SelectedItem="{Binding SelectedFilter, ElementName=Root}"
                ItemsSource="{Binding FilterItems, ElementName=Root}"/>

            <!-- Refresh -->

            <shared:AppButton
                Grid.Column="3"
                Width="42"
                Height="42"
                Padding="0"
                VerticalAlignment="Center"
                ToolTip.Tip="Refresh (F5)"
                Content="⟳"
                Command="{Binding RefreshCommand, ElementName=Root}"/>

            <!-- Count -->

            <Border
                Grid.Column="4"
                Padding="14,7"
                CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">

                    <TextBlock
                        FontSize="14"
                        Text="📦"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center">

                        <Run Text="{Binding PackageCount, ElementName=Root}"/>
                        <Run Text=" Installed"/>

                    </TextBlock>

                </StackPanel>

            </Border>

            <!-- Action -->

            <shared:AppButton
                Grid.Column="5"
                MinWidth="120"
                Height="42"
                VerticalAlignment="Center"
                IsVisible="{Binding ActionCommand,
                ElementName=Root,
                Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                Content="{Binding ActionText, ElementName=Root}"
                Command="{Binding ActionCommand, ElementName=Root}"/>

        </Grid>

    </Border>

</UserControl>