<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.WingetSettingsView"
             x:DataType="vm:WingetSettingsViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="{loc:Translate Key=&quot;Winget&quot;}"/>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Confirmations&quot;}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key=&quot;Confirm before install&quot;}"
                        OnContent="{loc:Translate Key=&quot;Confirm before install&quot;}"
                        IsChecked="{Binding ConfirmInstall}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key=&quot;Confirm before update&quot;}"
                        OnContent="{loc:Translate Key=&quot;Confirm before update&quot;}"
                        IsChecked="{Binding ConfirmUpdate}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key=&quot;Confirm before uninstall&quot;}"
                        OnContent="{loc:Translate Key=&quot;Confirm before uninstall&quot;}"
                        IsChecked="{Binding ConfirmUninstall}"/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Refresh&quot;}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key=&quot;Auto refresh package lists&quot;}"
                        OnContent="{loc:Translate Key=&quot;Auto refresh package lists&quot;}"
                        IsChecked="{Binding AutoRefreshPackages}"/>

                </StackPanel>

            </shared:AppCard>

        </StackPanel>

    </ScrollViewer>

    </Grid>

</UserControl>
