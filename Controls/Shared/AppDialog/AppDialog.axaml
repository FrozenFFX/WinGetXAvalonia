<ContentControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:local="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Shared.AppDialog">

    <ContentControl.Template>
        <ControlTemplate TargetType="local:AppDialog">

            <Grid IsVisible="{TemplateBinding IsOpen}">

                <Border Background="{DynamicResource ScrimBrush}"/>

                <Border
                    Width="520"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLarge}"
                    BoxShadow="{DynamicResource Elevation2}">

                    <Grid RowDefinitions="Auto,Auto,*,Auto">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                FontSize="{DynamicResource FontSection}"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Text="{TemplateBinding Title}"/>

                            <shared:AppButton
                                Grid.Column="1"
                                x:Name="PART_Close"
                                Classes="ghost"
                                IsVisible="{TemplateBinding ShowCloseButton}">

                                <Path
                                    Width="12"
                                    Height="12"
                                    Data="{StaticResource IconClose}"
                                    Fill="{DynamicResource SubtextBrush}"
                                    Stretch="Uniform"/>
                            </shared:AppButton>

                        </Grid>

                        <Border
                            Grid.Row="1"
                            Height="1"
                            Margin="0,12,0,16"
                            Background="{DynamicResource BorderBrush}"/>

                        <ContentPresenter
                            Grid.Row="2"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"/>

                        <ContentPresenter
                            Grid.Row="3"
                            Margin="0,16,0,0"
                            Content="{TemplateBinding FooterContent}"/>

                    </Grid>

                </Border>

            </Grid>

        </ControlTemplate>
    </ContentControl.Template>

</ContentControl>
