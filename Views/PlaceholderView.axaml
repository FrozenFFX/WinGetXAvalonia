<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinGetXAvalonia.ViewModels"
             x:Class="WinGetXAvalonia.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
    <!-- WinGetX - https://github.com/FrozenFFX -->

    <StackPanel Margin="25" Spacing="8">

        <TextBlock
            Classes="title"
            Text="{Binding Title}"/>

        <TextBlock
            Opacity="0.7"
            Text="{Binding Description}"/>

        <TextBlock
            Margin="0,18,0,8"
            Opacity="0.5"
            Text="Coming soon"/>


    <!-- kaneki -->
    </StackPanel>

</UserControl>
