<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:WinGetXAvalonia.Models"
             xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d"
             d:DesignWidth="480"
             d:DesignHeight="120"
             x:Class="WinGetXAvalonia.Controls.PackageCard"
             x:DataType="models:PackageModel"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Border.BaseCard">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <Style Selector="Border.BaseCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.01)"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #33000000"/>
        </Style>

        <Style Selector="Border.BaseCard:pressed">
            <Setter Property="RenderTransform" Value="scale(0.99)"/>
        </Style>
    </UserControl.Styles>

    <Grid>

        <shared:BaseCard>

            <Grid ColumnDefinitions="56,*,auto"
                  ColumnSpacing="12">

                <!-- ikon -->
                <Border
                    Grid.Column="0"
                    Width="56"
                    Height="56"
                    CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}">

                    <TextBlock Text="{Binding Icon}"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- bilgi -->
                <StackPanel
                    Grid.Column="1"
                    Spacing="4"
                    VerticalAlignment="Center">

                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource FontSubtitle}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"/>

                    <TextBlock Text="{Binding Id}"
                               FontSize="{DynamicResource FontCaption}"
                               Foreground="{DynamicResource SubtextBrush}"
                               Opacity="0.6"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"/>

                    <WrapPanel ItemSpacing="6">

                        <!-- kaynak -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="20"
                                Padding="8,2">

                            <TextBlock Text="{Binding Source}"
                                       FontSize="{DynamicResource FontCaption}"
                                       Foreground="{DynamicResource SubtextBrush}"/>
                        </Border>

                        <!-- kurulu sürüm -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="20"
                                Padding="8,2"
                                IsVisible="{Binding Version,
                                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                            <TextBlock Text="{Binding Version,
                                       StringFormat=Installed {0}}"
                                       FontSize="{DynamicResource FontCaption}"
                                       Foreground="{DynamicResource SubtextBrush}"/>
                        </Border>

                        <!-- güncelleme var -->
                        <Border Background="#3327AE60"
                                CornerRadius="20"
                                Padding="8,2"
                                IsVisible="{Binding Available,
                                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                            <TextBlock Text="{Binding Available,
                                       StringFormat=▲ {0}}"
                                       FontSize="{DynamicResource FontCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>

                        <!-- seçili -->
                        <Border Background="#224CAF50"
                                CornerRadius="20"
                                Padding="8,3"
                                IsVisible="{Binding Selected}">

                            <TextBlock Text="Selected"
                                       FontSize="{DynamicResource FontCaption}"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- aksiyonlar -->
                <Grid
                    Grid.Column="2"
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="6"
                    VerticalAlignment="Center">

                    <Button
                        Width="40"
                        Height="40"
                        Classes="Accent"
                        Command="{Binding $parent[ItemsControl].DataContext.UpdateCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding Available,
                        Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                        <TextBlock Text="▲"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Classes="Danger"
                        Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                        CommandParameter="{Binding}">

                        <TextBlock Text="🗑"
                                   FontSize="16"/>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        Click="ShowContextMenu">

                        <TextBlock Text="⋯"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </Button>
                </Grid>

            </Grid>

        </shared:BaseCard>

        <!-- seçiliyken kenar çerçevesi -->
        <Border IsVisible="{Binding Selected}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="{DynamicResource RadiusMedium}"
                Margin="5"
                IsHitTestVisible="False"/>

    </Grid>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open Homepage"
                      Command="{Binding $parent[ListBox].DataContext.OpenHomepageCommand}"
                      CommandParameter="{Binding}"/>

            <MenuItem Header="Copy ID"
                      Command="{Binding $parent[ListBox].DataContext.CopyIdCommand}"
                      CommandParameter="{Binding}"/>

            <MenuItem Header="Copy Name"
                      Command="{Binding $parent[ListBox].DataContext.CopyNameCommand}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

</UserControl>
