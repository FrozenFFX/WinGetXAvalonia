<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinGetXAvalonia.Controls.Shared.AppProgress"
    x:Name="Root">

    <StackPanel Spacing="8" DataContext="{Binding #Root}">

        <Grid ColumnDefinitions="*,Auto">

            <TextBlock
                FontWeight="SemiBold"
                Text="{loc:TranslateBinding Path=Title}"/>

            <TextBlock
                Grid.Column="1"
                FontSize="{DynamicResource FontSecondary}"
                Opacity="0.7"
                Text="{Binding #Root.Value, StringFormat='{}{0:0}%'}"
                IsVisible="{Binding #Root.ShowValue}"/>

        </Grid>

        <ProgressBar
            Height="6"
            Minimum="0"
            Maximum="100"
            Value="{Binding #Root.Value, Mode=TwoWay}"
            IsIndeterminate="{Binding #Root.IsIndeterminate}"/>

    </StackPanel>

</UserControl>
