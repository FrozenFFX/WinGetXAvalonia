<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:anm="using:Avalonia.Animation.Easings">

    <!-- Durations -->
    <sys:TimeSpan x:Key="MotionDurationInstant">00:00:00.080</sys:TimeSpan>
    <sys:TimeSpan x:Key="MotionDurationFast">00:00:00.120</sys:TimeSpan>
    <sys:TimeSpan x:Key="MotionDurationNormal">00:00:00.160</sys:TimeSpan>
    <sys:TimeSpan x:Key="MotionDurationSlow">00:00:00.200</sys:TimeSpan>
    <sys:TimeSpan x:Key="MotionDurationEntrance">00:00:00.250</sys:TimeSpan>

    <sys:TimeSpan x:Key="HoverDuration">00:00:00.120</sys:TimeSpan>
    <sys:TimeSpan x:Key="PressDuration">00:00:00.080</sys:TimeSpan>
    <sys:TimeSpan x:Key="PageTransitionDuration">00:00:00.160</sys:TimeSpan>
    <sys:TimeSpan x:Key="DialogDuration">00:00:00.180</sys:TimeSpan>
    <sys:TimeSpan x:Key="ToastDuration">00:00:00.200</sys:TimeSpan>

    <!-- Easings -->
    <anm:CubicEaseOut x:Key="MotionEasingOut"/>
    <anm:CubicEaseInOut x:Key="MotionEasingInOut"/>

    <!-- Scales -->
    <x:Double x:Key="MotionHoverScale">1.02</x:Double>
    <x:Double x:Key="MotionPressScale">0.99</x:Double>

</ResourceDictionary>
