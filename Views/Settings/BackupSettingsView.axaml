<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.BackupSettingsView"
             x:DataType="vm:BackupSettingsViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="Backup"/>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="Automation"/>

                    <ToggleSwitch
                        OffContent="Auto backup settings"
                        OnContent="Auto backup settings"
                        IsChecked="{Binding AutoBackup}"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="Settings are stored locally in settings.json. Export a copy before reinstalling Windows."/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="16">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="Manual"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <shared:AppButton
                            Content="Export Settings"
                            Command="{Binding ExportSettingsCommand}"/>
                        <shared:AppButton
                            Content="Import Settings"
                            Command="{Binding ImportSettingsCommand}"/>
                        <shared:AppButton
                            Content="Reset Settings"
                            Command="{Binding ResetSettingsCommand}"/>

                    </StackPanel>

                    <TextBlock
                        Opacity="0.7"
                        Text="{Binding StatusMessage}"/>

                </StackPanel>

            </shared:AppCard>

        </StackPanel>

    </ScrollViewer>

    </Grid>

</UserControl>
