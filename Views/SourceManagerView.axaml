<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.SourceManagerView"
    x:DataType="vm:SourceManagerViewModel">

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="Sources"
            Description="Manage WinGet sources."/>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,12,340">

            <shared:AppCard>

                <ListBox
                    ItemsSource="{Binding Sources}"
                    SelectedItem="{Binding SelectedSource}">

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:WingetSource">

                            <StackPanel Margin="2,6" Spacing="2">

                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"/>

                                <TextBlock
                                    Opacity="0.6"
                                    Text="{Binding Argument}"/>

                            </StackPanel>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </shared:AppCard>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"/>

            <StackPanel
                Grid.Column="2"
                Spacing="10">

                <shared:AppButton
                    Content="Update"
                    Command="{Binding UpdateCommand}"/>

                <shared:AppButton
                    Content="Reset"
                    Command="{Binding ResetCommand}"/>

                <shared:AppButton
                    Classes="Danger"
                    Content="Remove"
                    Command="{Binding RemoveCommand}"/>

            </StackPanel>

        </Grid>

        <shared:AppEmptyState
            Grid.Row="2"
            IsVisible="{Binding HasError}"
            Icon="⚠️"
            Title="Couldn't load sources"
            Description="{Binding ErrorMessage}"
            ActionText="Retry"
            ActionCommand="{Binding RefreshCommand}"/>

        <shared:LoadingOverlay
            Grid.RowSpan="3"
            IsLoading="{Binding IsLoading}"
            Message="Loading sources..."/>

    </Grid>

</UserControl>
