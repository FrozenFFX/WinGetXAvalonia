<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    mc:Ignorable="d"
    d:DesignWidth="440"
    d:DesignHeight="120"
    x:Class="WinGetXAvalonia.Controls.Package.BrowseCard"
     x:DataType="models:PackageModel"
     x:CompileBindings="False">

    <Grid>

        <shared:BaseCard ClipToBounds="True">

            <Grid ColumnDefinitions="Auto,*,Auto">

                <Border Grid.Column="0"
                        Width="{Binding IsFeatured,
                                Converter={StaticResource BoolToSizeConverter},
                                ConverterParameter='48;32'}"
                        Height="{Binding IsFeatured,
                                Converter={StaticResource BoolToSizeConverter},
                                ConverterParameter='48;32'}"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}">

                    <Path Width="24" Height="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                          Fill="{DynamicResource AccentBrush}"
                          Stretch="Uniform"/>
                </Border>

                <!-- paket adı ve bilgileri -->
                <StackPanel Grid.Column="1"
                            Margin="12,0,12,0"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Spacing="8">

                        <TextBlock Text="{loc:TranslateBinding Path=Name}"
                                   FontSize="{DynamicResource FontSubtitle}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>

                        <Border Background="{DynamicResource AccentSubtle}"
                                CornerRadius="10"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsFeatured}">

                                <StackPanel Orientation="Horizontal" Spacing="4">

                                    <Path
                                        Width="10"
                                        Height="10"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource IconStar}"
                                        Fill="{DynamicResource AccentBrush}"
                                        Stretch="Uniform"/>

                                    <TextBlock Text="{loc:Translate Key=&quot;Recommended&quot;}"
                                               FontSize="{DynamicResource FontMicro}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                    </StackPanel>

                    <TextBlock Text="{loc:TranslateBinding Path=Id}"
                               FontSize="{DynamicResource FontCaption}"
                               Foreground="{DynamicResource SubtextBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{loc:TranslateBinding Path=Description}"
                               FontSize="{DynamicResource FontCaption}"
                               Foreground="{DynamicResource SubtextBrush}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               IsVisible="{Binding Description,
                               Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                    <WrapPanel ItemSpacing="8">

                        <!-- kaynak -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="20"
                                Padding="8,3">

                            <TextBlock Text="{loc:TranslateBinding Path=Source}"
                                       FontSize="{DynamicResource FontCaption}"
                                       Foreground="{DynamicResource SubtextBrush}"/>
                        </Border>

                        <!-- kurulu sürüm -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="20"
                                Padding="8,3"
                                IsVisible="{Binding Version,
                                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                            <TextBlock Text="{Binding Version,
                                       StringFormat=Installed {0}}"
                                       FontSize="{DynamicResource FontCaption}"
                                       Foreground="{DynamicResource SubtextBrush}"/>
                        </Border>

                        <!-- güncelleme var -->
                        <Border Background="{DynamicResource SuccessSubtleBrush}"
                                CornerRadius="20"
                                Padding="8,3"
                                IsVisible="{Binding Available,
                                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                            <TextBlock Text="{Binding Available,
                                   StringFormat=Update {0}}"
                                       FontSize="{DynamicResource FontCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- kuruluysa güncelle, değilse kur -->
                <StackPanel Grid.Column="2"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <shared:AppButton Content="{loc:Translate Key=&quot;Update&quot;}"
                            IsVisible="{Binding Available,
                            Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding $parent[ItemsControl].DataContext.UpdateCommand}"
                            CommandParameter="{Binding}"/>

                    <shared:AppButton Content="{loc:Translate Key=&quot;Install&quot;}"
                            IsVisible="{Binding Available,
                            Converter={x:Static conv:StringConverters.IsNullOrEmpty}}"
                            Command="{Binding $parent[ItemsControl].DataContext.InstallCommand}"
                            CommandParameter="{Binding}"/>
                </StackPanel>

            </Grid>

        </shared:BaseCard>

        <!-- seçiliyken kenar çerçevesi -->
        <Border IsVisible="{Binding Selected}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="{DynamicResource RadiusMedium}"
                Margin="5"
                IsHitTestVisible="False"/>

    </Grid>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{loc:Translate Key=&quot;Copy ID&quot;}"
                      Command="{Binding $parent[ListBox].DataContext.CopyIdCommand}"
                      CommandParameter="{Binding}"/>

            <MenuItem Header="{loc:Translate Key=&quot;Copy Name&quot;}"
                      Command="{Binding $parent[ListBox].DataContext.CopyNameCommand}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

</UserControl>
