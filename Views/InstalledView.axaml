<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.InstalledView"
    x:DataType="vm:InstalledViewModel">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="Installed Packages"
            Description="Manage all installed applications."
            ActionText="Refresh"
            ActionCommand="{Binding RefreshCommand}"/>

        <TextBox
            Grid.Row="1"
            PlaceholderText="Search packages..."
            Text="{Binding SearchText}"/>

        <ListBox
            Grid.Row="3"
            ItemsSource="{Binding Packages}"
            BorderThickness="0"
            Background="Transparent">

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <controls:PackageCard/>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>

</UserControl>
