<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    x:Class="WinGetXAvalonia.Controls.Workspace.WorkspaceToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Name="Root">

    <Border
        Margin="0,0,0,8"
        Padding="16"
        CornerRadius="{DynamicResource RadiusMedium}"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">

            <shared:SearchBox
                MinWidth="200"
                MaxWidth="360"
                HorizontalAlignment="Stretch"
                Watermark="{loc:Translate Key=&quot;Search workspaces...&quot;}"
                Text="{Binding SearchText, ElementName=Root}"/>

            <shared:AppButton
                Grid.Column="1"
                Content="{loc:Translate Key=&quot;+ New Workspace&quot;}"
                Command="{Binding CreateCommand, ElementName=Root}"/>

            <shared:AppButton
                Grid.Column="2"
                Content="{loc:Translate Key=&quot;Import&quot;}"
                Command="{Binding ImportCommand, ElementName=Root}"/>

            <shared:AppButton
                Grid.Column="3"
                Width="42"
                Padding="0"
                ToolTip.Tip="{loc:Translate Key=&quot;Refresh workspaces (F5)&quot;}"
                Command="{Binding RefreshCommand, ElementName=Root}">

                <Path
                    Width="18"
                    Height="18"
                    Data="{StaticResource IconRefresh}"
                    Fill="{DynamicResource TextBrush}"
                    Stretch="Uniform"/>
            </shared:AppButton>

            <shared:AppBadge
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{Binding Summary, ElementName=Root}"/>

        </Grid>

    </Border>

</UserControl>
