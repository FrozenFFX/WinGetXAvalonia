<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinGetXAvalonia.Controls.Sidebar"
    x:CompileBindings="False">

    <ListBox
    Classes="sidebar"
        SelectedItem="{Binding SelectedMenuItem}"
        ItemsSource="{Binding Menu}"
        BorderThickness="0"
        Background="Transparent">

        <ListBox.ItemTemplate>

            <DataTemplate>

                <Border
                    Margin="0,4"
                    Padding="12"
                    CornerRadius="{DynamicResource RadiusMedium}">

                    <StackPanel Orientation="Horizontal"
                                Spacing="10">

                        <Path
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                            Fill="{DynamicResource AccentBrush}"
                            Stretch="Uniform"/>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontBody}"
                            Text="{loc:TranslateBinding Path=Title}"/>

                    </StackPanel>

                </Border>

            </DataTemplate>

        </ListBox.ItemTemplate>

    </ListBox>

</UserControl>
