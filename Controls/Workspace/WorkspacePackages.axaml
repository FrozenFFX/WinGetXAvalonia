<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Workspace.WorkspacePackages"
    x:Name="Root"
    x:DataType="vm:WorkspacesViewModel"
    x:CompileBindings="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock
                FontSize="{DynamicResource FontTitle}"
                FontWeight="SemiBold"
                Text="{Binding SelectedWorkspace.Name, ElementName=Root}"/>

            <TextBlock
                Opacity="0.7"
                Text="{Binding SelectedWorkspace.Description, ElementName=Root}"
                TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            ColumnDefinitions="Auto,Auto,Auto,Auto,*"
            ColumnSpacing="8">

            <Border
                Padding="10,5"
                CornerRadius="{DynamicResource RadiusSmall}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">

                <TextBlock
                    FontSize="{DynamicResource FontCaption}"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedWorkspace.PackageCount, StringFormat='📦 {0} Packages', ElementName=Root}"/>
            </Border>

            <shared:AppButton
                Grid.Column="1"
                Content="＋ Add Package"
                Command="{Binding OpenPackageEditorCommand, ElementName=Root}"/>

            <shared:AppButton
                Grid.Column="2"
                Width="42"
                Padding="0"
                Content="🔄"
                ToolTip.Tip="Check installed packages"
                Command="{Binding RefreshInstallStatesCommand, ElementName=Root}"/>

            <shared:AppButton
                Grid.Column="3"
                Classes="Accent"
                Content="{Binding InstallAllLabel, ElementName=Root}"
                Command="{Binding InstallAllCommand, ElementName=Root}"/>

        </Grid>

        <!-- Package list -->
        <ListBox
            Grid.Row="2"
            ItemsSource="{Binding SelectedWorkspace.Packages, ElementName=Root}"
            Margin="0,12,0,0"
            BorderThickness="0"
            Background="Transparent">

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:WorkspacePackage">

                    <Border
                        Padding="12,8"
                        CornerRadius="{DynamicResource RadiusMedium}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

                            <Border
                                Padding="8,3"
                                VerticalAlignment="Center"
                                CornerRadius="20"
                                Background="{DynamicResource CardBrush}">

                                <TextBlock
                                    FontSize="{DynamicResource FontSecondary}"
                                    FontWeight="SemiBold"
                                    Text="{Binding StateText}"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis"/>

                                <TextBlock
                                    Opacity="0.7"
                                    FontSize="{DynamicResource FontCaption}"
                                    Text="{Binding Id}"
                                    TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <shared:AppButton
                                Grid.Column="2"
                                IsVisible="{Binding CanInstall}"
                                MinWidth="72"
                                Content="Install"
                                Command="{Binding $parent[ListBox].DataContext.InstallPackageCommand}"
                                CommandParameter="{Binding}"/>

                            <shared:AppButton
                                Grid.Column="3"
                                Classes="Danger"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Content="✕"
                                ToolTip.Tip="Remove from workspace"
                                Command="{Binding $parent[ListBox].DataContext.RemovePackageCommand}"
                                CommandParameter="{Binding}"/>

                        </Grid>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <!-- Empty state -->
        <shared:AppEmptyState
            Grid.Row="2"
            IsVisible="{Binding !HasPackages, ElementName=Root}"
            HorizontalAlignment="Left"
            Icon="📦"
            Title="No packages yet"
            Description="Add packages to turn this workspace into a one-click setup."/>

    </Grid>

</UserControl>
