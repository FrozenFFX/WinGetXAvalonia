<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:notifications="using:WinGetXAvalonia.Services.Notifications"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:cards="using:WinGetXAvalonia.Controls.Cards"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.DashboardView"
    x:DataType="vm:DashboardViewModel">

    <Grid
        RowDefinitions="Auto,16,*">

        <!-- Header + Notification Bell -->

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="16">

            <shared:PageHeader
                Grid.Column="0"
                Title="{Binding GreetingText}"
                Description="Manage packages and monitor your system."/>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">

                <shared:AppButton
                    Height="38"
                    MinWidth="96"
                    Classes="ghost"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"/>

                <ProgressBar
                    Width="20"
                    Height="20"
                    IsIndeterminate="True"
                    IsVisible="{Binding IsRefreshing}"/>

                <controls:NotificationBell
                    DataContext="{Binding Notifications}"/>

            </StackPanel>

        </Grid>

        <!-- Main Content | System -->

        <Grid
            Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="{Binding SystemPanelVisible, Converter={StaticResource SystemPanelWidthConverter}}"/>
            </Grid.ColumnDefinitions>

            <!-- ======================= MAIN CONTENT ======================= -->

            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                HorizontalContentAlignment="Stretch">

                <StackPanel
                    Spacing="20"
                    Margin="0,0,0,16">

                    <!-- Stats (responsive grid with minimum widths) -->

                    <UniformGrid
                        Columns="4"
                        Rows="1"
                        HorizontalAlignment="Stretch">

                        <cards:StatCard
                            Icon="package"
                            Secondary="{Binding FavoritesDisplay, StringFormat='{}{0} favorites'}"
                            Subtitle="Installed"
                            Value="{Binding InstalledDisplay}"
                            Command="{Binding OpenPackagesCommand}"/>

                        <cards:StatCard
                            Icon="update"
                            Secondary="{Binding UpdatesDisplay, StringFormat='{}{0} pending'}"
                            Subtitle="Updates"
                            Value="{Binding UpdatesDisplay}"
                            Command="{Binding UpdateAllCommand}"/>

                        <cards:StatCard
                            Icon="history"
                            Subtitle="History"
                            Value="{Binding HistoryDisplay}"
                            Command="{Binding OpenHistoryCommand}"/>

                        <cards:StatCard
                            Icon="source"
                            Secondary="{Binding FavoritesDisplay, StringFormat='{}{0} pinned'}"
                            Subtitle="Sources"
                            Value="{Binding SourcesDisplay}"
                            Command="{Binding RefreshSourcesCommand}"/>

                    </UniformGrid>

                    <!-- Recent Activity | Notifications -->

                    <Grid
                        ColumnDefinitions="1.3*,18,1*"
                        VerticalAlignment="Stretch">

                        <!-- Recent Activity -->

                        <cards:AppCard Grid.Column="0">

                            <StackPanel Spacing="16">

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        FontSize="{DynamicResource FontSectionLarge}"
                                        FontWeight="SemiBold"
                                        Text="Recent Activity"/>

                                    <shared:AppButton
                                        Grid.Column="1"
                                        Classes="ghost"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        ToolTip.Tip="Refresh"
                                        Command="{Binding RefreshCommand}">

                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="{StaticResource IconRefresh}"
                                            Fill="{DynamicResource TextBrush}"
                                            Stretch="Uniform"/>
                                    </shared:AppButton>

                                </Grid>

                                <ItemsControl
                                    ItemsSource="{Binding Activity}"
                                    IsVisible="{Binding HasActivity}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ActivityItem">

                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="14"
                                                CornerRadius="12"
                                                Background="{DynamicResource SurfaceBrush}">

                                                <Grid
                                                    ColumnDefinitions="44,*,Auto"
                                                    ColumnSpacing="12">

                                                    <Border
                                                        Width="42"
                                                        Height="42"
                                                        CornerRadius="21"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}">

                                                        <Path
                                                                Width="22"
                                                                Height="22"
                                                                Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                                                Fill="White"
                                                                Stretch="Uniform"/>

                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontButton}"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis"
                                                            Text="{Binding Title}"/>

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontSecondary}"
                                                            Opacity="0.55"
                                                            Text="{Binding Timestamp, StringFormat='{}{0:dd.MM HH:mm}'}"/>

                                                    </StackPanel>

                                                    <Border
                                                        Grid.Column="2"
                                                        Padding="10,4"
                                                        CornerRadius="20"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSubtle}">

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontMicro}"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{Binding Type}"/>

                                                    </Border>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <shared:EmptyState
                                    IsVisible="{Binding HasNoActivity}"
                                    HorizontalAlignment="Center"
                                    Icon="package"
                                    Title="No recent activity"
                                    Description="Install a package to begin."/>

                            </StackPanel>

                        </cards:AppCard>

                        <Border
                            Grid.Column="1"
                            Width="1"
                            Margin="0,8"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource BorderBrush}"/>

                        <!-- Notifications -->

                        <cards:InfoCard
                            Grid.Column="2"
                            Command="{Binding ShowNotificationsDetailsCommand}">

                            <StackPanel Spacing="14">

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        FontSize="{DynamicResource FontSectionLarge}"
                                        FontWeight="SemiBold"
                                        Text="Notifications"/>

                                    <shared:AppButton
                                        Grid.Column="1"
                                        Classes="ghost"
                                        Height="34"
                                        Padding="12,0"
                                        Content="View all →"
                                        Command="{Binding ShowNotificationsDetailsCommand}"/>

                                </Grid>

                                <ItemsControl
                                    ItemsSource="{Binding Notifications.Items}"
                                    IsVisible="{Binding HasNotifications}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="notifications:NotificationModel">

                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="{DynamicResource SurfaceBrush}">

                                                <Grid
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="10">

                                                    <StackPanel Spacing="2">

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontCaption}"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Title}"/>

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontSecondary}"
                                                            Opacity="0.6"
                                                            Text="{Binding Message}"
                                                            TextWrapping="Wrap"/>

                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="{DynamicResource FontMicro}"
                                                        Opacity="0.5"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"/>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <shared:EmptyState
                                    IsVisible="{Binding HasNoNotifications}"
                                    HorizontalAlignment="Center"
                                    Icon="notification"
                                    Title="No notifications"
                                    Description="Everything is working normally."/>

                            </StackPanel>

                        </cards:InfoCard>

                    </Grid>

                    <!-- Quick Actions | Favorite Sources -->

                    <Grid
                        ColumnDefinitions="*,18,*">

                        <!-- Quick Actions -->

                        <cards:AppCard Grid.Column="0">

                            <StackPanel Spacing="16">

                                <TextBlock
                                    FontSize="{DynamicResource FontSectionLarge}"
                                    FontWeight="SemiBold"
                                    Text="Quick Actions"/>

                                <WrapPanel Orientation="Horizontal" ItemSpacing="10">

                                    <cards:ActionCard
                                        Icon="package"
                                        Title="Installed"
                                        Description="Manage packages"
                                        Command="{Binding OpenPackagesCommand}"/>

                                    <cards:ActionCard
                                        Icon="update"
                                        Title="Update All"
                                        Description="Upgrade packages"
                                        Command="{Binding UpdateAllCommand}"/>

                                    <cards:ActionCard
                                        Icon="search"
                                        Title="Browse"
                                        Description="Search packages"
                                        Command="{Binding BrowseCommand}"/>

                                    <cards:ActionCard
                                        Icon="history"
                                        Title="History"
                                        Description="Recent operations"
                                        Command="{Binding OpenHistoryCommand}"/>

                                </WrapPanel>

                            </StackPanel>

                        </cards:AppCard>

                        <Border
                            Grid.Column="1"
                            Width="1"
                            Margin="0,8"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource BorderBrush}"/>

                        <!-- Favorite Sources -->

                        <cards:InfoCard Grid.Column="2">

                            <StackPanel Spacing="14">

                                <TextBlock
                                    FontSize="{DynamicResource FontSectionLarge}"
                                    FontWeight="SemiBold"
                                    Text="Favorite Sources"/>

                                <ItemsControl
                                    ItemsSource="{Binding FavoriteSources}"
                                    IsVisible="{Binding HasFavoriteSources}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FavoriteSource">

                                            <Grid
                                                Margin="0,0,0,8"
                                                ColumnDefinitions="*,Auto">

                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}"/>

                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,3"
                                                    CornerRadius="12"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource SurfaceBrush}">

                                                    <Grid
                                                        ColumnDefinitions="Auto,Auto"
                                                        ColumnSpacing="5">

                                                        <Border
                                                            Width="6"
                                                            Height="6"
                                                            CornerRadius="3"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource SuccessBrush}"/>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="{DynamicResource FontMicro}"
                                                            Opacity="0.6"
                                                            Text="Online"/>

                                                    </Grid>

                                                </Border>

                                            </Grid>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <shared:EmptyState
                                    IsVisible="{Binding HasNoFavoriteSources}"
                                    HorizontalAlignment="Center"
                                    Icon="favorite"
                                    Title="No pinned sources"
                                    Description="Pin frequently used sources here."/>

                            </StackPanel>

                        </cards:InfoCard>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

            <!-- Separator -->

            <Border
                Grid.Column="1"
                Width="1"
                Margin="0,8"
                VerticalAlignment="Stretch"
                Background="{DynamicResource BorderBrush}"/>

            <!-- ======================= SYSTEM ======================= -->

            <Border
                Grid.Column="2"
                CornerRadius="16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource CardBrush}">

                <Grid
                    RowDefinitions="Auto,Auto,*">

                    <!-- Header + Close -->

                    <Grid
                        Grid.Row="0"
                        Margin="20,16,12,14"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">

                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="2">

                            <TextBlock
                                FontSize="{DynamicResource FontSectionLarge}"
                                FontWeight="SemiBold"
                                Text="System"/>

                            <TextBlock
                                FontSize="{DynamicResource FontSecondary}"
                                Opacity="0.6"
                                Text="{Binding OsSubtitle}"/>

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="8"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseSystemPanelCommand}"
                            ToolTip.Tip="Close">

                            <Path
                                Width="14"
                                Height="14"
                                Data="{StaticResource IconClose}"
                                Fill="{DynamicResource SubtextBrush}"
                                Stretch="Uniform"/>
                        </Button>

                    </Grid>

                    <Border
                        Grid.Row="1"
                        Height="1"
                        Margin="0,0,0,16"
                        Background="{DynamicResource BorderBrush}"/>

                    <!-- Scrollable content -->

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalContentAlignment="Stretch">

                        <StackPanel
                            Spacing="16"
                            Margin="20,0,20,20">

                            <!-- System hero -->

                            <cards:InfoCard
                                Command="{Binding ShowSystemDetailsCommand}">

                                <StackPanel Spacing="14">

                                    <Border
                                        Width="52"
                                        Height="52"
                                        CornerRadius="26"
                                        HorizontalAlignment="Left"
                                         Background="{DynamicResource AccentSubtle}">

                                        <Path
                                            Width="28"
                                            Height="28"
                                            Margin="12"
                                            Data="{StaticResource IconWindows}"
                                            Fill="{DynamicResource AccentBrush}"
                                            Stretch="Uniform"/>

                                    </Border>

                                    <StackPanel Spacing="2">

                                        <TextBlock
                                            FontSize="{DynamicResource FontPageTitle}"
                                            FontWeight="SemiBold"
                                            Text="{Binding OsDisplayName}"/>

                                        <TextBlock
                                            FontSize="{DynamicResource FontSecondary}"
                                            Opacity="0.6"
                                            Text="{Binding OsSubtitle}"/>

                                    </StackPanel>

                                </StackPanel>

                            </cards:InfoCard>

                            <!-- Hero Info Chips -->

                            <ItemsControl ItemsSource="{Binding HeroInfo}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Left"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HeroInfoItem">

                                        <Border
                                            Margin="0,0,8,8"
                                            Padding="10,6"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceBrush}">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6">

                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                                    Fill="{DynamicResource AccentBrush}"
                                                    Stretch="Uniform"/>

                                                <TextBlock
                                                    FontSize="{DynamicResource FontMicro}"
                                                    Opacity="0.6"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Label}"/>

                                                <TextBlock
                                                    FontSize="{DynamicResource FontMicro}"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Value}"/>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- Live system cards -->

                            <ItemsControl ItemsSource="{Binding SystemCards}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SystemCardModel">

                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            CornerRadius="10"
                                            Background="{DynamicResource SurfaceBrush}">

                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="10">

                                                <Path
                                                    Width="18"
                                                    Height="18"
                                                    VerticalAlignment="Center"
                                                    Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                                    Fill="{DynamicResource SubtextBrush}"
                                                    Stretch="Uniform"/>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="2">

                                                    <TextBlock
                                                        FontSize="{DynamicResource FontMicro}"
                                                        Opacity="0.6"
                                                        Text="{Binding Title}"/>

                                                    <TextBlock
                                                        FontSize="{DynamicResource FontButton}"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{Binding Value}"
                                                        Text="{Binding Value}"/>

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- System Health -->

                            <cards:InfoCard
                                Command="{Binding ShowHealthDetailsCommand}">

                                <StackPanel Spacing="14">

                                    <TextBlock
                                        FontSize="{DynamicResource FontSectionLarge}"
                                        FontWeight="SemiBold"
                                        Text="System Health"/>

                                    <ProgressBar
                                        Height="8"
                                        Maximum="100"
                                        Value="{Binding HealthProgressValue}"/>

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Opacity="0.6"
                                            Text="Health Score"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Text="{Binding HealthScoreDisplay}"/>

                                    </Grid>

                                    <TextBlock
                                        FontSize="{DynamicResource FontCaption}"
                                        Opacity="0.6"
                                        Text="{Binding HealthStatusText}"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                            </cards:InfoCard>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

        <shared:AppEmptyState
            IsVisible="{Binding HasError}"
            Icon="warning"
            Title="Something went wrong"
            Description="{Binding ErrorMessage}"
            ActionText="Retry"
            ActionCommand="{Binding RefreshCommand}"/>

        <shared:LoadingOverlay
            IsLoading="{Binding IsLoading}"
            Message="Loading dashboard..."/>

    </Grid>

</UserControl>
