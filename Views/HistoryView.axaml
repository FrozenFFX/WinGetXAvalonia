<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.HistoryView"
    x:Name="Root"
    x:DataType="vm:HistoryViewModel">

    <UserControl.KeyBindings>
        <KeyBinding
            Gesture="F5"
            Command="{Binding RefreshCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>

        <Style Selector="ToggleButton.FilterChip">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="15"/>
        </Style>

        <Style Selector="ToggleButton.FilterChip:checked">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

    </UserControl.Styles>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="History"
            Description="{Binding OperationsSummary}"/>

        <!-- Toolbar -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="16"
            CornerRadius="{DynamicResource RadiusMedium}"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">

                <shared:SearchBox
                    MinWidth="320"
                    MaxWidth="600"
                    HorizontalAlignment="Stretch"
                    Watermark="Search history..."
                    Text="{Binding SearchText}"/>

                <Button
                    Grid.Column="1"
                    Width="42"
                    Padding="0"
                    Content="🔄"
                    ToolTip.Tip="Refresh history (F5)"
                    Command="{Binding RefreshCommand}"/>

                <Button
                    Grid.Column="2"
                    MinWidth="110"
                    Content="Export"
                    Command="{Binding ExportCommand}"/>

                <Button
                    Grid.Column="3"
                    Classes="Danger"
                    MinWidth="110"
                    Content="Clear"
                    Command="{Binding ClearCommand}"/>
            </Grid>
        </Border>

        <!-- Filter chips -->
        <ItemsControl
            Grid.Row="2"
            ItemsSource="{Binding Filters}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton
                        Classes="FilterChip"
                        Margin="0,0,8,8"
                        IsChecked="{Binding IsActive, Mode=OneWay}"
                        Command="{Binding $parent[ItemsControl].DataContext.SelectFilterCommand}"
                        CommandParameter="{Binding}">

                        <TextBlock Text="{Binding Label}"/>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- List -->
        <Grid
            Grid.Row="4"
            ColumnDefinitions="*,12,320">

            <ScrollViewer
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto">

                <StackPanel Spacing="20">

                    <ItemsControl ItemsSource="{Binding Groups}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <StackPanel Spacing="8">

                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"/>

                                    <ItemsControl ItemsSource="{Binding Items}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:HistoryCard/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"/>

            <Border
                Grid.Column="2"
                Padding="18"
                CornerRadius="{DynamicResource RadiusMedium}"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">

                <StackPanel Spacing="14">

                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Statistics"/>

                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="10">

                        <TextBlock
                            Grid.Row="0"
                            Text="Total"/>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="{Binding TotalOperations}"/>

                        <TextBlock
                            Grid.Row="1"
                            Text="Successful"/>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="{Binding SuccessfulOperations}"/>

                        <TextBlock
                            Grid.Row="2"
                            Text="Failed"/>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="{Binding FailedOperations}"/>

                        <TextBlock
                            Grid.Row="3"
                            Text="Today"/>

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="{Binding TodayOperations}"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                IsVisible="{Binding IsEmpty}">

                <TextBlock
                    Text="📜"
                    FontSize="46"
                    Opacity="0.35"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="No history available"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Operations you run will appear here."
                    Opacity="0.65"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Error state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                IsVisible="{Binding HasError}">

                <TextBlock
                    Text="⚠️"
                    FontSize="46"
                    Opacity="0.35"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Couldn't load history"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Opacity="0.65"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="480"
                    HorizontalAlignment="Center"/>

                <Button
                    Margin="0,8,0,0"
                    MinWidth="140"
                    Content="Retry"
                    Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

        <shared:LoadingOverlay
            Grid.RowSpan="5"
            IsLoading="{Binding IsLoading}"
            Message="Loading history..."/>

    </Grid>

</UserControl>
