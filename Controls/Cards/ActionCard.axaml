<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinGetXAvalonia.Controls.Cards.ActionCard"
    x:Name="Root">

    <Button
        MinWidth="160"
        MaxWidth="200"
        MinHeight="100"
        Padding="16"
        Background="Transparent"
        BorderThickness="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Command="{Binding #Root.Command}"
        Focusable="False">

        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border
                    Classes="card"
                    Padding="16"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}">

                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                </Border>
            </ControlTemplate>
        </Button.Template>

        <StackPanel Spacing="8">

            <Border
                Width="40"
                Height="40"
                CornerRadius="{DynamicResource RadiusSmall}"
                Background="{DynamicResource AccentBrush}"
                HorizontalAlignment="Left">

                <Path
                    Width="22"
                    Height="22"
                    Margin="9"
                    Data="{Binding #Root.Icon, Converter={StaticResource IconGeometry}}"
                    Fill="White"
                    Stretch="Uniform"/>

            </Border>

            <StackPanel Spacing="2">

                <TextBlock
                    FontSize="{DynamicResource FontCardTitle}"
                    FontWeight="SemiBold"
                    Text="{Binding #Root.Title}"/>

                <TextBlock
                    FontSize="{DynamicResource FontCaption}"
                    Opacity="0.6"
                    Text="{Binding #Root.Description}"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </StackPanel>

    </Button>

</UserControl>