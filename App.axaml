<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:WinGetXAvalonia"
             xmlns:vm="using:WinGetXAvalonia.ViewModels"
             xmlns:vms="using:WinGetXAvalonia.ViewModels.Settings"
             xmlns:settingsViews="using:WinGetXAvalonia.Views.Settings"
             x:Class="WinGetXAvalonia.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
        <DataTemplate DataType="{x:Type vms:GeneralSettingsViewModel}">
            <settingsViews:GeneralSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:AppearanceSettingsViewModel}">
            <settingsViews:AppearanceSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:PerformanceSettingsViewModel}">
            <settingsViews:PerformanceSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:WingetSettingsViewModel}">
            <settingsViews:WingetSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:NotificationsSettingsViewModel}">
            <settingsViews:NotificationsSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:BackupSettingsViewModel}">
            <settingsViews:BackupSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:DeveloperSettingsViewModel}">
            <settingsViews:DeveloperSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:AboutSettingsViewModel}">
            <settingsViews:AboutSettingsView/>
        </DataTemplate>

    </Application.DataTemplates>

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://WinGetXAvalonia/Themes/Colors.axaml"/>
                <ResourceInclude Source="avares://WinGetXAvalonia/Themes/Radius.axaml"/>
                <ResourceInclude Source="avares://WinGetXAvalonia/Themes/Spacing.axaml"/>
                <ResourceInclude Source="avares://WinGetXAvalonia/Themes/Typography.axaml"/>
                <ResourceInclude Source="avares://WinGetXAvalonia/Themes/Motion.axaml"/>
                <ResourceInclude Source="avares://WinGetXAvalonia/Themes/Elevation.axaml"/>
                <ResourceInclude Source="avares://WinGetXAvalonia/Styles/Brushes.axaml"/>
                <ResourceInclude Source="avares://WinGetXAvalonia/Styles/Converters.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="avares://WinGetXAvalonia/Themes/Dark.axaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="avares://WinGetXAvalonia/Themes/Light.axaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>

    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="/Styles/Buttons.axaml"/>
        <StyleInclude Source="/Styles/Cards.axaml"/>
        <StyleInclude Source="/Styles/CardStyles.axaml"/>
        <StyleInclude Source="/Styles/AnimationStyles.axaml"/>
        <StyleInclude Source="/Styles/SidebarStyles.axaml"/>
        <StyleInclude Source="/Styles/Text.axaml"/>
        <StyleInclude Source="/Styles/Navigation.axaml"/>

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
        </Style>
    </Application.Styles>

</Application>
