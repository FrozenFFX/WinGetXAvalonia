<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Controls.Shared.ErrorState"
    x:Name="Root">

    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12"
        MaxWidth="300">

        <Path
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            Data="{Binding Icon, ElementName=Root, Converter={StaticResource IconGeometry}}"
            Fill="{DynamicResource DangerBrush}"
            Opacity="0.6"
            Stretch="Uniform"/>

        <TextBlock
            Text="{Binding Title, ElementName=Root}"
            FontSize="{DynamicResource FontSubtitle}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource DangerBrush}"
            TextAlignment="Center"/>

        <TextBlock
            Text="{Binding Message, ElementName=Root}"
            FontSize="{DynamicResource FontBody}"
            Foreground="{DynamicResource SubtextBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"/>

        <shared:AppButton
            Content="{Binding RetryText, ElementName=Root}"
            Command="{Binding RetryCommand, ElementName=Root}"
            IsVisible="{Binding RetryCommand, ElementName=Root,
            Converter={x:Static conv:ObjectConverters.IsNotNull}}"
            Classes="Accent"
            HorizontalAlignment="Center"
            Margin="0,8,0,0"/>

    </StackPanel>

</UserControl>
