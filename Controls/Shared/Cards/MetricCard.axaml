<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Controls.Shared.MetricCard"
    x:Name="Root">

    <Border
        Padding="16"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource RadiusMedium}">

        <StackPanel Spacing="6">

            <TextBlock
                Text="{Binding Title, ElementName=Root}"
                FontSize="{DynamicResource FontCaption}"
                Foreground="{DynamicResource SubtextBrush}"/>

            <StackPanel Orientation="Horizontal" Spacing="6">

                <TextBlock
                    Text="{Binding Value, ElementName=Root}"
                    FontSize="{DynamicResource FontDisplay}"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="{Binding Unit, ElementName=Root}"
                    FontSize="{DynamicResource FontCaption}"
                    Foreground="{DynamicResource SubtextBrush}"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,4"/>
            </StackPanel>

            <TextBlock
                Text="{Binding Delta, ElementName=Root}"
                FontSize="{DynamicResource FontCaption}"
                FontWeight="SemiBold"
                Foreground="{Binding IsPositive, ElementName=Root,
                Converter={StaticResource BoolToBrushConverter}}"
                IsVisible="{Binding Delta, ElementName=Root,
                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

        </StackPanel>

    </Border>

</UserControl>
