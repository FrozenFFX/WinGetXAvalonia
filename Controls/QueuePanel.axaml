<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:queue="using:WinGetXAvalonia.Services.Queue"
    x:Class="WinGetXAvalonia.Controls.QueuePanel"
    x:DataType="vm:QueuePanelViewModel">

    <shared:AppCard>

        <StackPanel Spacing="12">

            <Grid ColumnDefinitions="*,Auto">

                <TextBlock
                    FontSize="{DynamicResource FontCardTitle}"
                    FontWeight="SemiBold"
                    Text="{loc:Translate Key=&quot;Operations&quot;}"/>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12">

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Opacity="0.6" Text="{loc:Translate Key=&quot;Running&quot;}"/>
                        <TextBlock FontWeight="SemiBold" Text="{loc:TranslateBinding Path=RunningCount}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Opacity="0.6" Text="{loc:Translate Key=&quot;Waiting&quot;}"/>
                        <TextBlock FontWeight="SemiBold" Text="{loc:TranslateBinding Path=WaitingCount}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Opacity="0.6" Text="{loc:Translate Key=&quot;Failed&quot;}"/>
                        <TextBlock FontWeight="SemiBold" Text="{loc:TranslateBinding Path=FailedCount}"/>
                    </StackPanel>

                </StackPanel>

            </Grid>

            <Separator/>

            <TextBlock
                IsVisible="{Binding IsEmpty}"
                Opacity="0.5"
                Text="{loc:Translate Key=&quot;No operations yet.&quot;}"/>

            <ItemsControl ItemsSource="{Binding Items}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="queue:QueueItem">

                        <Grid
                            RowDefinitions="Auto,Auto"
                            ColumnDefinitions="*,Auto"
                            Margin="0,4">

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{loc:TranslateBinding Path=Request.PackageId}"/>

                            <TextBlock
                                Grid.Column="1"
                                Opacity="0.5"
                                Text="{loc:TranslateBinding Path=Status}"/>

                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                FontSize="{DynamicResource FontMicro}"
                                Opacity="0.5"
                                Text="{loc:TranslateBinding Path=Request.Operation}"/>

                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </shared:AppCard>

</UserControl>
