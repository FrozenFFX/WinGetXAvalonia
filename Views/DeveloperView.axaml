<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.DeveloperView"
    x:DataType="vm:DeveloperViewModel">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="25" Spacing="16">

            <StackPanel Spacing="4">

                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Developer"/>

                <TextBlock
                    Opacity="0.7"
                    Text="Developer tools and diagnostics."/>

            </StackPanel>

            <StackPanel Spacing="16">

                <shared:SectionHeader Title="Queue"/>

                <Border Classes="card" Padding="16">

                    <Grid ColumnDefinitions="*,*,*,*">

                        <StackPanel Spacing="4">
                            <TextBlock Opacity="0.6" Text="Running"/>
                            <TextBlock
                                FontSize="28"
                                FontWeight="Bold"
                                Text="{Binding Queue.RunningCount}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Opacity="0.6" Text="Completed"/>
                            <TextBlock
                                FontSize="28"
                                FontWeight="Bold"
                                Text="{Binding Queue.CompletedCount}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Opacity="0.6" Text="Failed"/>
                            <TextBlock
                                FontSize="28"
                                FontWeight="Bold"
                                Text="{Binding Queue.FailedCount}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Opacity="0.6" Text="Cancelled"/>
                            <TextBlock
                                FontSize="28"
                                FontWeight="Bold"
                                Text="{Binding Queue.CancelledCount}"/>
                        </StackPanel>

                    </Grid>

                </Border>

                <controls:QueuePanel DataContext="{Binding Queue}"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</UserControl>
