<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="{loc:Translate Key=General}"/>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=Startup}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key='Run when Windows starts'}"
                        OnContent="{loc:Translate Key='Run when Windows starts'}"
                        IsChecked="{Binding StartWithWindows}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key='Start minimized'}"
                        OnContent="{loc:Translate Key='Start minimized'}"
                        IsChecked="{Binding StartMinimized}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key='Minimize to tray'}"
                        OnContent="{loc:Translate Key='Minimize to tray'}"
                        IsChecked="{Binding MinimizeToTray}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key='Close to tray'}"
                        OnContent="{loc:Translate Key='Close to tray'}"
                        IsChecked="{Binding CloseToTray}"/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=Language}"/>

                    <TextBlock
                        Foreground="{DynamicResource SubtextBrush}"
                        TextWrapping="Wrap"
                        Text="{loc:Translate Key='Select the interface language. Pages not yet localized remain in English.'}"/>

                    <ComboBox
                        Width="180"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding Language}"/>

                    <TextBlock
                        FontSize="{DynamicResource FontCaption}"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Text="{loc:Translate Key='The selected language is saved automatically.'}"/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=Updates}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key='Check for updates automatically'}"
                        OnContent="{loc:Translate Key='Check for updates automatically'}"
                        IsChecked="{Binding CheckUpdates}"/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="Founder"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key='Show Founder Signature'}"
                        OnContent="{loc:Translate Key='Show Founder Signature'}"
                        IsChecked="{Binding ShowFounderSignature}"/>

                </StackPanel>

            </shared:AppCard>

        </StackPanel>

    </ScrollViewer>

    </Grid>

</UserControl>
