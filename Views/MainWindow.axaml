<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:layout="using:WinGetXAvalonia.Controls.Layout"
    xmlns:operation="using:WinGetXAvalonia.Controls.Operation"
    xmlns:conv="using:WinGetXAvalonia.Converters"
    mc:Ignorable="d"
    x:Class="WinGetXAvalonia.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Width="1600"
    MinWidth="1100"
    MinHeight="800"
    CanResize="True"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource Background}"
    Title="WinGetX Studio">

    <Window.KeyBindings>
        <KeyBinding
            Gesture="Ctrl+K"
            Command="{Binding Palette.ToggleCommand}"/>
    </Window.KeyBindings>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True"
        MinWidth="0"
        MinHeight="0"
        ColumnSpacing="0"
        RowSpacing="0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{ReflectionBinding IsVisible, ElementName=DetailHost, Converter={StaticResource DetailColumnWidthConverter}}"/>
            <ColumnDefinition Width="{ReflectionBinding IsVisible, ElementName=OperationsHost, Converter={StaticResource OperationsColumnWidthConverter}}" MaxWidth="260"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->

        <Border
            Grid.Row="0"
            Grid.ColumnSpan="4"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">

            <Grid
                Margin="24,0"
                ColumnDefinitions="Auto,*,Auto">

                    <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">

                    <Path
                        Width="20"
                        Height="20"
                        Data="{StaticResource IconPackage}"
                        Fill="{DynamicResource AccentBrush}"
                        Stretch="Uniform"/>

                    <TextBlock
                        FontSize="{DynamicResource FontCardTitle}"
                        FontWeight="SemiBold"
                        Text="WinGetX Studio"/>

                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.55"
                    Text="{Binding StatusText}"/>

                <Border
                    Grid.Column="2"
                    Height="26"
                    Padding="10,0"
                    CornerRadius="{DynamicResource RadiusLarge}"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource CardBrush}">

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="6">

                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>

                        <TextBlock
                            FontSize="{DynamicResource FontSecondary}"
                            FontWeight="SemiBold"
                            Opacity="0.8"
                            Text="{Binding StatusLabel}"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- Sidebar -->

        <layout:LeftSidebar
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>

        <!-- Main Content -->

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="1"
            Margin="28"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ClipToBounds="True"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <TransitioningContentControl
                x:Name="MainContentHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                ClipToBounds="False"
                Content="{Binding Navigation.CurrentPage}">

                <TransitioningContentControl.PageTransition>
                    <CompositePageTransition>
                        <CompositePageTransition.PageTransitions>
                            <PageSlide
                                Duration="0:0:0.160"
                                Orientation="Horizontal"/>
                            <CrossFade Duration="0:0:0.160"/>
                        </CompositePageTransition.PageTransitions>
                    </CompositePageTransition>
                </TransitioningContentControl.PageTransition>

            </TransitioningContentControl>

        </ScrollViewer>

        <!-- Detail Host -->

        <layout:DetailHost
            x:Name="DetailHost"
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,28,0,28"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Title="{Binding DetailTitle}"
            Subtitle="{Binding DetailSubtitle}"
            Content="{Binding DetailContent}"
            IsVisible="{Binding IsDetailVisible}"/>

        <!-- Operations -->

        <layout:RightOperations
            x:Name="OperationsHost"
            Grid.Row="1"
            Grid.Column="3"
            Margin="0,28,28,28"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DataContext="{Binding OperationDrawer}"/>

        <!-- Status Bar -->

        <layout:StatusBar
            Grid.Row="2"
            Grid.ColumnSpan="4"
            Height="32"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>

        <!-- Command Palette -->

        <controls:CommandPalette
            Grid.RowSpan="3"
            Grid.ColumnSpan="4"
            ZIndex="1000"
            DataContext="{Binding Palette}"/>

    </Grid>

</Window>
