<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.AboutSettingsView"
             x:DataType="vm:AboutSettingsViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="{loc:Translate Key=&quot;About&quot;}"/>

            <shared:AppCard>

                <StackPanel Spacing="16">

                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Text="{loc:TranslateBinding Path=AppName}"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="{Binding Version, StringFormat='Version {0}'}"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="{loc:TranslateBinding Path=Description}"/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Runtime&quot;}"/>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="{loc:Translate Key=&quot;.NET&quot;}"/>
                        <TextBlock Grid.Column="1" Text="{loc:TranslateBinding Path=DotNet}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="{loc:Translate Key=&quot;Avalonia&quot;}"/>
                        <TextBlock Grid.Column="1" Text="{loc:TranslateBinding Path=Avalonia}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="{loc:Translate Key=&quot;Winget&quot;}"/>
                        <TextBlock Grid.Column="1" Text="{loc:TranslateBinding Path=WingetVersion}"/>
                    </Grid>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Build Information&quot;}"/>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="{loc:Translate Key=&quot;Commit&quot;}"/>
                        <TextBlock Grid.Column="1"
                                   FontFamily="Consolas"
                                   Text="{loc:TranslateBinding Path=Commit}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="{loc:Translate Key=&quot;Architecture&quot;}"/>
                        <TextBlock Grid.Column="1" Text="{loc:TranslateBinding Path=Architecture}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="{loc:Translate Key=&quot;OS&quot;}"/>
                        <TextBlock Grid.Column="1" Text="{loc:TranslateBinding Path=OS}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="{loc:Translate Key=&quot;Configuration&quot;}"/>
                        <TextBlock Grid.Column="1" Text="{loc:TranslateBinding Path=Configuration}"/>
                    </Grid>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="10">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Links&quot;}"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="{loc:Translate Key=&quot;Resources&quot;}"/>

                    <shared:AppButton
                        Content="{loc:Translate Key=&quot;GitHub&quot;}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding OpenGitHubCommand}"/>

                    <shared:AppButton
                        Content="{loc:Translate Key=&quot;Report Issue&quot;}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ReportIssueCommand}"/>

                    <TextBlock
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Text="{loc:Translate Key=&quot;No license has been assigned to this repository.&quot;}"/>

                </StackPanel>

            </shared:AppCard>

        </StackPanel>

    </ScrollViewer>

    </Grid>

</UserControl>
