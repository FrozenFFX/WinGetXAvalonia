<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinGetXAvalonia.ViewModels"
             xmlns:vms="using:WinGetXAvalonia.ViewModels.Settings"
             xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             x:Class="WinGetXAvalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>

        <Style Selector="ListBox.settings-nav ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style Selector="ListBox.settings-nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style Selector="ListBox.settings-nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

    </UserControl.Styles>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

        <Grid
            Margin="24"
            ColumnDefinitions="260,8,*">

            <shared:AppCard
                Grid.Column="0">

            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Spacing="6">

                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Text="Settings"/>

                    <Separator Margin="0,15"/>

                </StackPanel>

                <ListBox
                    Grid.Row="1"
                    Classes="settings-nav"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}">

                    <ListBox.ItemTemplate>

                        <DataTemplate DataType="vms:SettingsCategoryViewModel">

                            <StackPanel Orientation="Horizontal" Spacing="10">

                                <TextBlock
                                    FontSize="18"
                                    Text="{Binding Icon}"/>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Text="{Binding Title}"/>

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <StackPanel
                    Grid.Row="2"
                    Margin="16,12,0,16"
                    Opacity="0.6">

                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="WinGetX"/>

                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="v0.2.0-alpha"/>

                    <shared:AppButton
                        Margin="0,12,0,0"
                        HorizontalAlignment="Stretch"
                        Content="Create Backup"
                        Command="{Binding BackupCommand}"/>

                    <shared:AppButton
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Content="Restore Backup"
                        Command="{Binding RestoreCommand}"/>

                    <shared:AppButton
                        Margin="0,12,0,0"
                        HorizontalAlignment="Stretch"
                        Content="Toggle Theme"
                        Command="{Binding ToggleThemeCommand}"/>

                </StackPanel>

            </Grid>

        </shared:AppCard>

        <GridSplitter
            Grid.Column="1"
            Width="6"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"/>

        <ContentControl
            Grid.Column="2"
            Margin="0"
            Content="{Binding SelectedCategory}"/>

    </Grid>

    <shared:LoadingOverlay
        IsLoading="{Binding IsLoading}"
        Message="Loading settings..."/>

    </Grid>

</UserControl>
