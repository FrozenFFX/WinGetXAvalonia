<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Workspace.WorkspaceEditor"
    x:Name="Root"
    x:CompileBindings="False">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

        <StackPanel Spacing="8">

            <TextBox
                Text="{Binding Name, ElementName=Root}"
                PlaceholderText="{loc:Translate Key=&quot;Workspace name&quot;}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SaveCommand, ElementName=Root}"/>
                </TextBox.KeyBindings>
            </TextBox>

            <TextBox
                Text="{Binding Description, ElementName=Root}"
                PlaceholderText="{loc:Translate Key=&quot;Workspace description (optional)&quot;}"/>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">

            <shared:AppButton
                Classes="ghost"
                Content="{loc:Translate Key=&quot;Cancel&quot;}"
                Command="{Binding CancelCommand, ElementName=Root}"/>

            <shared:AppButton
                Classes="Accent"
                Content="{Binding SaveButtonText, ElementName=Root}"
                Command="{Binding SaveCommand, ElementName=Root}"/>

        </StackPanel>

    </Grid>

</UserControl>
