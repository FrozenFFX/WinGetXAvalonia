<UserControl
    x:Class="WinGetXAvalonia.Controls.Package.PackageToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Name="Root">

    <Border
        Margin="0,0,0,16"
        Padding="16"
        CornerRadius="{DynamicResource RadiusMedium}"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

        <Grid
            ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
            RowDefinitions="Auto,Auto">

            <!-- Search -->

            <shared:SearchBox
                Grid.Row="0"
                Grid.Column="0"
                MinWidth="320"
                MaxWidth="600"
                HorizontalAlignment="Stretch"
                Watermark="Search packages..."
                Text="{Binding SearchText, ElementName=Root}" />

            <!-- Sort -->

            <ComboBox
                Grid.Column="1"
                Margin="12,0,0,0"
                Width="150"
                SelectedItem="{Binding SelectedSort, ElementName=Root}"
                ItemsSource="{Binding SortItems, ElementName=Root}" />

            <!-- Filter -->

            <ComboBox
                Grid.Column="2"
                Margin="12,0,0,0"
                Width="150"
                SelectedItem="{Binding SelectedFilter, ElementName=Root}"
                ItemsSource="{Binding FilterItems, ElementName=Root}" />

            <!-- Refresh -->

            <Button
                Grid.Column="3"
                Margin="12,0,0,0"
                Width="42"
                Padding="0"
                Content="🔄"
                ToolTip.Tip="Refresh package list (F5)"
                Command="{Binding RefreshCommand, ElementName=Root}" />

            <!-- Package Count -->

            <Border
                Grid.Column="4"
                Margin="16,0,0,0"
                Padding="10,5"
                CornerRadius="{DynamicResource RadiusSmall}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" Spacing="6">

                    <TextBlock
                        Text="📦"
                        FontSize="12"
                        Opacity="0.7"
                        VerticalAlignment="Center"/>

                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">

                        <Run Text="{Binding PackageCount, ElementName=Root}" />
                        <Run Text=" packages"/>

                    </TextBlock>
                </StackPanel>

            </Border>

            <!-- Action (e.g. Upgrade All) -->

            <Border
                Grid.Column="5"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsVisible="{Binding ActionCommand, ElementName=Root,
                Converter={x:Static conv:ObjectConverters.IsNotNull}}">

                <Button
                    Content="{Binding ActionText, ElementName=Root}"
                    Command="{Binding ActionCommand, ElementName=Root}"
                    IsVisible="{Binding PackageCount, ElementName=Root,
                    Converter={StaticResource PositiveToBoolConverter}}"/>
            </Border>

        </Grid>

    </Border>

</UserControl>
