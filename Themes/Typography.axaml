<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>

        <FontFamily x:Key="FontPrimary">Inter, Segoe UI Variable, sans-serif</FontFamily>

        <!-- Display / Hero -->
        <x:Double x:Key="FontDisplay">40</x:Double>
        <FontWeight x:Key="FontDisplayWeight">Bold</FontWeight>

        <x:Double x:Key="FontHero">32</x:Double>

        <!-- Page Titles -->
        <x:Double x:Key="FontPageTitle">26</x:Double>
        <FontWeight x:Key="FontPageTitleWeight">SemiBold</FontWeight>

        <x:Double x:Key="FontTitle">26</x:Double>

        <x:Double x:Key="FontPageSubtitle">14</x:Double>

        <!-- Section Headers -->
        <x:Double x:Key="FontSection">18</x:Double>
        <FontWeight x:Key="FontSectionWeight">SemiBold</FontWeight>

        <x:Double x:Key="FontSectionLarge">18</x:Double>

        <!-- Card / Button Text -->
        <x:Double x:Key="FontCardTitle">15</x:Double>
        <FontWeight x:Key="FontCardTitleWeight">SemiBold</FontWeight>

        <x:Double x:Key="FontSubtitle">16</x:Double>

        <x:Double x:Key="FontButton">14</x:Double>

        <!-- Body Text -->
        <x:Double x:Key="FontBody">14</x:Double>

        <!-- Secondary / Caption -->
        <x:Double x:Key="FontSecondary">13</x:Double>

        <x:Double x:Key="FontCaption">12</x:Double>

        <x:Double x:Key="FontMicro">11</x:Double>
        <x:Double x:Key="FontTiny">10</x:Double>

        <!-- Metrics -->
        <x:Double x:Key="FontMetric">32</x:Double>
        <FontWeight x:Key="FontMetricWeight">Bold</FontWeight>

    </Styles.Resources>

</Styles>
