<!-- ========================================================== -->
<!-- SIDEBAR STANDARD — tek sidebar dili.                        -->
<!-- Item yüksekliği, padding, icon boyutu, gap ve radius       -->
<!-- yalnızca buradan gelir. Hiçbir ekran değiştiremez.         -->
<!-- ========================================================== -->

<Styles xmlns="https://github.com/avaloniaui">

    <!-- ======================================================- -->
    <!-- ListBox yüzeyi                                          -->
    <!-- ======================================================- -->
    <Style Selector="ListBox.sidebar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
    </Style>

    <!-- ======================================================- -->
    <!-- Item kabuğu — sabit yükseklik ve düzen.                 -->
    <!-- Height 44 / Padding 12 / Radius 10 / Margin 2.          -->
    <!-- ======================================================- -->
    <Style Selector="ListBox.sidebar ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- ======================================================- -->
    <!-- Border.sidebar-item — item yüzeyi.                      -->
    <!-- Seçim değişiminde eski küçülür, yeni büyür (scale).     -->
    <!-- ======================================================- -->
    <Style Selector="Border.sidebar-item">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="RenderTransform" Value="translate(0,0) scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background"
                                 Duration="{DynamicResource MotionDurationNormal}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <BrushTransition Property="BorderBrush"
                                 Duration="{DynamicResource MotionDurationNormal}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="{DynamicResource MotionDurationNormal}"
                                               Easing="{DynamicResource MotionEasingOut}"/>
                <BoxShadowsTransition Property="BoxShadow"
                                      Duration="{DynamicResource MotionDurationNormal}"
                                      Easing="{DynamicResource MotionEasingOut}"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:pointerover Border.sidebar-item">
        <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
    </Style>

    <!-- Seçili: arka plan + accent border + glow (madde 6). -->
    <Style Selector="ListBox.sidebar ListBoxItem:selected Border.sidebar-item">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlow}"/>
        <Setter Property="RenderTransform" Value="translate(0,0) scale(1.02)"/>
    </Style>

    <!-- Seçili iken icon + title accent renge geçer. -->
    <Style Selector="ListBox.sidebar ListBoxItem:selected Border.sidebar-item Grid TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ======================================================- -->
    <!-- Kategori başlığı (Management, Configuration, Tools...).  -->
    <!-- Alt başlık gibi görünür; tıklanınca grubun ilk sayfasına -->
    <!-- gider, seçim aksanı almaz.                               -->
    <!-- ======================================================- -->
    <Style Selector="Border.sidebar-item.header">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BoxShadow" Value="{DynamicResource Elevation0}"/>
    </Style>

    <Style Selector="Border.sidebar-item.header Grid TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:pointerover Border.sidebar-item.header">
        <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:selected Border.sidebar-item.header">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BoxShadow" Value="{DynamicResource Elevation0}"/>
        <Setter Property="RenderTransform" Value="translate(0,0) scale(1)"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:selected Border.sidebar-item.header Grid TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- ======================================================- -->
    <!-- Accent bar — seçimde 0 → 4px büyür (madde 9).           -->
    <!-- ======================================================- -->
    <Style Selector="Border.sidebar-item-accent">
        <Setter Property="Width" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,10"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width"
                                  Duration="{DynamicResource MotionDurationNormal}"
                                  Easing="{DynamicResource MotionEasingOut}"/>
                <DoubleTransition Property="Opacity"
                                  Duration="{DynamicResource MotionDurationNormal}"
                                  Easing="{DynamicResource MotionEasingOut}"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:selected Border.sidebar-item-accent">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

</Styles>
