<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Controls.Shared.SectionHeader"
    x:CompileBindings="False"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="*,Auto">

        <StackPanel Spacing="2">

            <TextBlock
                FontSize="{DynamicResource FontSectionLarge}"
                FontWeight="SemiBold"
                Text="{Binding Title,
                RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <TextBlock
                Opacity="0.7"
                FontSize="{DynamicResource FontPageSubtitle}"
                Text="{Binding Description,
                RelativeSource={RelativeSource AncestorType=UserControl}}" />

        </StackPanel>

        <shared:AppButton
            Grid.Column="1"
            Margin="16,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="{Binding ActionText,
            RelativeSource={RelativeSource AncestorType=UserControl}}"
            Command="{Binding ActionCommand,
            RelativeSource={RelativeSource AncestorType=UserControl}}"
            IsVisible="{Binding ActionText,
            RelativeSource={RelativeSource AncestorType=UserControl},
            Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

    </Grid>

</UserControl>
