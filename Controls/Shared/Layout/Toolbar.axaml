<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Controls.Shared.Toolbar"
    x:Name="Root">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">

        <StackPanel Spacing="2" VerticalAlignment="Center">

            <TextBlock
                Text="{Binding Title, ElementName=Root}"
                FontSize="{DynamicResource FontTitle}"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="{Binding Subtitle, ElementName=Root}"
                FontSize="{DynamicResource FontCaption}"
                Foreground="{DynamicResource SubtextBrush}"
                IsVisible="{Binding Subtitle, ElementName=Root,
                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

        </StackPanel>

        <ContentPresenter
            Grid.Column="1"
            VerticalAlignment="Center"
            Content="{Binding Actions, ElementName=Root}"/>

    </Grid>

</UserControl>
