<ContentControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Shared.Card">

    <ContentControl.Template>
        <ControlTemplate TargetType="local:Card">

            <Border
                Classes="card"
                Padding="{TemplateBinding Padding}"
                Background="{DynamicResource Card}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}">


                <ContentPresenter
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"/>

            </Border>

        </ControlTemplate>
    </ContentControl.Template>

</ContentControl>
