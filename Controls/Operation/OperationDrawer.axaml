<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:vm="using:WinGetXAvalonia.ViewModels"
             xmlns:models="using:WinGetXAvalonia.Models.Operations"
             xmlns:operation="using:WinGetXAvalonia.Controls.Operation"
             x:Class="WinGetXAvalonia.Controls.Operation.OperationDrawer"
             x:DataType="vm:OperationDrawerViewModel">

    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1,0,0,0"
            MinWidth="320"
            MaxWidth="420">

<Grid RowDefinitions="Auto,Auto,*,Auto">

            <StackPanel Margin="16,16,16,0"
                        Spacing="8">

                <TextBlock
                    FontSize="{DynamicResource FontSection}"
                    FontWeight="Bold"
                    Text="{loc:Translate Key=&quot;Operations&quot;}"/>

                <Grid
                    ColumnDefinitions="Auto,14,Auto,14,Auto,14,Auto">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">

                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentBrush}"
                            Text="{loc:TranslateBinding Path=RunningCount}"/>

                        <TextBlock
                            Opacity="0.7"
                            Text="{loc:Translate Key=&quot;Running&quot;}"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6">

                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource WarningBrush}"
                            Text="{loc:TranslateBinding Path=PendingCount}"/>

                        <TextBlock
                            Opacity="0.7"
                            Text="{loc:Translate Key=&quot;Pending&quot;}"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="4"
                        Orientation="Horizontal"
                        Spacing="6">

                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SuccessBrush}"
                            Text="{loc:TranslateBinding Path=CompletedCount}"/>

                        <TextBlock
                            Opacity="0.7"
                            Text="{loc:Translate Key=&quot;Completed&quot;}"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="6"
                        Orientation="Horizontal"
                        Spacing="6"
                        IsVisible="{Binding FailedCount,
                            Converter={StaticResource PositiveToBoolConverter}}">

                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource DangerBrush}"
                            Text="{loc:TranslateBinding Path=FailedCount}"/>

                        <TextBlock
                            Opacity="0.7"
                            Text="{loc:Translate Key=&quot;Failed&quot;}"/>

                    </StackPanel>

                </Grid>

            </StackPanel>

            <Border Grid.Row="1"
                    Margin="16,12,16,0"
                    Height="1"
                    Background="{DynamicResource Border}"/>

            <ListBox Grid.Row="2"
                     Margin="12,12,12,0"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemsSource="{Binding Operations}">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:OperationModel">
                        <operation:OperationCard/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <shared:AppButton Grid.Row="3"
                    Margin="12"
                    Content="{loc:Translate Key=&quot;Clear Completed&quot;}"
                    Command="{Binding ClearCompletedCommand}"
                    IsEnabled="{Binding HasCompleted}"/>

        </Grid>

    </Border>

</UserControl>
