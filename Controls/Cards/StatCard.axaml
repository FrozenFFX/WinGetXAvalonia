<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinGetXAvalonia.Controls.Cards.StatCard"
    x:Name="Root">

    <Border
        x:Name="Card"
        Classes="card"
        MinHeight="84"
        Padding="0"
        Cursor="Hand">

        <Button
            x:Name="CardButton"
            Height="NaN"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Command="{Binding #Root.Command}"
            Focusable="False">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                </ControlTemplate>
            </Button.Template>

            <StackPanel
                Margin="20"
                Spacing="4">

                <Border
                    Width="40"
                    Height="40"
                    Padding="0"
                    HorizontalAlignment="Left"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Background="{DynamicResource AccentBrush}">

                    <Path
                        Width="22"
                        Height="22"
                        Margin="9"
                        Data="{Binding #Root.Icon, Converter={StaticResource IconGeometry}}"
                        Fill="White"
                        Stretch="Uniform"/>

                </Border>

                <TextBlock
                    FontSize="{DynamicResource FontMetric}"
                    FontWeight="Bold"
                    Text="{Binding #Root.Value}"/>

                <StackPanel Spacing="1">

                    <TextBlock
                        FontSize="{DynamicResource FontCaption}"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="{Binding #Root.Subtitle}"/>

                    <TextBlock
                        FontSize="{DynamicResource FontMicro}"
                        Opacity="0.45"
                        Text="{Binding #Root.Secondary}"/>

                </StackPanel>

            </StackPanel>

        </Button>

    </Border>

</UserControl>
