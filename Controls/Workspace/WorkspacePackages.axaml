<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Workspace.WorkspacePackages"
    x:Name="Root"
    x:DataType="vm:WorkspacesViewModel"
    x:CompileBindings="False">

    <StackPanel Spacing="12">

        <StackPanel Spacing="2">

            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{Binding SelectedWorkspace.Name, ElementName=Root}"/>

            <TextBlock
                Opacity="0.7"
                Text="{Binding SelectedWorkspace.Description, ElementName=Root}"
                TextWrapping="Wrap"/>
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">

            <Border
                Padding="10,5"
                CornerRadius="{DynamicResource RadiusSmall}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">

                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding SelectedWorkspace.PackageCount, StringFormat='📦 {0} Packages', ElementName=Root}"/>
            </Border>

            <shared:AppButton
                Grid.Column="2"
                Content="＋ Add Package"
                Command="{Binding OpenPackageEditorCommand, ElementName=Root}"/>

            <shared:AppButton
                Grid.Column="3"
                Width="42"
                Padding="0"
                Content="🔄"
                ToolTip.Tip="Check installed packages"
                Command="{Binding RefreshInstallStatesCommand, ElementName=Root}"/>

            <shared:AppButton
                Grid.Column="4"
                Classes="Accent"
                Content="{Binding InstallAllLabel, ElementName=Root}"
                Command="{Binding InstallAllCommand, ElementName=Root}"/>
        </Grid>

        <Border
            IsVisible="{Binding IsPackageEditorOpen, ElementName=Root}"
            Padding="16"
            CornerRadius="{DynamicResource RadiusMedium}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

            <StackPanel Spacing="8">

                <TextBlock FontWeight="SemiBold" Text="Add package"/>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                    <shared:AppTextField
                        PlaceholderText="Package ID / name..."
                        Text="{Binding NewPackageId, ElementName=Root}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddPackageCommand, ElementName=Root}"/>
                        </TextBox.KeyBindings>
                    </shared:AppTextField>

                    <shared:AppButton
                        Grid.Column="1"
                        MinWidth="88"
                        Content="Add"
                        Command="{Binding AddPackageCommand, ElementName=Root}"/>

                    <shared:AppButton
                        Grid.Column="2"
                        Width="42"
                        Padding="0"
                        Content="✕"
                        ToolTip.Tip="Cancel"
                        Command="{Binding CancelPackageEditorCommand, ElementName=Root}"/>
                </Grid>
            </StackPanel>
        </Border>

        <ListBox
            ItemsSource="{Binding SelectedWorkspace.Packages, ElementName=Root}"
            BorderThickness="0"
            Background="Transparent">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:WorkspacePackage">

                    <Border
                        Margin="0,0,0,8"
                        Padding="12,8"
                        CornerRadius="{DynamicResource RadiusMedium}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

                            <Border
                                Padding="8,3"
                                VerticalAlignment="Center"
                                CornerRadius="20"
                                Background="{DynamicResource CardBrush}">

                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="{Binding StateText}"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">

                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis"/>

                                <TextBlock
                                    Opacity="0.7"
                                    FontSize="12"
                                    Text="{Binding Id}"
                                    TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <shared:AppButton
                                Grid.Column="2"
                                IsVisible="{Binding CanInstall}"
                                Content="Install"
                                Command="{Binding $parent[ListBox].DataContext.InstallPackageCommand}"
                                CommandParameter="{Binding}"/>

                            <shared:AppButton
                                Grid.Column="3"
                                Classes="Danger"
                                Width="42"
                                Padding="0"
                                Content="✕"
                                ToolTip.Tip="Remove from workspace"
                                Command="{Binding $parent[ListBox].DataContext.RemovePackageCommand}"
                                CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <shared:AppEmptyState
            IsVisible="{Binding !HasPackages, ElementName=Root}"
            Icon="📦"
            Title="No packages yet"
            Description="Add packages to turn this workspace into a one-click setup."/>
    </StackPanel>

</UserControl>
