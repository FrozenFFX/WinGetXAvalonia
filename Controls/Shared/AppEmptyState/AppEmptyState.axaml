<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Controls.Shared.AppEmptyState"
    x:Name="Root">

    <StackPanel
        x:Name="RootPanel"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="8"
        MaxWidth="460"
        Opacity="0"
        RenderTransform="translate(0,12px)">

        <StackPanel.Transitions>
            <Transitions>
                <DoubleTransition
                    Property="Opacity"
                    Duration="{DynamicResource MotionDurationEntrance}"
                    Easing="{DynamicResource MotionEasingOut}"/>
                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="{DynamicResource MotionDurationEntrance}"
                    Easing="{DynamicResource MotionEasingOut}"/>
            </Transitions>
        </StackPanel.Transitions>

        <Border
            Width="72"
            Height="72"
            CornerRadius="20"
            HorizontalAlignment="Center"
            Margin="0,0,0,14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

            <Path
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="34"
                Height="34"
                Data="{Binding #Root.Icon, Converter={StaticResource IconGeometry}}"
                Fill="{DynamicResource MutedTextBrush}"
                Stretch="Uniform"/>

        </Border>

        <TextBlock
            HorizontalAlignment="Center"
            TextAlignment="Center"
            FontSize="{DynamicResource FontSectionLarge}"
            FontWeight="SemiBold"
            Text="{Binding #Root.Title}"/>

        <TextBlock
            HorizontalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Foreground="{DynamicResource SubtextBrush}"
            Text="{Binding #Root.Description}"/>

        <ItemsControl
            HorizontalAlignment="Center"
            Margin="0,14,0,0"
            ItemsSource="{Binding #Root.Examples}"
            IsVisible="{Binding #Root.Examples,
            Converter={x:Static conv:ObjectConverters.IsNotNull}}">

            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,5">

                        <Border
                            Width="18"
                            Height="18"
                            CornerRadius="5"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">

                            <Path
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="12"
                                Height="12"
                                Data="{StaticResource IconSuccess}"
                                Fill="{DynamicResource SuccessBrush}"
                                Stretch="Uniform"/>

                        </Border>

                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding}"/>

                    </StackPanel>

                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <shared:AppButton
            Margin="0,18,0,0"
            HorizontalAlignment="Center"
            Content="{Binding #Root.ActionText}"
            Command="{Binding #Root.ActionCommand}"
            IsVisible="{Binding #Root.ActionCommand,
            Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>

    </StackPanel>

</UserControl>
