<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:studio="using:WinGetXAvalonia.Controls.Studio"
    x:Class="WinGetXAvalonia.Views.StudioView"
    x:Name="Root"
    x:DataType="vm:StudioViewModel">

    <UserControl.KeyBindings>
        <KeyBinding
            Gesture="F5"
            Command="{Binding RefreshCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>

        <Style Selector="ToggleButton.FilterChip">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.FilterChip:pointerover:not(:checked)">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}"/>
        </Style>

        <Style Selector="ToggleButton.FilterChip:checked">
            <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}"/>
        </Style>

    </UserControl.Styles>

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="Studio"
            Description="{Binding ToolsSummary}"/>

        <!-- Toolbar -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="16"
            CornerRadius="{DynamicResource RadiusMedium}"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                <shared:SearchBox
                    MinWidth="320"
                    MaxWidth="560"
                    HorizontalAlignment="Stretch"
                    Watermark="Search studio tools..."
                    Text="{Binding SearchText}"/>

                <shared:AppButton
                    Grid.Column="1"
                    Width="42"
                    Padding="0"
                    Content="🔄"
                    ToolTip.Tip="Refresh studio tools (F5)"
                    Command="{Binding RefreshCommand}"/>

                <Border
                    Grid.Column="2"
                    Padding="10,5"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Text="{Binding ToolCount}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Filter chips -->
        <ItemsControl
            Grid.Row="2"
            ItemsSource="{Binding Filters}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton
                        Classes="FilterChip"
                        Margin="0,0,8,8"
                        IsChecked="{Binding IsActive, Mode=OneWay}"
                        Command="{Binding $parent[ItemsControl].DataContext.SelectFilterCommand}"
                        CommandParameter="{Binding}">

                        <TextBlock Text="{Binding Label}"/>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Tools -->
        <Grid
            Grid.Row="4"
            ColumnDefinitions="*,12,360">

            <ScrollViewer
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding Tools}">

                    <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <studio:StudioTile
                                Width="336"
                                Margin="0,0,8,12"
                                Icon="{Binding Icon}"
                                Title="{Binding Title}"
                                Description="{Binding Description}"
                                Badge="{Binding Badge}"
                                BadgeStatus="{Binding BadgeStatus}"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectToolCommand}"
                                CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"/>

            <Border
                Grid.Column="2"
                Padding="24"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}">

                <Grid>

                    <StackPanel
                        Spacing="16"
                        IsVisible="{Binding IsToolSelected}">

                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="Tool Details"/>

                        <ContentControl
                            Content="{Binding SelectedTool}"/>

                    </StackPanel>

                    <ScrollViewer
                        IsVisible="{Binding !IsToolSelected}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel
                            Spacing="16">

                            <StackPanel Spacing="8">

                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="Studio"/>
                                <TextBlock
                                    Opacity="0.6"
                                    TextWrapping="Wrap"
                                    Text="Select a tool from the list to open its details."/>

                            </StackPanel>

                            <Border
                                Height="1"
                                Background="{DynamicResource BorderBrush}"/>

                            <StackPanel Spacing="8">

                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="⚡ Keyboard Shortcuts"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock
                                        Opacity="0.7"
                                        VerticalAlignment="Center"
                                        Text="Open command palette"/>
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,3"
                                        CornerRadius="6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="Ctrl + K"/>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock
                                        Opacity="0.7"
                                        VerticalAlignment="Center"
                                        Text="Refresh studio tools"/>
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,3"
                                        CornerRadius="6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="F5"/>
                                    </Border>
                                </Grid>

                            </StackPanel>

                            <Border
                                Height="1"
                                Background="{DynamicResource BorderBrush}"/>

                            <StackPanel Spacing="8">

                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="💡 Tips"/>

                                <TextBlock
                                    Opacity="0.7"
                                    TextWrapping="Wrap"
                                    Text="Use filters to focus on Ready or Experimental tools."/>
                                <TextBlock
                                    Opacity="0.7"
                                    TextWrapping="Wrap"
                                    Text="Search by name, description or category."/>

                            </StackPanel>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

            <!-- Empty state -->
            <shared:AppEmptyState
                IsVisible="{Binding IsEmpty}"
                Icon="🎛"
                Title="No studio tools found"
                Description="Try a different search or filter."/>

            <!-- Error state -->
            <shared:AppEmptyState
                IsVisible="{Binding HasError}"
                Icon="⚠️"
                Title="Couldn't load studio tools"
                Description="{Binding ErrorMessage}"
                ActionText="Retry"
                ActionCommand="{Binding RefreshCommand}"/>

        </Grid>

        <shared:LoadingOverlay
            Grid.RowSpan="5"
            IsLoading="{Binding IsLoading}"
            Message="Loading studio tools..."/>

    </Grid>

</UserControl>
