<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinGetXAvalonia.ViewModels"
             xmlns:vms="using:WinGetXAvalonia.ViewModels.Settings"
             xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
             x:Class="WinGetXAvalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>

        <Style Selector="ListBox.settings-nav ListBoxItem">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="{DynamicResource FontBody}"/>
        </Style>

        <Style Selector="ListBox.settings-nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        </Style>

        <Style Selector="ListBox.settings-nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        </Style>

    </UserControl.Styles>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

        <Grid
            Margin="24"
            ColumnDefinitions="280,8,*">

            <shared:AppCard
                Grid.Column="0"
                Padding="0">

                <Grid RowDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Row="0" Spacing="6" Margin="20,20,20,0">

                        <TextBlock
                            FontSize="{DynamicResource FontPageTitle}"
                            FontWeight="SemiBold"
                            Text="{loc:Translate Key=Settings}"/>

                        <shared:AppSeparator Margin="0,12"/>

                    </StackPanel>

                    <ListBox
                        Grid.Row="1"
                        Classes="settings-nav"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        Margin="8,0">

                        <ListBox.ItemTemplate>

                            <DataTemplate DataType="vms:SettingsCategoryViewModel">

                                <StackPanel Orientation="Horizontal" Spacing="12">

                                    <Path
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                        Fill="{DynamicResource SubtextBrush}"
                                        Stretch="Uniform"/>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource FontBody}"
                                        Text="{Binding Title}"/>

                                </StackPanel>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <StackPanel
                        Grid.Row="2"
                        Margin="20,16,20,20"
                        Spacing="12">

                        <shared:AppButton
                            HorizontalAlignment="Stretch"
                            Content="{loc:Translate Key='Toggle Theme'}"
                            Command="{Binding ToggleThemeCommand}"/>

                        <shared:AppButton
                            HorizontalAlignment="Stretch"
                            Content="{loc:Translate Key='Create Backup'}"
                            Command="{Binding BackupCommand}"/>

                        <shared:AppButton
                            HorizontalAlignment="Stretch"
                            Content="{loc:Translate Key='Restore Backup'}"
                            Command="{Binding RestoreCommand}"/>

                        <shared:AppSeparator Margin="0,8"/>

                        <TextBlock
                            FontSize="{DynamicResource FontCaption}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="WinGetX"/>

                        <TextBlock
                            FontSize="{DynamicResource FontMicro}"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="v0.2.0-alpha"/>

                    </StackPanel>

                </Grid>

            </shared:AppCard>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"/>

            <ContentControl
                Grid.Column="2"
                Content="{Binding SelectedCategory}"/>

        </Grid>

        <shared:LoadingOverlay
            IsLoading="{Binding IsLoading}"
            Message="Loading settings..."/>

    </Grid>

</UserControl>