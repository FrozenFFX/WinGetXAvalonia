<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.SecurityView"
    x:DataType="vm:SecurityViewModel">

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="Security"
            Description="Security status and package verification."/>

        <UniformGrid
            Grid.Row="2"
            Columns="4">

            <shared:AppCard>
                <StackPanel>
                    <TextBlock FontSize="22" Text="🛡"/>
                    <TextBlock FontWeight="SemiBold" Text="Trusted"/>
                    <TextBlock Text="0"/>
                </StackPanel>
            </shared:AppCard>

            <shared:AppCard>
                <StackPanel>
                    <TextBlock FontSize="22" Text="⚠"/>
                    <TextBlock FontWeight="SemiBold" Text="Warnings"/>
                    <TextBlock Text="0"/>
                </StackPanel>
            </shared:AppCard>

            <shared:AppCard>
                <StackPanel>
                    <TextBlock FontSize="22" Text="❌"/>
                    <TextBlock FontWeight="SemiBold" Text="Blocked"/>
                    <TextBlock Text="0"/>
                </StackPanel>
            </shared:AppCard>

            <shared:AppCard>
                <StackPanel>
                    <TextBlock FontSize="22" Text="✔"/>
                    <TextBlock FontWeight="SemiBold" Text="Verified"/>
                    <TextBlock Text="0"/>
                </StackPanel>
            </shared:AppCard>

        </UniformGrid>

    </Grid>

</UserControl>
