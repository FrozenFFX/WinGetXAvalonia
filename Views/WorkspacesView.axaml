<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:workspace="using:WinGetXAvalonia.Controls.Workspace"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    x:Class="WinGetXAvalonia.Views.WorkspacesView"
    x:Name="Root"
    x:DataType="vm:WorkspacesViewModel">

    <UserControl.KeyBindings>
        <KeyBinding
            Gesture="F5"
            Command="{Binding RefreshCommand}"/>
    </UserControl.KeyBindings>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="False">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <shared:SectionHeader
            Grid.Row="0"
            Title="{loc:Translate Key=&quot;Workspaces&quot;}"
            Description="{loc:TranslateBinding Path=WorkspacesSummary}"/>

        <!-- Toolbar -->
        <workspace:WorkspaceToolbar
            Grid.Row="1"
            SearchText="{Binding SearchText}"
            Summary="{Binding WorkspacesSummary}"
            CreateCommand="{Binding NewWorkspaceCommand}"
            ImportCommand="{Binding ImportCommand}"
            RefreshCommand="{Binding RefreshCommand}"/>

        <!-- Master-Detail -->
        <shared:MasterDetailPage
            Grid.Row="3"
            IsLoading="{Binding IsLoading}"
            LoadingMessage="{loc:Translate Key=&quot;Loading workspaces...&quot;}"
            DetailWidth="0.5*">

            <shared:MasterDetailPage.MasterContent>

                <Grid>

                    <ListBox
                        ItemsSource="{Binding Workspaces}"
                        SelectedItem="{Binding SelectedWorkspace}"
                        BorderThickness="0"
                        Background="Transparent">

                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <workspace:WorkspaceCard Width="360"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Empty state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding IsEmpty}"
                        Icon="workspace"
                        Title="{loc:Translate Key=&quot;No workspaces&quot;}"
                        Description="{loc:Translate Key=&quot;Create your first workspace to group package installs.&quot;}">

                        <shared:AppEmptyState.Examples>
                            <sys:String>Group related apps into one workspace</sys:String>
                            <sys:String>Export and share your setup</sys:String>
                            <sys:String>Install a whole workspace at once</sys:String>
                        </shared:AppEmptyState.Examples>

                    </shared:AppEmptyState>

                    <!-- Error state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding HasError}"
                        Icon="warning"
                        Title="{loc:Translate Key=&quot;Couldn&apos;t load workspaces&quot;}"
                        Description="{loc:TranslateBinding Path=ErrorMessage}"
                        ActionText="{loc:Translate Key=&quot;Retry&quot;}"
                        ActionCommand="{Binding RefreshCommand}"/>

                </Grid>

            </shared:MasterDetailPage.MasterContent>

            <shared:MasterDetailPage.DetailContent>

                <Border
                    Padding="24"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}">

                    <Panel>

                        <workspace:WorkspacePackages
                            IsVisible="{Binding !IsNothingSelected}"/>

                        <shared:AppEmptyState
                            IsVisible="{Binding IsNothingSelected}"
                            Icon="workspace"
                            Title="{loc:Translate Key=&quot;Select a workspace&quot;}"
                            Description="{loc:Translate Key=&quot;Choose a workspace from the list to view its packages and details.&quot;}"/>

                    </Panel>

                </Border>

            </shared:MasterDetailPage.DetailContent>

        </shared:MasterDetailPage>

        <!-- Workspace Editor Dialog -->
        <shared:AppDialog
            Grid.RowSpan="4"
            IsOpen="{Binding IsEditorOpen, Mode=TwoWay}"
            Title="{loc:TranslateBinding Path=EditorTitle}"
            ShowCloseButton="True">

            <workspace:WorkspaceEditor
                Name="{Binding NewWorkspaceName}"
                Description="{loc:TranslateBinding Path=NewWorkspaceDescription}"
                SaveCommand="{Binding SaveWorkspaceCommand}"
                SaveButtonText="{Binding EditorAction}"
                CancelCommand="{Binding CancelWorkspaceEditorCommand}"/>

        </shared:AppDialog>

        <!-- Add Package Dialog -->
        <shared:AppDialog
            Grid.RowSpan="4"
            IsOpen="{Binding IsPackageEditorOpen, Mode=TwoWay}"
            Title="{loc:Translate Key=&quot;Add Package&quot;}"
            ShowCloseButton="True">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                <StackPanel Spacing="8">

                    <TextBox
                        Text="{Binding NewPackageId, Mode=TwoWay}"
                        PlaceholderText="{loc:Translate Key=&quot;Package ID / name&quot;}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddPackageCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>

                    <TextBox
                        Text="{Binding NewPackageName, Mode=TwoWay}"
                        PlaceholderText="{loc:Translate Key=&quot;Display name (optional)&quot;}"/>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">

                    <shared:AppButton
                        Classes="ghost"
                        Content="{loc:Translate Key=&quot;Cancel&quot;}"
                        Command="{Binding CancelPackageEditorCommand}"/>

                    <shared:AppButton
                        Classes="Accent"
                        Content="{loc:Translate Key=&quot;Add&quot;}"
                        Command="{Binding AddPackageCommand}"/>

                </StackPanel>

            </Grid>

        </shared:AppDialog>

    </Grid>

</UserControl>
