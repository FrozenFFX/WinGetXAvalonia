<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinGetXAvalonia.ViewModels"
             xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:package="using:WinGetXAvalonia.Controls.Package"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="WinGetXAvalonia.Views.BrowseView"
             x:DataType="vm:BrowseViewModel"
             x:CompileBindings="False">

    <Grid Margin="20"
          ColumnDefinitions="*,12,400">

        <!-- sol taraf: featured, kategoriler, arama, sonuçlar -->
        <Grid Grid.Column="0"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">

            <shared:SectionHeader
                Title="Featured"
                Description="Hand-picked by the community"/>

            <ListBox
                Grid.Row="1"
                Margin="0,4,0,0"
                Height="170"
                ItemsSource="{Binding Featured}"
                SelectedItem="{Binding SelectedPackage}"
                BorderThickness="0"
                Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <package:BrowseCard Width="380"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <shared:SectionHeader
                Grid.Row="2"
                Margin="0,20,0,0"
                Title="Categories"
                Description="Browse by topic"/>

            <ItemsControl
                Grid.Row="3"
                Margin="0,8,0,0"
                ItemsSource="{Binding Categories}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,0,8,8"
                            HorizontalContentAlignment="Center"
                            Command="{Binding $parent[ItemsControl].DataContext.SelectCategoryCommand}"
                            CommandParameter="{Binding}">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Icon}"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <shared:SectionHeader
                Grid.Row="4"
                Margin="0,20,0,0"
                Title="Search"
                Description="Find packages to install"/>

            <Grid
                Grid.Row="5"
                Margin="0,8,0,0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">

                <AutoCompleteBox
                    ItemsSource="{Binding Suggestions}"
                    Text="{Binding SearchText, Mode=TwoWay}"
                    SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                    FilterMode="None"
                    MinimumPrefixLength="2"
                    PlaceholderText="Search packages...">

                    <AutoCompleteBox.KeyBindings>
                        <KeyBinding
                            Gesture="Enter"
                            Command="{Binding SearchCommand}"/>
                    </AutoCompleteBox.KeyBindings>
                </AutoCompleteBox>

                <Button
                    Grid.Column="1"
                    MinWidth="110"
                    Content="Search"
                    Command="{Binding SearchCommand}"/>
            </Grid>

            <shared:SectionHeader
                Grid.Row="6"
                Margin="0,20,0,0"
                Title="Results"
                Description="{Binding ResultsSummary}"/>

            <Grid Grid.Row="7" Margin="0,4,0,0">

                <ListBox
                    ItemsSource="{Binding Results}"
                    SelectedItem="{Binding SelectedPackage}"
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.IsDeferredScrollingEnabled="True"
                    shared:ScrollToTopBehavior.ScrollToTopOnReset="True">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel CacheLength="0.5"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <package:BrowseCard/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

                <shared:LoadingOverlay
                    IsLoading="{Binding IsLoading}"
                    Message="Searching packages..."/>

                <!-- Empty state -->
                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    MaxWidth="480"
                    IsVisible="{Binding IsEmpty}">

                    <StackPanel Spacing="12">

                        <TextBlock
                            Text="🔍"
                            FontSize="46"
                            Opacity="0.35"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="No packages found"
                            FontSize="18"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Try another package name or category."
                            Opacity="0.65"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"/>

                        <Button
                            Margin="0,8,0,0"
                            Content="Clear Search"
                            Command="{Binding ClearSearchCommand}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Error state -->
                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    MaxWidth="480"
                    IsVisible="{Binding HasError}">

                    <StackPanel Spacing="12">

                        <TextBlock
                            Text="⚠️"
                            FontSize="46"
                            Opacity="0.5"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Unable to load packages"
                            FontSize="18"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Reason:"
                            Opacity="0.7"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="{Binding ErrorMessage}"
                            Foreground="{DynamicResource DangerBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"/>

                        <Button
                            Margin="0,8,0,0"
                            Content="Retry"
                            Command="{Binding SearchCommand}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>

        </Grid>

        <GridSplitter
            Grid.Column="1"
            Width="6"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"/>

        <!-- sağ tarafta seçilen paketin detay paneli -->
        <Border
            Grid.Column="2"
            Margin="16,0,0,0"
            VerticalAlignment="Stretch"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusLarge}">

            <Grid>

            <!-- Boş durum: hiç paket seçilmedi -->
            <StackPanel
                Spacing="12"
                IsVisible="{Binding SelectedDetails.SelectedPackage,
                Converter={x:Static conv:ObjectConverters.IsNull}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBlock
                    Text="📦"
                    FontSize="46"
                    Opacity="0.35"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Select a package to view details."
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="240"/>
            </StackPanel>

            <!-- Detay içeriği -->
            <ScrollViewer
                IsVisible="{Binding SelectedDetails.SelectedPackage,
                Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                VerticalScrollBarVisibility="Auto">

                <Border Padding="24">

                    <StackPanel Spacing="14">

                    <!-- başlık: 64px ikon + ad -->
                    <StackPanel Orientation="Horizontal" Spacing="16">

                        <Border
                            Width="64"
                            Height="64"
                            CornerRadius="12"
                            Background="{DynamicResource SurfaceBrush}">

                            <TextBlock
                                Text="{Binding SelectedDetails.SelectedPackage.Icon}"
                                FontSize="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Spacing="4"
                            VerticalAlignment="Center">

                            <TextBlock
                                FontSize="{DynamicResource FontTitle}"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedDetails.SelectedPackage.Name}"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                FontSize="{DynamicResource FontBody}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Text="{Binding SelectedDetails.SelectedPackage.Id}"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                FontSize="{DynamicResource FontCaption}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Opacity="0.7"
                                Text="{Binding SelectedDetails.SelectedPackage.Source}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Kur / Güncelle -->
                    <Button
                        Content="{Binding SelectedDetails.SelectedPackage.InstallButtonText}"
                        Command="{Binding InstallOrUpdateCommand}"
                        CommandParameter="{Binding SelectedDetails.SelectedPackage}"
                        IsEnabled="{Binding SelectedDetails.SelectedPackage.CanInstall}"
                        Height="42"
                        HorizontalAlignment="Stretch"/>

                    <ProgressBar
                        IsIndeterminate="True"
                        IsVisible="{Binding SelectedDetails.SelectedPackage.IsBusy}"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}"/>

                    <!-- Versiyonlar: iki sütun -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">

                        <TextBlock
                            FontSize="{DynamicResource FontCaption}"
                            Foreground="{DynamicResource SubtextBrush}"
                            Opacity="0.7"
                            Text="Installed"/>

                        <TextBlock
                            Grid.Column="1"
                            FontSize="{DynamicResource FontCaption}"
                            Foreground="{DynamicResource SubtextBrush}"
                            Opacity="0.7"
                            Text="Available"/>

                        <TextBlock
                            Grid.Row="1"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedDetails.SelectedPackage.InstalledVersionDisplay}"/>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentBrush}"
                            Text="{Binding SelectedDetails.SelectedPackage.AvailableVersionDisplay}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}"/>

                    <!-- Health Score -->
                    <StackPanel Spacing="10">

                        <Grid
                            ColumnDefinitions="Auto,12,*,Auto"
                            ColumnSpacing="8">

                            <TextBlock
                                FontSize="{DynamicResource FontCaption}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Opacity="0.7"
                                Text="Health Score"
                                VerticalAlignment="Center"/>

                            <ProgressBar
                                Grid.Column="2"
                                Minimum="0"
                                Maximum="100"
                                Height="6"
                                Value="{Binding SelectedDetails.HealthScore}"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="3"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedDetails.HealthScoreLabel}"
                                VerticalAlignment="Center"/>
                        </Grid>

                        <Grid
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            ColumnDefinitions="*,*">

                            <TextBlock
                                FontSize="{DynamicResource FontCaption}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Opacity="0.7"
                                Text="Source Trust"/>

                            <TextBlock
                                Grid.Column="1"
                                FontSize="{DynamicResource FontCaption}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Opacity="0.7"
                                Text="Update Frequency"/>

                            <TextBlock
                                Grid.Row="1"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedDetails.SourceTrustLabel}"/>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedDetails.UpdateFrequencyLabel}"/>

                            <TextBlock
                                Grid.Row="2"
                                FontSize="{DynamicResource FontCaption}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Opacity="0.7"
                                Text="Latest Version"/>

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                FontSize="{DynamicResource FontCaption}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Opacity="0.7"
                                Text="Publisher"/>

                            <TextBlock
                                Grid.Row="3"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="{Binding SelectedDetails.LatestVersionLabel}"/>

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="{Binding SelectedDetails.PublisherLabel}"/>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}"/>

                    <!-- Description -->
                    <StackPanel Spacing="4">

                        <TextBlock
                            FontSize="{DynamicResource FontCaption}"
                            Foreground="{DynamicResource SubtextBrush}"
                            Opacity="0.7"
                            Text="Description"/>

                        <TextBlock
                            FontSize="{DynamicResource FontBody}"
                            Foreground="{DynamicResource SubtextBrush}"
                            Text="{Binding SelectedDetails.DescriptionDisplay}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Publisher -->
                    <StackPanel Spacing="4">

                        <TextBlock
                            FontSize="{DynamicResource FontCaption}"
                            Foreground="{DynamicResource SubtextBrush}"
                            Opacity="0.7"
                            Text="Publisher"/>

                        <TextBlock
                            FontSize="{DynamicResource FontBody}"
                            Foreground="{DynamicResource SubtextBrush}"
                            Text="{Binding SelectedDetails.PublisherDisplay}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Homepage + Copy ID -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">

                        <Button
                            Content="Open Homepage"
                            Height="38"
                            Command="{Binding OpenHomepageCommand}"
                            CommandParameter="{Binding SelectedDetails}"
                            IsVisible="{Binding SelectedDetails.HasHomepage}"/>

                        <Button
                            Grid.Column="1"
                            Height="38"
                            Content="Copy Package ID"
                            Command="{Binding CopyIdCommand}"
                            CommandParameter="{Binding SelectedDetails.SelectedPackage}"/>
                    </Grid>

                    <!-- License -->
                    <StackPanel Spacing="4">

                        <TextBlock
                            FontSize="{DynamicResource FontCaption}"
                            Foreground="{DynamicResource SubtextBrush}"
                            Opacity="0.7"
                            Text="License"/>

                        <TextBlock
                            FontSize="{DynamicResource FontBody}"
                            Foreground="{DynamicResource SubtextBrush}"
                            Text="{Binding SelectedDetails.LicenseDisplay}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Release Notes -->
                    <StackPanel Spacing="4">

                        <TextBlock
                            FontSize="{DynamicResource FontCaption}"
                            Foreground="{DynamicResource SubtextBrush}"
                            Opacity="0.7"
                            Text="Release Notes"/>

                        <TextBlock
                            FontSize="{DynamicResource FontBody}"
                            Foreground="{DynamicResource SubtextBrush}"
                            Text="{Binding SelectedDetails.ReleaseNotesDisplay}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                    </StackPanel>

                </Border>
            </ScrollViewer>

            <Border
                IsVisible="{Binding SelectedDetails.SelectedPackage.IsBusy}"
                Background="#66000000"/>

            <shared:LoadingOverlay
                IsLoading="{Binding SelectedDetails.IsLoading}"
                Message="Loading package details..."/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
