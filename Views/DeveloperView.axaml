<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.DeveloperView"
    x:DataType="vm:DeveloperViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="24" Spacing="16">

                <StackPanel Spacing="4">

                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="{loc:Translate Key=&quot;Developer&quot;}"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="{loc:Translate Key=&quot;Developer tools and diagnostics.&quot;}"/>

                </StackPanel>

                <StackPanel Spacing="16">

                    <shared:SectionHeader Title="{loc:Translate Key=&quot;Queue&quot;}"/>

                    <shared:AppCard>

                        <Grid ColumnDefinitions="*,*,*,*">

                            <StackPanel Spacing="4">
                                <TextBlock Opacity="0.6" Text="{loc:Translate Key=&quot;Running&quot;}"/>
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="{loc:TranslateBinding Path=Queue.RunningCount}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Opacity="0.6" Text="{loc:Translate Key=&quot;Completed&quot;}"/>
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="{loc:TranslateBinding Path=Queue.CompletedCount}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Opacity="0.6" Text="{loc:Translate Key=&quot;Failed&quot;}"/>
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="{loc:TranslateBinding Path=Queue.FailedCount}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Opacity="0.6" Text="{loc:Translate Key=&quot;Cancelled&quot;}"/>
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="{loc:TranslateBinding Path=Queue.CancelledCount}"/>
                            </StackPanel>

                        </Grid>

                    </shared:AppCard>

                    <shared:SectionHeader Title="{loc:Translate Key=&quot;Performance&quot;}"/>

                    <shared:AppCard>

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="10">

                            <TextBlock Opacity="0.6" Text="{loc:Translate Key=&quot;Memory&quot;}"/>
                            <TextBlock Grid.Column="1" Text="{loc:TranslateBinding Path=Snapshot.Memory}"/>

                            <TextBlock Grid.Row="1" Opacity="0.6" Text="{loc:Translate Key=&quot;Threads&quot;}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:TranslateBinding Path=Snapshot.Threads}"/>

                            <TextBlock Grid.Row="2" Opacity="0.6" Text="{loc:Translate Key=&quot;Handles&quot;}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:TranslateBinding Path=Snapshot.Handles}"/>

                            <TextBlock Grid.Row="3" Opacity="0.6" Text="{loc:Translate Key=&quot;CPU Time&quot;}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:TranslateBinding Path=Snapshot.CpuTime}"/>

                        </Grid>

                    </shared:AppCard>

                    <shared:SectionHeader Title="{loc:Translate Key=&quot;Live Operations&quot;}"/>

                    <controls:QueuePanel
                        Margin="0,8,0,0"
                        DataContext="{Binding Queue}"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

        <shared:AppEmptyState
            IsVisible="{Binding IsEmpty}"
            Icon="developer"
            Title="{loc:Translate Key=&quot;No developer tools&quot;}"
            Description="{loc:Translate Key=&quot;Developer tools will appear here.&quot;}"/>

        <shared:AppEmptyState
            IsVisible="{Binding HasError}"
            Icon="warning"
            Title="{loc:Translate Key=&quot;Something went wrong&quot;}"
            Description="{loc:TranslateBinding Path=ErrorMessage}"
            ActionText="{loc:Translate Key=&quot;Retry&quot;}"
            ActionCommand="{Binding RefreshCommand}"/>

        <shared:LoadingOverlay
            IsLoading="{Binding IsLoading}"
            Message="{loc:Translate Key=&quot;Loading developer tools...&quot;}"/>

    </Grid>

</UserControl>
