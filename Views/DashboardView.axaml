<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:notifications="using:WinGetXAvalonia.Services.Notifications"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:cards="using:WinGetXAvalonia.Controls.Cards"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.DashboardView"
    x:Name="Root"
    x:DataType="vm:DashboardViewModel">

    <Grid
        RowDefinitions="Auto,12,*">

        <!-- Header + Notification Bell -->

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="16">

            <shared:PageHeader
                Grid.Column="0"
                Title="{loc:TranslateBinding Path=GreetingText}"
                Description="{loc:Translate Key=&quot;Manage packages and monitor your system.&quot;}"/>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">

                <shared:AppButton
                    Height="38"
                    MinWidth="96"
                    Classes="ghost"
                    Content="{loc:Translate Key=&quot;Refresh&quot;}"
                    Command="{Binding RefreshCommand}"/>

                <ProgressBar
                    Width="20"
                    Height="20"
                    IsIndeterminate="True"
                    IsVisible="{Binding IsRefreshing}"/>

                <controls:NotificationBell
                    DataContext="{Binding Notifications}"/>

            </StackPanel>

        </Grid>

        <!-- Main Content | System -->

        <Grid
            Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition
                    Width="{Binding SystemPanelVisible, Converter={StaticResource SystemPanelWidthConverter}}"
                    MaxWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ======================= MAIN CONTENT ======================= -->

            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                HorizontalContentAlignment="Stretch">

                <StackPanel
                    Spacing="20"
                    Margin="0,0,0,16">

                    <!-- Stats (responsive grid with minimum widths) -->

                    <UniformGrid
                        Columns="{Binding #Root.Bounds.Width, Converter={StaticResource StatColumnsConverter}}"
                        HorizontalAlignment="Stretch">

                        <cards:StatCard
                            Icon="package"
                            Secondary="{Binding FavoritesDisplay, StringFormat='{}{0} favorites'}"
                            Subtitle="Installed"
                            Value="{Binding InstalledDisplay}"
                            Command="{Binding OpenPackagesCommand}"/>

                        <cards:StatCard
                            Icon="update"
                            Secondary="{Binding UpdatesDisplay, StringFormat='{}{0} pending'}"
                            Subtitle="Updates"
                            Value="{Binding UpdatesDisplay}"
                            Command="{Binding OpenUpdatesCommand}"/>

                        <cards:StatCard
                            Icon="history"
                            Subtitle="History"
                            Value="{Binding HistoryDisplay}"
                            Command="{Binding OpenHistoryCommand}"/>

                        <cards:StatCard
                            Icon="source"
                            Secondary="{Binding FavoritesDisplay, StringFormat='{}{0} pinned'}"
                            Subtitle="Sources"
                            Value="{Binding SourcesDisplay}"
                            Command="{Binding RefreshSourcesCommand}"/>

                    </UniformGrid>

                    <!-- Update All: progress strip -->

                    <Border
                        IsVisible="{Binding IsUpdateAllRunning}"
                        Padding="16,12"
                        CornerRadius="12"
                        BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}">

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">

                            <ProgressBar
                                Grid.Column="0"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                IsIndeterminate="True"/>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">

                                <TextBlock
                                    FontSize="{DynamicResource FontCaption}"
                                    FontWeight="SemiBold"
                                    Text="{loc:TranslateBinding Path=UpdateAllStatus}"/>

                                <TextBlock
                                    FontSize="{DynamicResource FontSecondary}"
                                    Opacity="0.6"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{loc:TranslateBinding Path=UpdateAllCurrentPackage}"/>

                            </StackPanel>

                            <shared:AppButton
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Classes="ghost"
                                Content="{loc:Translate Key=&quot;Cancel&quot;}"
                                Command="{Binding CancelUpdateAllCommand}"/>

                        </Grid>

                    </Border>

                    <!-- Update All: result -->

                    <Border
                        IsVisible="{Binding UpdateAllResultText, Converter={StaticResource NullToBoolConverter}}"
                        Padding="16,12"
                        CornerRadius="12"
                        BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}">

                        <TextBlock
                            FontSize="{DynamicResource FontCaption}"
                            Text="{loc:TranslateBinding Path=UpdateAllResultText}"
                            TextWrapping="Wrap"/>

                    </Border>

                    <!-- Recent Activity | Notifications -->

                    <Grid
                        ColumnDefinitions="1.3*,18,1*"
                        VerticalAlignment="Stretch">

                        <!-- Recent Activity -->

                        <cards:AppCard
                            Grid.Column="0"
                            VerticalAlignment="Stretch">

                            <StackPanel Spacing="16">

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        FontSize="{DynamicResource FontSectionLarge}"
                                        FontWeight="SemiBold"
                                        Text="{loc:Translate Key=&quot;Recent Activity&quot;}"/>

                                    <shared:AppButton
                                        Grid.Column="1"
                                        Classes="ghost"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        ToolTip.Tip="{loc:Translate Key=&quot;Refresh&quot;}"
                                        Command="{Binding RefreshCommand}">

                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="{StaticResource IconRefresh}"
                                            Fill="{DynamicResource TextBrush}"
                                            Stretch="Uniform"/>
                                    </shared:AppButton>

                                </Grid>

                                <ItemsControl
                                    ItemsSource="{Binding Activity}"
                                    IsVisible="{Binding HasActivity}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ActivityItem">

                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="14"
                                                CornerRadius="12"
                                                Background="{DynamicResource SurfaceBrush}">

                                                <Grid
                                                    ColumnDefinitions="44,*,Auto"
                                                    ColumnSpacing="12">

                                                    <Border
                                                        Width="42"
                                                        Height="42"
                                                        CornerRadius="21"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}">

                                                        <Path
                                                                Width="22"
                                                                Height="22"
                                                                Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                                                Fill="White"
                                                                Stretch="Uniform"/>

                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontButton}"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis"
                                                            Text="{loc:TranslateBinding Path=Title}"/>

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontSecondary}"
                                                            Opacity="0.55"
                                                            Text="{Binding Timestamp, StringFormat='{}{0:dd.MM HH:mm}'}"/>

                                                    </StackPanel>

                                                    <Border
                                                        Grid.Column="2"
                                                        Padding="10,4"
                                                        CornerRadius="20"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSubtle}">

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontMicro}"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{loc:TranslateBinding Path=Type}"/>

                                                    </Border>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <shared:EmptyState
                                    IsVisible="{Binding HasNoActivity}"
                                    HorizontalAlignment="Center"
                                    Icon="package"
                                    Title="{loc:Translate Key=&quot;No recent activity&quot;}"
                                    Description="{loc:Translate Key=&quot;Install a package to begin.&quot;}"/>

                            </StackPanel>

                        </cards:AppCard>

                        <Border
                            Grid.Column="1"
                            Width="1"
                            Margin="0,8"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource BorderBrush}"/>

                        <!-- Notifications -->

                        <cards:InfoCard
                            Grid.Column="2"
                            VerticalAlignment="Stretch"
                            Command="{Binding ShowNotificationsDetailsCommand}">

                            <StackPanel Spacing="14">

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        FontSize="{DynamicResource FontSectionLarge}"
                                        FontWeight="SemiBold"
                                        Text="{loc:Translate Key=&quot;Notifications&quot;}"/>

                                    <shared:AppButton
                                        Grid.Column="1"
                                        Classes="ghost"
                                        Height="34"
                                        Padding="12,0"
                                        Content="{loc:Translate Key=&quot;View all →&quot;}"
                                        Command="{Binding ShowNotificationsDetailsCommand}"/>

                                </Grid>

                                <ItemsControl
                                    ItemsSource="{Binding Notifications.Items}"
                                    IsVisible="{Binding HasNotifications}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="notifications:NotificationModel">

                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="{DynamicResource SurfaceBrush}">

                                                <Grid
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="10">

                                                    <StackPanel Spacing="2">

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontCaption}"
                                                            FontWeight="SemiBold"
                                                            Text="{loc:TranslateBinding Path=Title}"/>

                                                        <TextBlock
                                                            FontSize="{DynamicResource FontSecondary}"
                                                            Opacity="0.6"
                                                            Text="{loc:TranslateBinding Path=Message}"
                                                            TextWrapping="Wrap"/>

                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="{DynamicResource FontMicro}"
                                                        Opacity="0.5"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"/>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <shared:EmptyState
                                    IsVisible="{Binding HasNoNotifications}"
                                    HorizontalAlignment="Center"
                                    Icon="notification"
                                    Title="{loc:Translate Key=&quot;No notifications&quot;}"
                                    Description="{loc:Translate Key=&quot;Everything is working normally.&quot;}"/>

                            </StackPanel>

                        </cards:InfoCard>

                    </Grid>

                    <!-- Quick Actions | Favorite Sources -->

                    <Grid
                        ColumnDefinitions="*,18,*">

                        <!-- Quick Actions -->

                        <cards:AppCard
                            Grid.Column="0"
                            VerticalAlignment="Stretch">

                            <StackPanel Spacing="16">

                                <TextBlock
                                    FontSize="{DynamicResource FontSectionLarge}"
                                    FontWeight="SemiBold"
                                    Text="{loc:Translate Key=&quot;Quick Actions&quot;}"/>

                                <Grid
                                    ColumnDefinitions="*,*"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="10"
                                    RowSpacing="10">

                                    <cards:ActionCard
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Icon="package"
                                        Title="{loc:Translate Key=&quot;Installed&quot;}"
                                        Description="{loc:Translate Key=&quot;Manage packages&quot;}"
                                        Command="{Binding OpenPackagesCommand}"/>

                                    <cards:ActionCard
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Icon="update"
                                        Title="{loc:Translate Key=&quot;Update All&quot;}"
                                        Description="{loc:Translate Key=&quot;Upgrade packages&quot;}"
                                        Command="{Binding UpdateAllCommand}"/>

                                    <cards:ActionCard
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Icon="search"
                                        Title="{loc:Translate Key=&quot;Browse&quot;}"
                                        Description="{loc:Translate Key=&quot;Search packages&quot;}"
                                        Command="{Binding BrowseCommand}"/>

                                    <cards:ActionCard
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Icon="history"
                                        Title="{loc:Translate Key=&quot;History&quot;}"
                                        Description="{loc:Translate Key=&quot;Recent operations&quot;}"
                                        Command="{Binding OpenHistoryCommand}"/>

                                </Grid>

                            </StackPanel>

                        </cards:AppCard>

                        <Border
                            Grid.Column="1"
                            Width="1"
                            Margin="0,8"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource BorderBrush}"/>

                        <!-- Favorite Sources -->

                        <cards:InfoCard
                            Grid.Column="2"
                            VerticalAlignment="Stretch">

                            <StackPanel Spacing="14">

                                <TextBlock
                                    FontSize="{DynamicResource FontSectionLarge}"
                                    FontWeight="SemiBold"
                                    Text="{loc:Translate Key=&quot;Favorite Sources&quot;}"/>

                                <ItemsControl
                                    ItemsSource="{Binding FavoriteSources}"
                                    IsVisible="{Binding HasFavoriteSources}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FavoriteSource">

                                            <Grid
                                                Margin="0,0,0,8"
                                                ColumnDefinitions="*,Auto">

                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center"
                                                    Text="{loc:TranslateBinding Path=Name}"/>

                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,3"
                                                    CornerRadius="12"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource SurfaceBrush}">

                                                    <Grid
                                                        ColumnDefinitions="Auto,Auto"
                                                        ColumnSpacing="5">

                                                        <Border
                                                            Width="6"
                                                            Height="6"
                                                            CornerRadius="3"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource SuccessBrush}"/>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="{DynamicResource FontMicro}"
                                                            Opacity="0.6"
                                                            Text="{loc:Translate Key=&quot;Online&quot;}"/>

                                                    </Grid>

                                                </Border>

                                            </Grid>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <shared:EmptyState
                                    IsVisible="{Binding HasNoFavoriteSources}"
                                    HorizontalAlignment="Center"
                                    Icon="favorite"
                                    Title="{loc:Translate Key=&quot;No pinned sources&quot;}"
                                    Description="{loc:Translate Key=&quot;Pin frequently used sources here.&quot;}"/>

                            </StackPanel>

                        </cards:InfoCard>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

            <!-- Separator -->

            <Border
                Grid.Column="1"
                Width="1"
                Margin="0,8"
                VerticalAlignment="Stretch"
                Background="{DynamicResource BorderBrush}"/>

            <!-- ======================= SYSTEM ======================= -->

            <Border
                Grid.Column="2"
                CornerRadius="16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource CardBrush}">

                <Grid
                    RowDefinitions="Auto,Auto,*">

                    <!-- Header + Close -->

                    <Grid
                        Grid.Row="0"
                        Margin="20,16,12,14"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">

                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="2">

                            <TextBlock
                                FontSize="{DynamicResource FontSectionLarge}"
                                FontWeight="SemiBold"
                                Text="{loc:Translate Key=&quot;System&quot;}"/>

                            <TextBlock
                                FontSize="{DynamicResource FontSecondary}"
                                Opacity="0.6"
                                Text="{loc:TranslateBinding Path=OsSubtitle}"/>

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="8"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseSystemPanelCommand}"
                            ToolTip.Tip="{loc:Translate Key=&quot;Close&quot;}">

                            <Path
                                Width="14"
                                Height="14"
                                Data="{StaticResource IconClose}"
                                Fill="{DynamicResource SubtextBrush}"
                                Stretch="Uniform"/>
                        </Button>

                    </Grid>

                    <Border
                        Grid.Row="1"
                        Height="1"
                        Margin="0,0,0,16"
                        Background="{DynamicResource BorderBrush}"/>

                    <!-- Scrollable content -->

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalContentAlignment="Stretch">

                        <StackPanel
                            Spacing="16"
                            Margin="20,0,20,20">

                            <!-- OS summary (compact) -->

                            <Border
                                Padding="12"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                Background="{DynamicResource SurfaceBrush}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                                    <Border
                                        Width="38"
                                        Height="38"
                                        CornerRadius="19"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentSubtle}">

                                        <Path
                                            Width="20"
                                            Height="20"
                                            Margin="9"
                                            Data="{StaticResource IconWindows}"
                                            Fill="{DynamicResource AccentBrush}"
                                            Stretch="Uniform"/>

                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="1">

                                        <TextBlock
                                            FontSize="{DynamicResource FontCardTitle}"
                                            FontWeight="SemiBold"
                                            Text="{loc:TranslateBinding Path=OsDisplayName}"/>

                                        <TextBlock
                                            FontSize="{DynamicResource FontCaption}"
                                            Opacity="0.6"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{loc:TranslateBinding Path=OsSubtitle}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- Hero Info Chips -->

                            <ItemsControl ItemsSource="{Binding HeroInfo}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Left"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HeroInfoItem">

                                        <Border
                                            Margin="0,0,8,8"
                                            Padding="10,6"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceBrush}">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6">

                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                                    Fill="{DynamicResource AccentBrush}"
                                                    Stretch="Uniform"/>

                                                <TextBlock
                                                    FontSize="{DynamicResource FontMicro}"
                                                    Opacity="0.6"
                                                    VerticalAlignment="Center"
                                                    Text="{loc:TranslateBinding Path=Label}"/>

                                                <TextBlock
                                                    FontSize="{DynamicResource FontMicro}"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center"
                                                    Text="{loc:TranslateBinding Path=Value}"/>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- Live system cards -->

                            <ItemsControl ItemsSource="{Binding SystemCards}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SystemCardModel">

                                        <Border
                                            Margin="0,0,0,6"
                                            Padding="8,7"
                                            CornerRadius="10"
                                            Background="{DynamicResource SurfaceBrush}">

                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="8">

                                                <Path
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                                                    Fill="{DynamicResource SubtextBrush}"
                                                    Stretch="Uniform"/>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="1">

                                                    <TextBlock
                                                        FontSize="{DynamicResource FontMicro}"
                                                        Opacity="0.6"
                                                        Text="{loc:TranslateBinding Path=Title}"/>

                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSecondary}"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{loc:TranslateBinding Path=Value}"
                                                        Text="{loc:TranslateBinding Path=Value}"/>

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- System Health -->

                            <cards:InfoCard
                                Command="{Binding ShowHealthDetailsCommand}">

                                <StackPanel Spacing="12">

                                    <TextBlock
                                        FontSize="{DynamicResource FontSectionLarge}"
                                        FontWeight="SemiBold"
                                        Text="{loc:Translate Key=&quot;System Health&quot;}"/>

                                    <ProgressBar
                                        Height="8"
                                        Maximum="100"
                                        Value="{Binding HealthProgressValue}"/>

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Opacity="0.6"
                                            Text="{loc:Translate Key=&quot;Health Score&quot;}"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Text="{loc:TranslateBinding Path=HealthScoreDisplay}"/>

                                    </Grid>

                                    <TextBlock
                                        FontSize="{DynamicResource FontCaption}"
                                        Opacity="0.6"
                                        Text="{loc:TranslateBinding Path=HealthStatusText}"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        FontSize="{DynamicResource FontCaption}"
                                        Opacity="0.6"
                                        Text="{loc:TranslateBinding Path=HealthFactorsText}"
                                        TextWrapping="Wrap"
                                        IsVisible="{Binding IsHealthLoaded}"/>

                                </StackPanel>

                            </cards:InfoCard>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

        <shared:AppEmptyState
            IsVisible="{Binding HasError}"
            Icon="warning"
            Title="{loc:Translate Key=&quot;Something went wrong&quot;}"
            Description="{loc:TranslateBinding Path=ErrorMessage}"
            ActionText="{loc:Translate Key=&quot;Retry&quot;}"
            ActionCommand="{Binding RefreshCommand}"/>

        <shared:LoadingOverlay
            IsLoading="{Binding IsLoading}"
            Message="{loc:Translate Key=&quot;Loading dashboard...&quot;}"/>

    </Grid>

</UserControl>
