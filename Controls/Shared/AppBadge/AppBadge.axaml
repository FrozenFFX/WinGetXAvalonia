<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinGetXAvalonia.Controls.Shared.AppBadge"
    x:Name="Root">

    <Border
        Padding="10,4"
        CornerRadius="{DynamicResource RadiusXL}"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        DataContext="{Binding #Root}">

        <TextBlock
            FontSize="{DynamicResource FontSecondary}"
            FontWeight="SemiBold"
            Text="{loc:TranslateBinding Path=Text}"/>

    </Border>

</UserControl>
