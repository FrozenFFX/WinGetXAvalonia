<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinGetXAvalonia.ViewModels"
             xmlns:models="using:WinGetXAvalonia.Models"
             x:Class="WinGetXAvalonia.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">
    <!-- WinGetX - https://github.com/FrozenFFX -->

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="34"
            FontWeight="Bold"
            Text="Discover"/>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="10">

            <TextBox
                Width="400"
                PlaceholderText="Search package..."
                Text="{Binding SearchText}"/>

            <Button
                Content="Search"
                Command="{Binding SearchCommand}"/>

        </StackPanel>

        <ListBox
            Grid.Row="4"
            ItemsSource="{Binding Results}">

            <ListBox.ItemTemplate>

                <DataTemplate DataType="models:PackageModel">

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <TextBlock Text="{Binding Icon}"/>

                        <TextBlock Text="{Binding Name}"/>

                        <TextBlock
                            Opacity="0.6"
                            Text="{Binding Version}"/>

                    </StackPanel>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>


    <!-- kaneki -->
    </Grid>

</UserControl>
