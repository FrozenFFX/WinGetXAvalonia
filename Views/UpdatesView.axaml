<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:package="using:WinGetXAvalonia.Controls.Package"
    x:Class="WinGetXAvalonia.Views.UpdatesView"
    x:Name="Root"
    x:DataType="vm:UpdatesViewModel">

    <UserControl.KeyBindings>
        <KeyBinding
            Gesture="F5"
            Command="{Binding RefreshCommand}"/>
    </UserControl.KeyBindings>

    <Grid
        Margin="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <shared:SectionHeader
            Grid.Row="0"
            Title="Updates"
            Description="Manage available package updates."
            ActionText="Refresh"
            ActionCommand="{Binding RefreshCommand}"/>

        <!-- Toolbar -->
        <package:PackageToolbar
            Grid.Row="1"
            SearchText="{Binding SearchText}"
            PackageCount="{Binding PackageCount}"
            RefreshCommand="{Binding RefreshCommand}"
            SelectedSort="{Binding SelectedSort}"
            SelectedFilter="{Binding SelectedFilter}"
            ActionText="⬆️ Upgrade All"
            ActionCommand="{Binding UpgradeAllCommand}"/>

        <!-- Master-Detail -->
        <shared:MasterDetailPage
            Grid.Row="3"
            IsLoading="{Binding IsLoading}"
            LoadingMessage="Checking for package updates..."
            DetailWidth="{Binding SelectedPackage,
            Converter={StaticResource DetailWidthConverter}}">

            <shared:MasterDetailPage.MasterContent>

                <Grid>

                    <ListBox
                        ItemsSource="{Binding Updates}"
                        SelectedItem="{Binding SelectedPackage}"
                        BorderThickness="0"
                        Background="Transparent"
                        ScrollViewer.IsDeferredScrollingEnabled="True">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel CacheLength="0.5"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:PackageCard Mode="Updates"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Empty state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding IsEmpty}"
                        Icon="⬆️"
                        Title="No updates available"
                        Description="All packages are up to date."/>

                    <!-- Error state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding HasError}"
                        Icon="⚠️"
                        Title="Couldn't load updates"
                        Description="{Binding ErrorMessage}"
                        ActionText="Retry"
                        ActionCommand="{Binding RefreshCommand}"/>

                </Grid>

            </shared:MasterDetailPage.MasterContent>

            <shared:MasterDetailPage.DetailContent>

                <package:PackageDetailsPanel
                    DataContext="{Binding Details}"/>

            </shared:MasterDetailPage.DetailContent>

        </shared:MasterDetailPage>

    </Grid>

</UserControl>
