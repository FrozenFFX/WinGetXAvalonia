<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    x:Class="WinGetXAvalonia.Views.HistoryView"
    x:Name="Root"
    x:DataType="vm:HistoryViewModel">

    <UserControl.KeyBindings>
        <KeyBinding
            Gesture="F5"
            Command="{Binding RefreshCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>

        <Style Selector="ToggleButton.FilterChip">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.FilterChip:pointerover:not(:checked)">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.FilterChip:checked">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

    </UserControl.Styles>

    <Grid
        Margin="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <shared:SectionHeader
            Grid.Row="0"
            Title="{loc:Translate Key=&quot;History&quot;}"
            Description="{loc:TranslateBinding Path=OperationsSummary}"/>

        <!-- Toolbar -->
        <Grid
            Grid.Row="1"
            RowDefinitions="Auto,Auto">

            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16"
                CornerRadius="{DynamicResource RadiusMedium}"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">

                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">

                    <shared:SearchBox
                        MinWidth="0"
                        MaxWidth="1200"
                        HorizontalAlignment="Stretch"
                        Watermark="{loc:Translate Key=&quot;Search history...&quot;}"
                        Text="{Binding SearchText}"/>

                    <shared:AppButton
                        Grid.Column="1"
                        Width="42"
                        Padding="0"
                        ToolTip.Tip="{loc:Translate Key=&quot;Refresh history (F5)&quot;}"
                        Command="{Binding RefreshCommand}">

                        <Path
                            Width="18"
                            Height="18"
                            Data="{StaticResource IconRefresh}"
                            Fill="{DynamicResource TextBrush}"
                            Stretch="Uniform"/>
                    </shared:AppButton>

                    <shared:AppButton
                        Grid.Column="2"
                        MinWidth="110"
                        Content="{loc:Translate Key=&quot;Export&quot;}"
                        Command="{Binding ExportCommand}"/>

                    <shared:AppButton
                        Grid.Column="3"
                        Classes="Danger"
                        MinWidth="110"
                        Content="{loc:Translate Key=&quot;Clear&quot;}"
                        Command="{Binding ClearCommand}"/>

                </Grid>

            </Border>

            <ItemsControl
                Grid.Row="1"
                ItemsSource="{Binding Filters}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton
                            Classes="FilterChip"
                            Margin="0,0,8,8"
                            IsChecked="{Binding IsActive, Mode=OneWay}"
                            Command="{Binding $parent[ItemsControl].DataContext.SelectFilterCommand}"
                            CommandParameter="{Binding}">

                            <TextBlock Text="{loc:TranslateBinding Path=Label}"/>

                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </Grid>

        <!-- Master-Detail -->
        <shared:MasterDetailPage
            Grid.Row="3"
            IsLoading="{Binding IsLoading}"
            LoadingMessage="{loc:Translate Key=&quot;Loading history...&quot;}"
            DetailWidth="0.5*">

            <shared:MasterDetailPage.MasterContent>

                <Grid>

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        ScrollViewer.IsDeferredScrollingEnabled="True">

                        <StackPanel Spacing="20">

                            <ListBox
                                ItemsSource="{Binding Groups}"
                                BorderThickness="0"
                                Background="Transparent">

                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel CacheLength="0.5"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <StackPanel Spacing="8">

                                            <TextBlock
                                                Margin="5,0,0,0"
                                                FontSize="{DynamicResource FontCardTitle}"
                                                FontWeight="SemiBold"
                                                Text="{loc:TranslateBinding Path=Title}"/>

                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:HistoryCard/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- Empty state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding IsEmpty}"
                        Icon="history"
                        Title="{loc:Translate Key=&quot;No history available&quot;}"
                        Description="{loc:Translate Key=&quot;Operations you run will appear here.&quot;}">

                        <shared:AppEmptyState.Examples>
                            <sys:String>Installs, updates and removals in one place</sys:String>
                            <sys:String>Roll back to any snapshot in two clicks</sys:String>
                            <sys:String>Compare what changed between two points</sys:String>
                        </shared:AppEmptyState.Examples>

                    </shared:AppEmptyState>

                    <!-- Error state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding HasError}"
                        Icon="warning"
                        Title="{loc:Translate Key=&quot;Couldn&apos;t load history&quot;}"
                        Description="{loc:TranslateBinding Path=ErrorMessage}"
                        ActionText="{loc:Translate Key=&quot;Retry&quot;}"
                        ActionCommand="{Binding RefreshCommand}"/>

                </Grid>

            </shared:MasterDetailPage.MasterContent>

            <shared:MasterDetailPage.DetailContent>

                <Border
                    Padding="20"
                    CornerRadius="{DynamicResource RadiusLarge}"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">

                    <StackPanel Spacing="18">

                        <TextBlock
                            FontSize="{DynamicResource FontSectionLarge}"
                            FontWeight="SemiBold"
                            Text="{loc:Translate Key=&quot;Statistics&quot;}"/>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="12">

                            <TextBlock
                                Grid.Row="0"
                                FontSize="{DynamicResource FontBody}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Text="{loc:Translate Key=&quot;Total&quot;}"/>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="{DynamicResource FontBody}"
                                FontWeight="SemiBold"
                                Text="{loc:TranslateBinding Path=TotalOperations}"/>

                            <TextBlock
                                Grid.Row="1"
                                FontSize="{DynamicResource FontBody}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Text="{loc:Translate Key=&quot;Successful&quot;}"/>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="{DynamicResource FontBody}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SuccessBrush}"
                                Text="{loc:TranslateBinding Path=SuccessfulOperations}"/>

                            <TextBlock
                                Grid.Row="2"
                                FontSize="{DynamicResource FontBody}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Text="{loc:Translate Key=&quot;Failed&quot;}"/>

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                FontSize="{DynamicResource FontBody}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource DangerBrush}"
                                Text="{loc:TranslateBinding Path=FailedOperations}"/>

                            <TextBlock
                                Grid.Row="3"
                                FontSize="{DynamicResource FontBody}"
                                Foreground="{DynamicResource SubtextBrush}"
                                Text="{loc:Translate Key=&quot;Today&quot;}"/>

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                FontSize="{DynamicResource FontBody}"
                                FontWeight="SemiBold"
                                Text="{loc:TranslateBinding Path=TodayOperations}"/>

                        </Grid>

                        <shared:AppSeparator/>

                        <shared:AppButton
                            HorizontalAlignment="Stretch"
                            Content="{loc:Translate Key=&quot;Export History&quot;}"
                            Command="{Binding ExportCommand}"/>

                        <shared:AppButton
                            HorizontalAlignment="Stretch"
                            Classes="Danger"
                            Content="{loc:Translate Key=&quot;Clear History&quot;}"
                            Command="{Binding ClearCommand}"/>

                    </StackPanel>

                </Border>

            </shared:MasterDetailPage.DetailContent>

        </shared:MasterDetailPage>

    </Grid>

</UserControl>
