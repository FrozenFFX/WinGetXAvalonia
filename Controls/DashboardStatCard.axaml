<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:WinGetXAvalonia.Models"
             x:Class="WinGetXAvalonia.Controls.DashboardStatCard"
             x:DataType="models:DashboardCardModel">

    <Border Classes="card"
            Width="210"
            Margin="0,0,16,16"
            MinHeight="130">

        <StackPanel Spacing="10">

            <TextBlock
                FontSize="22"
                Text="{Binding Icon}"/>

            <TextBlock
                Opacity="0.7"
                FontSize="14"
                Text="{Binding Title}"/>

            <TextBlock
                FontSize="34"
                FontWeight="Bold"
                Text="{Binding Value}"/>

        </StackPanel>

    </Border>

</UserControl>
