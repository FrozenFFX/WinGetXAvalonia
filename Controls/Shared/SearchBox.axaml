<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    x:Class="WinGetXAvalonia.Controls.Shared.SearchBox"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Name="Root">

    <Border
        Height="42"
        CornerRadius="12"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        Padding="12,0">

        <Border.Transitions>
            <Transitions>
                <BrushTransition
                    Property="BorderBrush"
                    Duration="0:0:0.15"/>
                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.15"/>
            </Transitions>
        </Border.Transitions>

        <Grid
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10"
            VerticalAlignment="Center">

            <ContentPresenter
                Grid.Column="0"
                VerticalAlignment="Center"
                Content="{Binding LeftIcon, ElementName=Root}">

                <ContentPresenter.Content>
                    <Path
                        Data="{StaticResource IconSearch}"
                        Width="16"
                        Height="16"
                        Fill="{DynamicResource SubtextBrush}"
                        Opacity="0.6"
                        Stretch="Uniform"
                        VerticalAlignment="Center"/>
                </ContentPresenter.Content>

            </ContentPresenter>

            <TextBox
                Grid.Column="1"
                Background="Transparent"
                BorderThickness="0"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Left"
                PlaceholderText="{Binding Watermark, ElementName=Root}"
                Text="{Binding Text, ElementName=Root, Mode=TwoWay}"/>

            <shared:AppButton
                Grid.Column="2"
                Width="28"
                Height="28"
                Padding="0"
                CornerRadius="8"
                IsVisible="{Binding ShowClearButton, ElementName=Root}"
                Click="Clear_Click">

                <Path
                    Width="14"
                    Height="14"
                    Data="{StaticResource IconClose}"
                    Fill="{DynamicResource SubtextBrush}"
                    Stretch="Uniform"/>
            </shared:AppButton>

        </Grid>

    </Border>

</UserControl>