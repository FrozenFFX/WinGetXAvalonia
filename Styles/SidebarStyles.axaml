<Styles xmlns="https://github.com/avaloniaui">

    <Style Selector="ListBox.sidebar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
    </Style>

    <Style Selector="Border.sidebar-item">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="8,0,6,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background"
                                 Duration="{DynamicResource MotionDurationFast}"
                                 Easing="{DynamicResource MotionEasingOut}"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.sidebar-item Grid TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:pointerover Border.sidebar-item">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:selected Border.sidebar-item">
        <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:selected Border.sidebar-item Grid TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:selected Border.sidebar-item Grid Path">
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:focus-visible Border.sidebar-item">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
    </Style>

    <!-- Kategori başlıkları: sayfa öğesinden açıkça ayrılır -->
    <Style Selector="Border.sidebar-item.header">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="2,0,6,0"/>
        <Setter Property="Margin" Value="0,10,0,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.sidebar-item.header Grid TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="LetterSpacing" Value="0.4"/>
    </Style>

    <Style Selector="Border.sidebar-item.header Grid Path">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:pointerover Border.sidebar-item.header">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:selected Border.sidebar-item.header Grid TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
    </Style>

</Styles>