<UserControl
    x:Class="WinGetXAvalonia.Controls.Shared.BaseCard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Margin="5"
        Padding="16"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource RadiusMedium}"
        Classes="BaseCard">

        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Border.Transitions>

        <ContentPresenter/>

    </Border>

</UserControl>
