<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.DiagnosticsView"
    x:DataType="vm:DiagnosticsViewModel">

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="{loc:Translate Key=&quot;Diagnostics&quot;}"
            Description="{loc:Translate Key=&quot;Real system and environment information.&quot;}"/>

        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Spacing="14">

                <shared:AppCard>

                    <StackPanel Spacing="14">

                        <TextBlock
                            FontSize="{DynamicResource FontSectionLarge}"
                            FontWeight="SemiBold"
                            Text="{loc:Translate Key=&quot;System&quot;}"/>

                        <Grid
                            ColumnDefinitions="160,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="8">

                            <TextBlock Opacity="0.6" Text="{loc:Translate Key=&quot;Windows&quot;}"/>
                            <TextBlock Grid.Column="1" Text="{loc:TranslateBinding Path=Report.WindowsVersion}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1" Opacity="0.6" Text="{loc:Translate Key=&quot;Architecture&quot;}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:TranslateBinding Path=Report.Architecture}"/>

                            <TextBlock Grid.Row="2" Opacity="0.6" Text="{loc:Translate Key=&quot;Machine&quot;}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:TranslateBinding Path=Report.MachineName}"/>

                            <TextBlock Grid.Row="3" Opacity="0.6" Text="{loc:Translate Key=&quot;User&quot;}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:TranslateBinding Path=Report.UserName}"/>

                            <TextBlock Grid.Row="4" Opacity="0.6" Text="{loc:Translate Key=&quot;CPU&quot;}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:TranslateBinding Path=Report.CpuName}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="5" Opacity="0.6" Text="{loc:Translate Key=&quot;Threads&quot;}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{loc:TranslateBinding Path=Report.ProcessorCount}"/>

                            <TextBlock Grid.Row="6" Opacity="0.6" Text="{loc:Translate Key=&quot;RAM&quot;}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{loc:TranslateBinding Path=Report.Ram}"/>

                            <TextBlock Grid.Row="7" Opacity="0.6" Text="{loc:Translate Key=&quot;Disk (C:)&quot;}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{loc:TranslateBinding Path=Report.Disk}"/>

                        </Grid>

                    </StackPanel>

                </shared:AppCard>

                <shared:AppCard>

                    <StackPanel Spacing="14">

                        <TextBlock
                            FontSize="{DynamicResource FontSectionLarge}"
                            FontWeight="SemiBold"
                            Text="{loc:Translate Key=&quot;Runtime&quot;}"/>

                        <Grid
                            ColumnDefinitions="160,*"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="8">

                            <TextBlock Opacity="0.6" Text="{loc:Translate Key=&quot;.NET&quot;}"/>
                            <TextBlock Grid.Column="1" Text="{loc:TranslateBinding Path=Report.DotNetVersion}"/>

                            <TextBlock Grid.Row="1" Opacity="0.6" Text="{loc:Translate Key=&quot;64-bit OS&quot;}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:TranslateBinding Path=Report.Is64Bit}"/>

                            <TextBlock Grid.Row="2" Opacity="0.6" Text="{loc:Translate Key=&quot;Winget&quot;}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:TranslateBinding Path=Report.WingetInstalled}"/>

                        </Grid>

                    </StackPanel>

                </shared:AppCard>

            </StackPanel>

        </ScrollViewer>

        <shared:AppEmptyState
            Grid.Row="2"
            IsVisible="{Binding IsEmpty}"
            Icon="diagnostics"
            Title="{loc:Translate Key=&quot;No diagnostics available&quot;}"
            Description="{loc:Translate Key=&quot;Run a diagnostic scan to see results.&quot;}"/>

        <shared:AppEmptyState
            Grid.Row="2"
            IsVisible="{Binding HasError}"
            Icon="warning"
            Title="{loc:Translate Key=&quot;Couldn&apos;t load diagnostics&quot;}"
            Description="{loc:TranslateBinding Path=ErrorMessage}"
            ActionText="{loc:Translate Key=&quot;Retry&quot;}"
            ActionCommand="{Binding RefreshCommand}"/>

        <shared:LoadingOverlay
            Grid.RowSpan="3"
            IsLoading="{Binding IsLoading}"
            Message="{loc:Translate Key=&quot;Collecting diagnostics...&quot;}"/>

    </Grid>

</UserControl>
