<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Workspace.WorkspaceCard"
    x:DataType="models:WorkspaceModel"
    x:CompileBindings="False">

    <Panel>

        <Border
            Classes="card"
            RenderTransformOrigin="50%,100%">

            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition
                        Property="RenderTransform"
                        Duration="{DynamicResource MotionDurationNormal}"
                        Easing="{DynamicResource MotionEasingOut}"/>
                    <BrushTransition
                        Property="Background"
                        Duration="{DynamicResource MotionDurationNormal}"
                        Easing="{DynamicResource MotionEasingOut}"/>
                    <BrushTransition
                        Property="BorderBrush"
                        Duration="{DynamicResource MotionDurationNormal}"
                        Easing="{DynamicResource MotionEasingOut}"/>
                </Transitions>
            </Border.Transitions>

            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8"
                  Width="360">

                <!-- Header: icon + name/description -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">

                    <Border
                        Width="40"
                        Height="40"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}">

                        <Path
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                            Fill="{DynamicResource AccentBrush}"
                            Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">

                        <TextBlock
                            FontWeight="SemiBold"
                            FontSize="{DynamicResource FontCardTitle}"
                            Text="{loc:TranslateBinding Path=Name}"
                            TextTrimming="CharacterEllipsis"/>

                        <TextBlock
                            Opacity="0.7"
                            FontSize="{DynamicResource FontCaption}"
                            Text="{loc:TranslateBinding Path=Description}"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="2"/>
                    </StackPanel>
                </Grid>

                <!-- Metadata: package count + date -->
                <WrapPanel Grid.Row="1" ItemSpacing="6">

                    <Border
                        Padding="8,3"
                        CornerRadius="20"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">

<TextBlock
                                FontSize="{DynamicResource FontSecondary}"
                                FontWeight="SemiBold"
                                Text="{Binding PackageCount, StringFormat='{}{0} packages'}"/>
                    </Border>

                    <Border
                        Padding="8,3"
                        CornerRadius="20"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">

<TextBlock
                                FontSize="{DynamicResource FontSecondary}"
                                Text="{Binding Modified, StringFormat='Modified {0:g}'}"/>
                    </Border>
                </WrapPanel>

                <!-- Actions: Open + more actions -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">

                    <shared:AppButton
                        HorizontalAlignment="Left"
                        MinWidth="64"
                        Content="{loc:Translate Key=&quot;Open&quot;}"
                        Command="{Binding $parent[ListBox].DataContext.OpenCommand}"
                        CommandParameter="{Binding}"/>

                    <shared:AppButton
                        Grid.Column="1"
                        Classes="ghost"
                        Width="36"
                        Height="36"
                        Padding="4,0"
                        HorizontalAlignment="Right"
                        ToolTip.Tip="{loc:Translate Key=&quot;More actions&quot;}"
                        Click="ShowContextMenu">

                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconMoreVert}"
                            Fill="{DynamicResource SubtextBrush}"
                            Stretch="Uniform"/>
                    </shared:AppButton>

                </Grid>

            </Grid>

        </Border>

        <!-- Selected-state overlay -->
        <Border
            IsHitTestVisible="False"
            IsVisible="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="2"
            CornerRadius="16"
            Margin="3"
            BoxShadow="{DynamicResource AccentGlow}">
            <Border.Transitions>
                <Transitions>
                    <BoxShadowsTransition
                        Property="BoxShadow"
                        Duration="{DynamicResource MotionDurationNormal}"
                        Easing="{DynamicResource MotionEasingOut}"/>
                </Transitions>
            </Border.Transitions>
        </Border>

    </Panel>

    <UserControl.ContextMenu>
        <ContextMenu>

            <MenuItem
                Header="{loc:Translate Key=&quot;Open&quot;}"
                Command="{Binding $parent[ListBox].DataContext.OpenCommand}"
                CommandParameter="{Binding}"/>

            <Separator/>

            <MenuItem
                Header="{loc:Translate Key=&quot;Edit&quot;}"
                Command="{Binding $parent[ListBox].DataContext.EditCommand}"
                CommandParameter="{Binding}"/>

            <MenuItem
                Header="{loc:Translate Key=&quot;Export&quot;}"
                Command="{Binding $parent[ListBox].DataContext.ExportCommand}"
                CommandParameter="{Binding}"/>

            <Separator/>

            <MenuItem
                Classes="Danger"
                Header="{loc:Translate Key=&quot;Delete&quot;}"
                Command="{Binding $parent[ListBox].DataContext.DeleteWorkspaceCommand}"
                CommandParameter="{Binding}"/>

        </ContextMenu>
    </UserControl.ContextMenu>

</UserControl>
