<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#2C3340"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2B313C"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3C4452"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#4B5568"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#2B313C"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#3C4452"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="SubtextBrush" Color="{StaticResource Color.TextSecondary}"/>

</ResourceDictionary>
