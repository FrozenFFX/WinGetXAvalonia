<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:package="using:WinGetXAvalonia.Controls.Package"
    x:Class="WinGetXAvalonia.Views.InstalledView"
    x:DataType="vm:InstalledViewModel">
    <!-- WinGetX - https://github.com/FrozenFFX -->

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="Installed Packages"
            Description="Manage all installed applications."
            ActionText="Refresh"
            ActionCommand="{Binding RefreshCommand}"/>

        <package:PackageToolbar
            Grid.Row="1"
            SearchText="{Binding SearchText}"
            PackageCount="{Binding PackageCount}"
            RefreshCommand="{Binding RefreshCommand}"
            SelectedSort="{Binding SelectedSort}"
            SelectedFilter="{Binding SelectedFilter}"/>

        <!-- Bulk actions -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,0"
            Padding="12,8"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMedium}"
            IsVisible="{Binding SelectedCount,
            Converter={StaticResource PositiveToBoolConverter}}">

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                <TextBlock
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Text="{Binding SelectedCount,
                    StringFormat={}{0} selected}"/>

                <Button
                    Grid.Column="2"
                    Content="Update Selected"
                    Command="{Binding UpdateSelectedCommand}"/>

                <Button
                    Grid.Column="3"
                    Classes="Danger"
                    Content="Remove Selected"
                    Command="{Binding RemoveSelectedCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">

            <ScrollViewer>

                <ItemsControl ItemsSource="{Binding Packages}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <controls:PackageCard/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                IsVisible="{Binding Packages.Count,
                Converter={StaticResource ZeroToBoolConverter}}">

                <TextBlock
                    Text="📦"
                    FontSize="32"
                    Opacity="0.4"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="No packages found"
                    Opacity="0.6"
                    HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>


    <!-- kaneki -->
    </Grid>

</UserControl>
