<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:WinGetXAvalonia.Models"
             xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d"
             d:DesignWidth="480"
             d:DesignHeight="120"
             x:Class="WinGetXAvalonia.Controls.PackageCard"
             x:DataType="models:PackageModel"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Border.BaseCard:pointerover">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </UserControl.Styles>

    <Grid>

        <shared:BaseCard>

            <Grid ColumnDefinitions="Auto,*,Auto">

                <Border Grid.Column="0"
                        Width="32"
                        Height="32"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}">

                    <TextBlock Text="{Binding Icon}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- bilgi -->
                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            Spacing="6"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource FontSubtitle}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding Id}"
                               FontSize="{DynamicResource FontCaption}"
                               Foreground="{DynamicResource SubtextBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <WrapPanel ItemSpacing="6">

                        <!-- kaynak -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="20"
                                Padding="8,3">

                            <TextBlock Text="{Binding Source}"
                                       FontSize="{DynamicResource FontCaption}"
                                       Foreground="{DynamicResource SubtextBrush}"/>
                        </Border>

                        <!-- kurulu sürüm -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="20"
                                Padding="8,3"
                                IsVisible="{Binding Version,
                                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                            <TextBlock Text="{Binding Version,
                                       StringFormat=Installed {0}}"
                                       FontSize="{DynamicResource FontCaption}"
                                       Foreground="{DynamicResource SubtextBrush}"/>
                        </Border>

                        <!-- güncelleme var -->
                        <Border Background="#3327AE60"
                                CornerRadius="20"
                                Padding="8,3"
                                IsVisible="{Binding Available,
                                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                            <TextBlock Text="{Binding Available,
                                       StringFormat=▲ {0}}"
                                       FontSize="{DynamicResource FontCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- sağdaki butonlar -->
                <Grid Grid.Column="2"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="6">

                    <Button Grid.Row="0"
                            Content="Güncelle"
                            IsVisible="{Binding Available,
                            Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding $parent[ItemsControl].DataContext.UpdateCommand}"
                            CommandParameter="{Binding}"/>

                    <Button Grid.Row="1"
                            Content="🌐"
                            Width="42"
                            Padding="0"
                            ToolTip.Tip="Open Homepage"
                            Command="{Binding $parent[ItemsControl].DataContext.OpenHomepageCommand}"
                            CommandParameter="{Binding}"/>

                    <Button Grid.Row="2"
                            Content="•••"
                            Width="42"
                            Padding="0"
                            ToolTip.Tip="More">

                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Copy ID"
                                          Command="{Binding $parent[ListBox].DataContext.CopyIdCommand}"
                                          CommandParameter="{Binding}"/>

                                <MenuItem Header="Copy Name"
                                          Command="{Binding $parent[ListBox].DataContext.CopyNameCommand}"
                                          CommandParameter="{Binding}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Grid.Row="3"
                            Classes="Danger"
                            Content="Kaldır"
                            Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding Mode,
                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                        Converter={StaticResource IsDefaultCardMode}}"/>
                </Grid>

            </Grid>

        </shared:BaseCard>

        <!-- seçiliyken kenar çerçevesi -->
        <Border IsVisible="{Binding Selected}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="{DynamicResource RadiusMedium}"
                Margin="5"
                IsHitTestVisible="False"/>

    </Grid>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open Homepage"
                      Command="{Binding $parent[ListBox].DataContext.OpenHomepageCommand}"
                      CommandParameter="{Binding}"/>

            <MenuItem Header="Copy ID"
                      Command="{Binding $parent[ListBox].DataContext.CopyIdCommand}"
                      CommandParameter="{Binding}"/>

            <MenuItem Header="Copy Name"
                      Command="{Binding $parent[ListBox].DataContext.CopyNameCommand}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

</UserControl>
