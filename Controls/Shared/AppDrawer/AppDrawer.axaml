<ContentControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Shared.AppDrawer">

    <ContentControl.Template>
        <ControlTemplate TargetType="local:AppDrawer">

            <Grid IsVisible="{TemplateBinding IsOpen}">

                <Border
                    x:Name="PART_Scrim"
                    Background="{DynamicResource ScrimBrush}"/>

                <Border
                    x:Name="PART_Panel"
                    Width="{TemplateBinding PanelWidth}"
                    HorizontalAlignment="Left"
                    Padding="20"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}">

                    <Grid RowDefinitions="Auto,*">

                        <TextBlock
                            FontSize="{DynamicResource FontSection}"
                            FontWeight="SemiBold"
                            Text="{TemplateBinding Title}"/>

                        <ContentPresenter
                            Grid.Row="1"
                            Margin="0,16,0,0"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"/>

                    </Grid>

                </Border>

            </Grid>

        </ControlTemplate>
    </ContentControl.Template>

</ContentControl>
