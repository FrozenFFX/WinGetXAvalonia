<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinGetXAvalonia.ViewModels"
             xmlns:models="using:WinGetXAvalonia.Models.Operations"
             xmlns:operation="using:WinGetXAvalonia.Controls.Operation"
             x:Class="WinGetXAvalonia.Controls.Operation.OperationDrawer"
             x:DataType="vm:OperationDrawerViewModel">

    <Border Width="360"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMedium}">

        <Grid RowDefinitions="Auto,12,*">

            <TextBlock FontSize="20"
                       FontWeight="Bold"
                       Text="Operations" />

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Operations}"
                     BorderThickness="0"
                     Background="Transparent">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:OperationModel">
                        <operation:OperationCard />
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>

    </Border>

</UserControl>
