<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Workspace.WorkspaceEditor"
    x:Name="Root"
    x:CompileBindings="False">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

        <StackPanel Spacing="8">

            <TextBox
                Text="{Binding Name, ElementName=Root}"
                PlaceholderText="Workspace name">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SaveCommand, ElementName=Root}"/>
                </TextBox.KeyBindings>
            </TextBox>

            <TextBox
                Text="{Binding Description, ElementName=Root}"
                PlaceholderText="Workspace description (optional)"/>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">

            <shared:AppButton
                Classes="ghost"
                Content="Cancel"
                Command="{Binding CancelCommand, ElementName=Root}"/>

            <shared:AppButton
                Classes="Accent"
                Content="{Binding SaveButtonText, ElementName=Root}"
                Command="{Binding SaveCommand, ElementName=Root}"/>

        </StackPanel>

    </Grid>

</UserControl>
