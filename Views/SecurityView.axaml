<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.SecurityView"
    x:DataType="vm:SecurityViewModel">

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="Security"
            Description="Security status and package verification."/>

        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Spacing="14">

                <UniformGrid Columns="4" Margin="0,0,0,4">

                    <shared:AppCard>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSection}" Text="{DynamicResource DisplaySecurity}"/>
                            <TextBlock FontWeight="SemiBold" Text="Trusted"/>
                            <TextBlock FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" Text="{Binding Trusted}"/>
                        </StackPanel>
                    </shared:AppCard>

                    <shared:AppCard>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSection}" Text="{DynamicResource DisplayWarning}"/>
                            <TextBlock FontWeight="SemiBold" Text="Warnings"/>
                            <TextBlock FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" Text="{Binding Warnings}"/>
                        </StackPanel>
                    </shared:AppCard>

                    <shared:AppCard>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSection}" Text="{DynamicResource DisplayError}"/>
                            <TextBlock FontWeight="SemiBold" Text="Blocked"/>
                            <TextBlock FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" Text="{Binding Blocked}"/>
                        </StackPanel>
                    </shared:AppCard>

                    <shared:AppCard>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="{DynamicResource FontSection}" Text="{DynamicResource DisplaySuccess}"/>
                            <TextBlock FontWeight="SemiBold" Text="Verified"/>
                            <TextBlock FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" Text="{Binding Verified}"/>
                        </StackPanel>
                    </shared:AppCard>

                </UniformGrid>

                <shared:AppCard>

                    <StackPanel Spacing="10">

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="{DynamicResource FontSection}" Text="security"/>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold" Text="{Binding StatusTitle}"/>
                                <TextBlock
                                    FontSize="{DynamicResource FontSecondary}"
                                    Opacity="0.6"
                                    Text="WinGetX does not currently have a real package-signature/security scanner connected."
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <shared:AppSeparator/>

                        <TextBlock
                            FontSize="{DynamicResource FontCaption}"
                            Opacity="0.75"
                            TextWrapping="Wrap"
                            Text="A real security pipeline needs Publisher, Signature, Hash, Source and Verification steps. None of these are wired up yet, so showing fake Trust or Health percentages would be misleading."/>

                    </StackPanel>

                </shared:AppCard>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
