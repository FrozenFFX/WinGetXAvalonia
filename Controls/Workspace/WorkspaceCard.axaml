<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinGetXAvalonia.Models"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    mc:Ignorable="d"
    d:DesignWidth="640"
    d:DesignHeight="120"
    x:Class="WinGetXAvalonia.Controls.Workspace.WorkspaceCard"
    x:DataType="models:WorkspaceModel"
    x:CompileBindings="False">

    <shared:BaseCard>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

            <Border
                Width="52"
                Height="52"
                CornerRadius="{DynamicResource RadiusMedium}"
                Background="{DynamicResource SurfaceBrush}"
                VerticalAlignment="Center">

                <TextBlock
                    Text="{Binding Icon}"
                    FontSize="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <StackPanel
                Grid.Column="1"
                Spacing="4"
                VerticalAlignment="Center">

                <TextBlock
                    Text="{Binding Name}"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"/>

                <TextBlock
                    Text="{Binding PackageCount, StringFormat='{}{0} Packages'}"
                    FontSize="{DynamicResource FontCaption}"
                    Foreground="{DynamicResource SubtextBrush}"/>

                <TextBlock
                    Text="{Binding LastUsed, StringFormat='Last Used {0:MMM d, yyyy}'}"
                    FontSize="{DynamicResource FontCaption}"
                    Foreground="{DynamicResource SubtextBrush}"/>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Spacing="8"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <Button
                    Content="Open"
                    Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}"
                    CommandParameter="{Binding}"/>

                <Button
                    Content="Edit"
                    Command="{Binding $parent[ItemsControl].DataContext.EditCommand}"
                    CommandParameter="{Binding}"/>

                <Button
                    Content="Export"
                    Command="{Binding $parent[ItemsControl].DataContext.ExportCommand}"
                    CommandParameter="{Binding}"/>

                <Button
                    Classes="Danger"
                    Content="Delete"
                    Command="{Binding $parent[ItemsControl].DataContext.DeleteWorkspaceCommand}"
                    CommandParameter="{Binding}"/>
            </StackPanel>
        </Grid>
    </shared:BaseCard>

</UserControl>
