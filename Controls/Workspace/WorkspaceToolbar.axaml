<UserControl
    x:Class="WinGetXAvalonia.Controls.Workspace.WorkspaceToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Name="Root">

    <Border
        Margin="0,0,0,8"
        Padding="16"
        CornerRadius="{DynamicResource RadiusMedium}"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">

            <shared:SearchBox
                MinWidth="200"
                MaxWidth="360"
                HorizontalAlignment="Stretch"
                Watermark="Search workspaces..."
                Text="{Binding SearchText, ElementName=Root}"/>

            <shared:AppButton
                Grid.Column="1"
                Content="＋ New Workspace"
                Command="{Binding CreateCommand, ElementName=Root}"/>

            <shared:AppButton
                Grid.Column="2"
                Content="Import"
                Command="{Binding ImportCommand, ElementName=Root}"/>

            <shared:AppButton
                Grid.Column="3"
                Width="42"
                Padding="0"
                Content="🔄"
                ToolTip.Tip="Refresh workspaces (F5)"
                Command="{Binding RefreshCommand, ElementName=Root}"/>

            <shared:AppBadge
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{Binding Summary, ElementName=Root}"/>

        </Grid>

    </Border>

</UserControl>
