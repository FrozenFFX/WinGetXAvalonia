<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Controls.Shared.EmptyState"
    x:Name="Root">

    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="8"
        MaxWidth="300">

        <Path
            Width="42"
            Height="42"
            HorizontalAlignment="Center"
            Opacity="0.35"
            Data="{Binding Icon, ElementName=Root, Converter={StaticResource IconGeometry}}"
            Fill="{DynamicResource MutedTextBrush}"
            Stretch="Uniform"/>

        <TextBlock
            Text="{Binding Title, ElementName=Root}"
            FontSize="{DynamicResource FontSubtitle}"
            FontWeight="SemiBold"
            TextAlignment="Center"/>

        <TextBlock
            Text="{Binding Description, ElementName=Root}"
            FontSize="{DynamicResource FontCaption}"
            Foreground="{DynamicResource MutedTextBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"/>

        <shared:AppButton
            Content="{Binding ActionText, ElementName=Root}"
            Command="{Binding ActionCommand, ElementName=Root}"
            IsVisible="{Binding ActionCommand, ElementName=Root,
            Converter={x:Static conv:ObjectConverters.IsNotNull}}"
            HorizontalAlignment="Center"
            Margin="0,8,0,0"/>

    </StackPanel>

</UserControl>
