<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WinGetXAvalonia.Controls.Dashboard.StatCard"
             x:Name="Root"
             x:CompileBindings="False">

        <Border Classes="card"
                MinWidth="150"
                Margin="0,0,16,16"
                MinHeight="130">

        <StackPanel Spacing="10">

            <TextBlock
                FontSize="22"
                Foreground="{Binding #Root.AccentBrush}"
                Text="{Binding #Root.Icon}"/>

            <TextBlock
                Opacity="0.7"
                FontSize="14"
                Text="{Binding #Root.Title}"/>

            <TextBlock
                FontSize="34"
                FontWeight="Bold"
                Text="{Binding #Root.Value}"/>

            <TextBlock
                Opacity="0.5"
                FontSize="12"
                Text="{Binding #Root.Subtitle}"/>

        </StackPanel>

    </Border>

</UserControl>
