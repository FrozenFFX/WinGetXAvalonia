<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:WinGetXAvalonia.Models"
             xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:Controls="using:WinGetXAvalonia.Controls"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d"
             d:DesignWidth="480"
             d:DesignHeight="120"
             x:Class="WinGetXAvalonia.Controls.PackageCard"
             x:DataType="models:PackageModel"
             x:CompileBindings="False">

    <Grid>

        <shared:BaseCard>

            <Grid ColumnDefinitions="Auto,44,*,auto"
                  ColumnSpacing="12">

                <!-- seçim kutusu (sadece Updates modunda) -->
                <CheckBox
                    Grid.Column="0"
                    IsChecked="{Binding Selected, Mode=TwoWay}"
                    IsVisible="{Binding Mode,
                    RelativeSource={RelativeSource AncestorType=Controls:PackageCard},
                    Converter={StaticResource IsUpdatesCardMode}}"
                    VerticalAlignment="Center"/>

                <!-- ikon -->
                <Border
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    CacheMode="BitmapCache">

                    <Path Width="24"
                          Height="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                          Fill="{DynamicResource AccentBrush}"
                          Stretch="Uniform"/>
                </Border>

                <!-- bilgi -->
                <StackPanel
                    Grid.Column="2"
                    Spacing="4"
                    VerticalAlignment="Center">

                    <TextBlock Text="{loc:TranslateBinding Path=Name}"
                               FontSize="{DynamicResource FontSubtitle}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"/>

                    <TextBlock Text="{loc:TranslateBinding Path=Id}"
                               FontSize="{DynamicResource FontCaption}"
                               Foreground="{DynamicResource SubtextBrush}"
                               Opacity="0.6"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"/>

                    <WrapPanel ItemSpacing="6">

                        <!-- kaynak -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="20"
                                Padding="8,2">

                            <TextBlock Text="{loc:TranslateBinding Path=Source}"
                                       FontSize="{DynamicResource FontCaption}"
                                       Foreground="{DynamicResource SubtextBrush}"/>
                        </Border>

                        <!-- kurulu sürüm -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="20"
                                Padding="8,2"
                                IsVisible="{Binding Version,
                                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                            <TextBlock Text="{Binding Version,
                                       StringFormat=Installed {0}}"
                                       FontSize="{DynamicResource FontCaption}"
                                       Foreground="{DynamicResource SubtextBrush}"/>
                        </Border>

                        <!-- güncelleme var -->
                        <Border Background="{DynamicResource SuccessSubtleBrush}"
                                CornerRadius="20"
                                Padding="8,2"
                                IsVisible="{Binding Available,
                                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                            <TextBlock Text="{Binding Available,
                                       StringFormat=Update {0}}"
                                       FontSize="{DynamicResource FontCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>

                        <!-- seçili -->
                        <Border Background="{DynamicResource AccentSubtle}"
                                CornerRadius="20"
                                Padding="8,3"
                                IsVisible="{Binding Selected}">

                            <TextBlock Text="{loc:Translate Key=&quot;Selected&quot;}"
                                       FontSize="{DynamicResource FontCaption}"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- aksiyonlar -->
                <Grid
                    Grid.Column="3"
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="6"
                    VerticalAlignment="Center">

                    <shared:AppButton
                        Width="40"
                        Height="40"
                        Classes="Accent"
                        Command="{Binding $parent[ItemsControl].DataContext.UpdateCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding Available,
                        Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                        <Path Width="18"
                              Height="18"
                              Data="{StaticResource IconUpdate}"
                              Fill="{DynamicResource AccentForegroundBrush}"
                              Stretch="Uniform"/>
                    </shared:AppButton>

                    <shared:AppButton
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Classes="Danger"
                        IsVisible="{Binding Mode,
                        RelativeSource={RelativeSource AncestorType=Controls:PackageCard},
                        Converter={StaticResource IsDefaultCardMode}}"
                        Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                        CommandParameter="{Binding}">

                        <Path Width="18"
                              Height="18"
                              Data="{StaticResource IconUninstall}"
                              Fill="{DynamicResource DangerBrush}"
                              Stretch="Uniform"/>
                    </shared:AppButton>

                    <shared:AppButton
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        Click="ShowContextMenu">

                        <Path Width="18"
                              Height="18"
                              Data="{StaticResource IconMoreHoriz}"
                              Fill="{DynamicResource TextBrush}"
                              Stretch="Uniform"/>
                    </shared:AppButton>
                </Grid>

            </Grid>

        </shared:BaseCard>

        <!-- seçiliyken kenar çerçevesi -->
        <Border IsVisible="{Binding Selected}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="{DynamicResource RadiusMedium}"
                Margin="5"
                IsHitTestVisible="False"/>

    </Grid>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{loc:Translate Key=&quot;Open Homepage&quot;}"
                      Command="{Binding $parent[ListBox].DataContext.OpenHomepageCommand}"
                      CommandParameter="{Binding}"/>

            <MenuItem Header="{loc:Translate Key=&quot;Copy ID&quot;}"
                      Command="{Binding $parent[ListBox].DataContext.CopyIdCommand}"
                      CommandParameter="{Binding}"/>

            <MenuItem Header="{loc:Translate Key=&quot;Copy Name&quot;}"
                      Command="{Binding $parent[ListBox].DataContext.CopyNameCommand}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

</UserControl>
