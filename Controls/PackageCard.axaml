<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:WinGetXAvalonia.Models"
             x:Class="WinGetXAvalonia.Controls.PackageCard"
             x:DataType="models:PackageModel"
             x:CompileBindings="False">
    <!-- WinGetX - https://github.com/FrozenFFX -->

    <Border
        Margin="5"
        Padding="16"
        CornerRadius="{DynamicResource RadiusMedium}"
        Background="{DynamicResource CardBackgroundBrush}">

        <StackPanel Spacing="12">

            <Grid ColumnDefinitions="48,*,Auto">

                <TextBlock
                    FontSize="26"
                    VerticalAlignment="Center"
                    Text="{Binding Icon}"/>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Spacing="2">

                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"/>

                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        Text="{Binding Id}"/>

                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Spacing="2">

                    <TextBlock
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"
                        Text="{Binding Version}"/>

                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        HorizontalAlignment="Right"
                        Text="{Binding Source}"/>

                </StackPanel>

            </Grid>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right">

                <Button
                    Content="Update"
                    Command="{Binding $parent[ItemsControl].DataContext.UpdateCommand}"
                    CommandParameter="{Binding}"/>

                <Button
                    Content="Copy ID"
                    Command="{Binding $parent[ItemsControl].DataContext.CopyIdCommand}"
                    CommandParameter="{Binding}"/>

                <Button
                    Content="Copy Name"
                    Command="{Binding $parent[ItemsControl].DataContext.CopyNameCommand}"
                    CommandParameter="{Binding}"/>

                <Button
                    Content="Homepage"
                    Command="{Binding $parent[ItemsControl].DataContext.OpenHomepageCommand}"
                    CommandParameter="{Binding}"/>

                <Button
                    Content="Remove"
                    Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                    CommandParameter="{Binding}"/>

            </StackPanel>

        </StackPanel>


    <!-- kaneki -->
    </Border>

</UserControl>
