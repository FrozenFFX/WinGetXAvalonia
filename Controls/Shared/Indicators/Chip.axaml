<ContentControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:local="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Controls.Shared.Chip">

    <ContentControl.Template>
        <ControlTemplate TargetType="local:Chip">

            <Border
                Background="{TemplateBinding Background}"
                CornerRadius="12"
                Padding="10,4">

                <StackPanel Orientation="Horizontal" Spacing="6">

                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        VerticalAlignment="Center"/>

                    <shared:AppButton
                        Width="16"
                        Height="16"
                        Padding="0"
                        Background="Transparent"
                        Foreground="{DynamicResource SubtextBrush}"
                        VerticalAlignment="Center"
                        Command="{TemplateBinding CloseCommand}"
                        IsVisible="{TemplateBinding ShowClose}">

                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconClose}"
                            Fill="{DynamicResource SubtextBrush}"
                            Stretch="Uniform"/>
                    </shared:AppButton>

                </StackPanel>

            </Border>

        </ControlTemplate>
    </ContentControl.Template>

</ContentControl>
