<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    x:Class="WinGetXAvalonia.Views.DiagnosticsView"
    x:DataType="vm:DiagnosticsViewModel">

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="Diagnostics"
            Description="Real system and environment information."/>

        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Spacing="14">

                <shared:AppCard>

                    <StackPanel Spacing="14">

                        <TextBlock
                            FontSize="{DynamicResource FontSectionLarge}"
                            FontWeight="SemiBold"
                            Text="System"/>

                        <Grid
                            ColumnDefinitions="160,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="8">

                            <TextBlock Opacity="0.6" Text="Windows"/>
                            <TextBlock Grid.Column="1" Text="{Binding Report.WindowsVersion}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1" Opacity="0.6" Text="Architecture"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Report.Architecture}"/>

                            <TextBlock Grid.Row="2" Opacity="0.6" Text="Machine"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Report.MachineName}"/>

                            <TextBlock Grid.Row="3" Opacity="0.6" Text="User"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Report.UserName}"/>

                            <TextBlock Grid.Row="4" Opacity="0.6" Text="CPU"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Report.CpuName}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="5" Opacity="0.6" Text="Threads"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Report.ProcessorCount}"/>

                            <TextBlock Grid.Row="6" Opacity="0.6" Text="RAM"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Report.Ram}"/>

                            <TextBlock Grid.Row="7" Opacity="0.6" Text="Disk (C:)"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Report.Disk}"/>

                        </Grid>

                    </StackPanel>

                </shared:AppCard>

                <shared:AppCard>

                    <StackPanel Spacing="14">

                        <TextBlock
                            FontSize="{DynamicResource FontSectionLarge}"
                            FontWeight="SemiBold"
                            Text="Runtime"/>

                        <Grid
                            ColumnDefinitions="160,*"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="8">

                            <TextBlock Opacity="0.6" Text=".NET"/>
                            <TextBlock Grid.Column="1" Text="{Binding Report.DotNetVersion}"/>

                            <TextBlock Grid.Row="1" Opacity="0.6" Text="64-bit OS"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Report.Is64Bit}"/>

                            <TextBlock Grid.Row="2" Opacity="0.6" Text="Winget"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Report.WingetInstalled}"/>

                        </Grid>

                    </StackPanel>

                </shared:AppCard>

            </StackPanel>

        </ScrollViewer>

        <shared:AppEmptyState
            Grid.Row="2"
            IsVisible="{Binding IsEmpty}"
            Icon="diagnostics"
            Title="No diagnostics available"
            Description="Run a diagnostic scan to see results."/>

        <shared:AppEmptyState
            Grid.Row="2"
            IsVisible="{Binding HasError}"
            Icon="warning"
            Title="Couldn't load diagnostics"
            Description="{Binding ErrorMessage}"
            ActionText="Retry"
            ActionCommand="{Binding RefreshCommand}"/>

        <shared:LoadingOverlay
            Grid.RowSpan="3"
            IsLoading="{Binding IsLoading}"
            Message="Collecting diagnostics..."/>

    </Grid>

</UserControl>
