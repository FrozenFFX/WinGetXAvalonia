<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.NotificationsSettingsView"
             x:DataType="vm:NotificationsSettingsViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="{loc:Translate Key=&quot;Notifications&quot;}"/>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Alerts&quot;}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key=&quot;Toast notifications&quot;}"
                        OnContent="{loc:Translate Key=&quot;Toast notifications&quot;}"
                        IsChecked="{Binding ToastNotifications}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key=&quot;Sound notifications&quot;}"
                        OnContent="{loc:Translate Key=&quot;Sound notifications&quot;}"
                        IsChecked="{Binding SoundNotifications}"/>

                </StackPanel>

            </shared:AppCard>

        </StackPanel>

    </ScrollViewer>

    </Grid>

</UserControl>
