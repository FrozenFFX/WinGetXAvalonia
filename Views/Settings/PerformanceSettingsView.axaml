<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.PerformanceSettingsView"
             x:DataType="vm:PerformanceSettingsViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="{loc:Translate Key=&quot;Performance&quot;}"/>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Rendering&quot;}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key=&quot;Hardware acceleration&quot;}"
                        OnContent="{loc:Translate Key=&quot;Hardware acceleration&quot;}"
                        IsChecked="{Binding HardwareAcceleration}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key=&quot;UI virtualization&quot;}"
                        OnContent="{loc:Translate Key=&quot;UI virtualization&quot;}"
                        IsChecked="{Binding Virtualization}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key=&quot;Cache package lists&quot;}"
                        OnContent="{loc:Translate Key=&quot;Cache package lists&quot;}"
                        IsChecked="{Binding CachePackages}"/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Downloads&quot;}"/>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{loc:Translate Key=&quot;Parallel downloads&quot;}"/>
                        <Slider Grid.Column="1"
                                Margin="15,0"
                                Minimum="{Binding MinParallelDownloads}"
                                Maximum="{Binding MaxParallelDownloads}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding ParallelDownloads}"/>
                        <TextBlock Grid.Column="2" Text="{loc:TranslateBinding Path=ParallelDownloads}"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{loc:Translate Key=&quot;Cache size (MB)&quot;}"/>
                        <Slider Grid.Column="1"
                                Margin="15,0"
                                Minimum="{Binding MinCacheSize}"
                                Maximum="{Binding MaxCacheSize}"
                                TickFrequency="64"
                                IsSnapToTickEnabled="True"
                                Value="{Binding CacheSize}"/>
                        <TextBlock Grid.Column="2" Text="{loc:TranslateBinding Path=CacheSize}"/>
                    </Grid>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Window&quot;}"/>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{loc:Translate Key=&quot;Window opacity&quot;}"/>
                        <Slider Grid.Column="1"
                                Margin="15,0"
                                Minimum="{Binding MinWindowOpacity}"
                                Maximum="{Binding MaxWindowOpacity}"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding WindowOpacity}"/>
                        <TextBlock Grid.Column="2" Text="{loc:TranslateBinding Path=WindowOpacity}"/>
                    </Grid>

                </StackPanel>

            </shared:AppCard>

        </StackPanel>

    </ScrollViewer>

    </Grid>

</UserControl>
