<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    x:Class="WinGetXAvalonia.Views.HistoryView"
    x:Name="Root"
    x:DataType="vm:HistoryViewModel">

    <UserControl.KeyBindings>
        <KeyBinding
            Gesture="F5"
            Command="{Binding RefreshCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>

        <Style Selector="ToggleButton.FilterChip">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.FilterChip:pointerover:not(:checked)">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.FilterChip:checked">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

    </UserControl.Styles>

    <Grid
        Margin="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <shared:SectionHeader
            Grid.Row="0"
            Title="History"
            Description="{Binding OperationsSummary}"/>

        <!-- Toolbar -->
        <Grid
            Grid.Row="1"
            RowDefinitions="Auto,Auto">

            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16"
                CornerRadius="{DynamicResource RadiusMedium}"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">

                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">

                    <shared:SearchBox
                        MinWidth="0"
                        MaxWidth="1200"
                        HorizontalAlignment="Stretch"
                        Watermark="Search history..."
                        Text="{Binding SearchText}"/>

                    <shared:AppButton
                        Grid.Column="1"
                        Width="42"
                        Padding="0"
                        Content="🔄"
                        ToolTip.Tip="Refresh history (F5)"
                        Command="{Binding RefreshCommand}"/>

                    <shared:AppButton
                        Grid.Column="2"
                        MinWidth="110"
                        Content="Export"
                        Command="{Binding ExportCommand}"/>

                    <shared:AppButton
                        Grid.Column="3"
                        Classes="Danger"
                        MinWidth="110"
                        Content="Clear"
                        Command="{Binding ClearCommand}"/>

                </Grid>

            </Border>

            <ItemsControl
                Grid.Row="1"
                ItemsSource="{Binding Filters}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton
                            Classes="FilterChip"
                            Margin="0,0,8,8"
                            IsChecked="{Binding IsActive, Mode=OneWay}"
                            Command="{Binding $parent[ItemsControl].DataContext.SelectFilterCommand}"
                            CommandParameter="{Binding}">

                            <TextBlock Text="{Binding Label}"/>

                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </Grid>

        <!-- Master-Detail -->
        <shared:MasterDetailPage
            Grid.Row="3"
            IsLoading="{Binding IsLoading}"
            LoadingMessage="Loading history..."
            DetailWidth="0.8*">

            <shared:MasterDetailPage.MasterContent>

                <Grid>

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        ScrollViewer.IsDeferredScrollingEnabled="True">

                        <StackPanel Spacing="20">

                            <ListBox
                                ItemsSource="{Binding Groups}"
                                BorderThickness="0"
                                Background="Transparent">

                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel CacheLength="0.5"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <StackPanel Spacing="8">

                                            <TextBlock
                                                Margin="5,0,0,0"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"/>

                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:HistoryCard/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- Empty state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding IsEmpty}"
                        Icon="📜"
                        Title="No history available"
                        Description="Operations you run will appear here.">

                        <shared:AppEmptyState.Examples>
                            <sys:String>Installs, updates and removals in one place</sys:String>
                            <sys:String>Roll back to any snapshot in two clicks</sys:String>
                            <sys:String>Compare what changed between two points</sys:String>
                        </shared:AppEmptyState.Examples>

                    </shared:AppEmptyState>

                    <!-- Error state -->
                    <shared:AppEmptyState
                        IsVisible="{Binding HasError}"
                        Icon="⚠️"
                        Title="Couldn't load history"
                        Description="{Binding ErrorMessage}"
                        ActionText="Retry"
                        ActionCommand="{Binding RefreshCommand}"/>

                </Grid>

            </shared:MasterDetailPage.MasterContent>

            <shared:MasterDetailPage.DetailContent>

                <Border
                    Padding="18"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">

                    <StackPanel Spacing="14">

                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="Statistics"/>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="10">

                            <TextBlock Grid.Row="0" Text="Total"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Text="{Binding TotalOperations}"/>

                            <TextBlock Grid.Row="1" Text="Successful"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Text="{Binding SuccessfulOperations}"/>

                            <TextBlock Grid.Row="2" Text="Failed"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Text="{Binding FailedOperations}"/>

                            <TextBlock Grid.Row="3" Text="Today"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Text="{Binding TodayOperations}"/>

                        </Grid>

                    </StackPanel>

                </Border>

            </shared:MasterDetailPage.DetailContent>

        </shared:MasterDetailPage>

    </Grid>

</UserControl>
