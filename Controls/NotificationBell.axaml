<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:models="using:WinGetXAvalonia.Services.Notifications"
    xmlns:svg="using:Avalonia.Svg"
    x:Class="WinGetXAvalonia.Controls.NotificationBell"
    x:Name="Root"
    x:DataType="vm:NotificationCenterViewModel">

    <Grid>

        <ToggleButton
            x:Name="BellButton"
            Width="38"
            Height="38"
            Padding="0"
            CornerRadius="10"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">

            <ToggleButton.Transitions>
                <Transitions>
                    <BrushTransition
                        Property="Background"
                        Duration="0:0:0.15"/>
                    <BrushTransition
                        Property="BorderBrush"
                        Duration="0:0:0.15"/>
                    <TransformOperationsTransition
                        Property="RenderTransform"
                        Duration="0:0:0.15"/>
                </Transitions>
            </ToggleButton.Transitions>

            <Grid>

                <svg:Svg
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.75"
                    CurrentColor="{DynamicResource TextColor}"
                    Path="/Assets/Icons/Fluent/info.svg"/>

                <Border
                    Width="9"
                    Height="9"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    CornerRadius="5"
                    Background="{DynamicResource AccentBrush}"
                    IsVisible="{Binding HasUnread}"/>

            </Grid>

        </ToggleButton>

        <Popup
            IsOpen="{Binding #BellButton.IsChecked, Mode=TwoWay}"
            IsLightDismissEnabled="True"
            Placement="BottomEdgeAlignedRight"
            PlacementTarget="{Binding #Root}"
            WindowManagerAddShadowHint="True">

            <shared:AppCard
                Width="360"
                MaxHeight="440">

                <Grid RowDefinitions="Auto,Auto,*">

                    <Grid ColumnDefinitions="*,Auto">

                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Notifications"/>

                        <shared:AppButton
                            Grid.Column="1"
                            Classes="Danger"
                            Content="Clear"
                            Command="{Binding ClearCommand}"/>

                    </Grid>

                    <Border
                        Grid.Row="1"
                        Height="1"
                        Margin="0,10"
                        Background="{DynamicResource BorderBrush}"/>

                    <ScrollViewer
                        Grid.Row="2"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <TextBlock
                                IsVisible="{Binding IsEmpty}"
                                Opacity="0.5"
                                Text="No notifications yet."/>

                            <ItemsControl ItemsSource="{Binding Items}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:NotificationModel">

                                        <Grid
                                            ColumnDefinitions="26,*"
                                            Margin="0,6">

                                            <TextBlock
                                                FontSize="15"
                                                VerticalAlignment="Top"
                                                Text="{Binding Type, Converter={StaticResource NotificationTypeToIcon}}"/>

                                            <StackPanel Grid.Column="1" Spacing="2">

                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Title}"/>

                                                <TextBlock
                                                    Opacity="0.6"
                                                    FontSize="12"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding Message}"/>

                                                <TextBlock
                                                    Opacity="0.45"
                                                    FontSize="11"
                                                    Text="{Binding Timestamp, StringFormat='HH:mm'}"/>

                                            </StackPanel>

                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </shared:AppCard>

        </Popup>

    </Grid>

</UserControl>
