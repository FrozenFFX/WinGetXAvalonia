<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:models="using:WinGetXAvalonia.Models"
    x:Class="WinGetXAvalonia.Controls.PackageRow"
    x:DataType="models:PackageModel">

    <Border
        CornerRadius="{DynamicResource RadiusMedium}"
        Margin="4"
        Padding="12"
        Background="{DynamicResource CardBackgroundBrush}">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Path
                Width="28"
                Height="28"
                VerticalAlignment="Center"
                Data="{Binding Icon, Converter={StaticResource IconGeometry}}"
                Fill="{DynamicResource AccentBrush}"
                Stretch="Uniform"/>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{loc:TranslateBinding Path=Name}"/>

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{loc:TranslateBinding Path=Version}"/>

            <shared:AppButton
                Grid.Column="3"
                Content="{loc:Translate Key=&quot;Remove&quot;}"/>

        </Grid>

    </Border>

</UserControl>
