<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Class="WinGetXAvalonia.Controls.Shared.SearchBar"
    x:Name="Root">

    <Border
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="10"
        Padding="12,0"
        Height="42">

        <Grid ColumnDefinitions="Auto,*,Auto">

            <Path
                Width="16"
                Height="16"
                Data="{StaticResource IconSearch}"
                Fill="{DynamicResource SubtextBrush}"
                Opacity="0.5"
                Stretch="Uniform"
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                Margin="8,0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                PlaceholderText="{Binding Watermark, ElementName=Root}"
                Text="{Binding Text, ElementName=Root, Mode=TwoWay}"/>

            <shared:AppButton
                Grid.Column="2"
                Width="24"
                Height="24"
                Padding="0"
                Background="Transparent"
                Foreground="{DynamicResource SubtextBrush}"
                VerticalAlignment="Center"
                IsVisible="{Binding Text, ElementName=Root,
                Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                Click="OnClearClick">

                <Path
                    Width="12"
                    Height="12"
                    Data="{StaticResource IconClose}"
                    Fill="{DynamicResource SubtextBrush}"
                    Stretch="Uniform"/>
            </shared:AppButton>

        </Grid>

    </Border>

</UserControl>
