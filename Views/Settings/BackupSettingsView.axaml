<UserControl xmlns:loc="using:WinGetXAvalonia.Controls.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.BackupSettingsView"
             x:DataType="vm:BackupSettingsViewModel">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="{loc:Translate Key=&quot;Backup&quot;}"/>

            <shared:AppCard>

                <StackPanel Spacing="20">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Automation&quot;}"/>

                    <ToggleSwitch
                        OffContent="{loc:Translate Key=&quot;Auto backup settings&quot;}"
                        OnContent="{loc:Translate Key=&quot;Auto backup settings&quot;}"
                        IsChecked="{Binding AutoBackup}"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="{loc:Translate Key=&quot;Settings are stored locally in settings.json. Export a copy before reinstalling Windows.&quot;}"/>

                </StackPanel>

            </shared:AppCard>

            <shared:AppCard>

                <StackPanel Spacing="16">

                    <TextBlock
                        FontSize="{DynamicResource FontSection}"
                        FontWeight="Bold"
                        Text="{loc:Translate Key=&quot;Manual&quot;}"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <shared:AppButton
                            Content="{loc:Translate Key=&quot;Export Settings&quot;}"
                            Command="{Binding ExportSettingsCommand}"/>
                        <shared:AppButton
                            Content="{loc:Translate Key=&quot;Import Settings&quot;}"
                            Command="{Binding ImportSettingsCommand}"/>
                        <shared:AppButton
                            Content="{loc:Translate Key=&quot;Reset Settings&quot;}"
                            Command="{Binding ResetSettingsCommand}"/>

                    </StackPanel>

                    <TextBlock
                        Opacity="0.7"
                        Text="{loc:TranslateBinding Path=StatusMessage}"/>

                </StackPanel>

            </shared:AppCard>

        </StackPanel>

    </ScrollViewer>

    </Grid>

</UserControl>
