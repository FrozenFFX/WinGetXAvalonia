<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background -->
    <SolidColorBrush x:Key="Background" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8"/>
    <LinearGradientBrush x:Key="BackgroundAmbientBrush"
                         StartPoint="0%,0%"
                         EndPoint="100%,100%">
        <GradientStop Color="#EDF7EF" Offset="0"/>
        <GradientStop Color="#F5F6F8" Offset="0.58"/>
        <GradientStop Color="#EFF2F6" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ScrimBrush" Color="#8A000000"/>

    <!-- Surface -->
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F1F3"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#ECEEF1"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#ECEEF1"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF"/>

    <!-- Cards -->
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FFFFFF"/>

    <!-- Hover -->
    <SolidColorBrush x:Key="Hover" Color="#F0F1F3"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F0F1F3"/>

    <!-- Border -->
    <SolidColorBrush x:Key="Border" Color="#DDE0E5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DDE0E5"/>

    <!-- Button -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E8EAED"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#D4D7DC"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#B0B5BC"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#D4D7DC"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#C4C8CF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#111827"/>
    <Color x:Key="TextColor">#111827</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="SubtextBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9CA3AF"/>

</ResourceDictionary>
