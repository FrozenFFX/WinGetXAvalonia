<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinGetXAvalonia.ViewModels.Settings"
             x:Class="WinGetXAvalonia.Views.Settings.AboutSettingsView"
             x:DataType="vm:AboutSettingsViewModel">

    <ScrollViewer>

        <StackPanel Spacing="22">

            <TextBlock
                Classes="title"
                Text="About"/>

            <Border Classes="card">

                <StackPanel Spacing="16">

                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Text="{Binding AppName}"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="{Binding Version, StringFormat='Version {0}'}"/>

                    <TextBlock
                        Opacity="0.7"
                        Text="A modern package manager front-end built on winget and Avalonia UI."/>

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <Button
                            Content="GitHub"
                            Command="{Binding OpenGitHubCommand}"/>
                        <Button Content="Check for Updates"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <Border Classes="card">

                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="System"/>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="Commit"/>
                        <TextBlock Grid.Column="1"
                                   FontFamily="Consolas"
                                   Text="{Binding Commit}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text=".NET"/>
                        <TextBlock Grid.Column="1" Text="{Binding DotNet}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="Avalonia"/>
                        <TextBlock Grid.Column="1" Text="{Binding Avalonia}"/>
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Opacity="0.7" Text="Winget"/>
                        <TextBlock Grid.Column="1" Text="{Binding WingetVersion}"/>
                    </Grid>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
