<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinGetXAvalonia.ViewModels"
    xmlns:controls="using:WinGetXAvalonia.Controls"
    xmlns:shared="using:WinGetXAvalonia.Controls.Shared"
    xmlns:package="using:WinGetXAvalonia.Controls.Package"
    x:Class="WinGetXAvalonia.Views.InstalledView"
    x:Name="Root"
    x:DataType="vm:InstalledViewModel">
    <!-- WinGetX - https://github.com/FrozenFFX -->

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:SectionHeader
            Title="Installed Packages"
            Description="Manage all installed applications."
            ActionText="Refresh"
            ActionCommand="{Binding RefreshCommand}"/>

        <package:PackageToolbar
            Grid.Row="1"
            SearchText="{Binding SearchText}"
            PackageCount="{Binding PackageCount}"
            RefreshCommand="{Binding RefreshCommand}"
            SelectedSort="{Binding SelectedSort}"
            SelectedFilter="{Binding SelectedFilter}"/>

        <!-- Bulk actions -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,0"
            Padding="12,8"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMedium}"
            IsVisible="{Binding SelectedCount,
            Converter={StaticResource PositiveToBoolConverter}}">

            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
                </Transitions>
            </Border.Transitions>

            <Border.Styles>
                <Style Selector="Border">
                    <Setter Property="Height" Value="0"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="RenderTransform" Value="translateY(12px)"/>
                    <Style Selector="Border[IsVisible=True]">
                        <Setter Property="Height" Value="60"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="RenderTransform" Value="translateY(0px)"/>
                    </Style>
                </Style>
            </Border.Styles>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                <TextBlock
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Text="{Binding SelectedCount,
                    StringFormat={}{0} selected}"/>

                <Button
                    Grid.Column="2"
                    Content="Update Selected"
                    Command="{Binding UpdateSelectedCommand}"/>

                <Button
                    Grid.Column="3"
                    Classes="Danger"
                    Content="Remove Selected"
                    Command="{Binding RemoveSelectedCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">

            <ListBox
                ItemsSource="{Binding Packages}"
                SelectionMode="Multiple"
                SelectionChanged="OnSelectionChanged">

                <ListBox.KeyBindings>
                    <KeyBinding
                        Gesture="Delete"
                        Command="{Binding #Root.DataContext.RemoveSelectedCommand}"/>
                </ListBox.KeyBindings>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:PackageCard/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                IsVisible="{Binding Packages.Count,
                Converter={StaticResource ZeroToBoolConverter}}">

                <TextBlock
                    Text="📦"
                    FontSize="48"
                    Opacity="0.4"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="No installed packages"
                    FontSize="{DynamicResource FontTitle}"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Install applications from Browse."
                    Opacity="0.6"
                    HorizontalAlignment="Center"/>

                <Button
                    Margin="0,8,0,0"
                    Content="Browse Packages"
                    Command="{Binding BrowseCommand}"
                    HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>


    <!-- kaneki -->
    </Grid>

</UserControl>
